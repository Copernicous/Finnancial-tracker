  if (data.detailType === 'holdings') {
    const headers = ['Symbol', 'Name', 'Account', 'Asset Class', 'Quantity', 'Cost Basis', 'Market Value', 'Unrealized Gain', 'Currency', 'Price Date'];
    return [headers].concat(rows.map(row => [
      row.symbol, row.name, row.accountName, row.assetClass, row.quantity, row.costBasis, row.marketValue, row.unrealizedGain, row.currency, row.priceDate
    ]));
  }
  const headers = ['Budget', 'Year', 'Month', 'Category', 'Category Group', 'Planned', 'Actual', 'Variance', 'Usage %', 'Currency'];
  return [headers].concat(rows.map(row => [
    row.name, row.year, row.month || '', row.categoryName || 'All expenses', row.categoryGroup || '', row.plannedAmount, row.actualAmount, row.variance, row.usagePct, row.currency
  ]));
}

function exportKpiDetailCsv() {
  if (!kpiDetailData) return toast('Open a KPI card first.', 'warning');
  const lines = kpiDetailCsvLines(kpiDetailData);
  const csv = lines.map(row => row.map(csvCell).join(',')).join('\n');
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }));
  const year = (document.getElementById('yearFilter').value || defaultYear) === 'all' ? 'all_years' : (document.getElementById('yearFilter').value || defaultYear);
  a.download = 'home_accounting_kpi_detail_' + String(kpiDetailData.metric || 'report').replace(/[^a-z0-9_-]/gi, '_') + '_' + year + '.csv';
  a.click();
  URL.revokeObjectURL(a.href);
}

async function openKpiDetail(metric, options) {
  if (!overview) return;
  const opts = options || {};
  activeKpiMetric = metric;
  renderKpis(overview.summary || {});
  const panel = document.getElementById('kpiDetailPanel');
  panel.classList.remove('d-none');
  document.getElementById('kpiDetailTitle').textContent = 'Loading KPI detail...';
  document.getElementById('kpiDetailFormula').textContent = 'Gathering rows from the same filters as the cards.';
  document.getElementById('kpiDetailSummary').innerHTML = '';
  document.getElementById('kpiDetailHead').innerHTML = '';
  document.getElementById('kpiDetailRows').innerHTML = '<tr><td class="text-muted">Loading...</td></tr>';
  if (opts.scroll !== false) panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
  const response = await fetch('/api/finance/kpi-detail?' + qs(kpiDetailParams(metric)), { headers: authHeaders() });
  const data = await response.json().catch(() => ({}));
  if (!response.ok) {
    document.getElementById('kpiDetailRows').innerHTML = '<tr><td class="text-danger">' + esc(data.error || 'Unable to load KPI detail.') + '</td></tr>';
    return;
  }
  renderKpiDetail(data);
}

async function loadAll() {
  try {
    await loadOverview();
    await loadSearch();
    const panel = document.getElementById('kpiDetailPanel');
    if (activeKpiMetric && panel && !panel.classList.contains('d-none')) {
      await openKpiDetail(activeKpiMetric, { scroll: false });
    }
  } catch (err) {
    toast('Unable to load financial workspace.', 'danger');
  }
}

async function seedSimulation() {
  const res = await fetch('/api/simulation/seed', { method: 'POST', headers: authHeaders(true) });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) return toast(data.message || data.error || 'Unable to load sample data.', 'danger');
  toast('Sample data loaded: ' + data.created + ' transactions.');
  await loadLookups();
  await loadAll();
}

async function clearSimulation() {
  if (!confirm('Clear all sample simulation accounting data?')) return;
  const res = await fetch('/api/simulation', { method: 'DELETE', headers: authHeaders() });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) return toast(data.message || data.error || 'Unable to clear sample data.', 'danger');
  toast('Sample data cleared.');
  await loadLookups();
  await loadAll();
}

async function exportCsv() {
  const f = filters();
  const params = {
    q: document.getElementById('searchFilter').value.trim(),
    year: f.year,
    month: f.month,
    accountId: f.accountId,
    currency: f.currency,
    type: document.getElementById('typeFilter').value,
    status: document.getElementById('statusFilter').value,
    categoryId: document.getElementById('merchantCategorySelect').value || selectedCategoryId,
    merchantKey: document.getElementById('merchantSummarySelect').value || selectedMerchantId,
    from: document.getElementById('fromFilter').value,
    to: document.getElementById('toFilter').value,
    exportAll: 'true',
    limit: 20000
  };
  const response = await fetch('/api/finance/search?' + qs(params), { headers: authHeaders() });
  const data = await response.json().catch(() => ({}));
  if (!response.ok) return toast('Export failed.', 'danger');
  const exportRows = data.rows || [];
  const headers = ['Date', 'Account', 'Category', 'Merchant', 'Official Merchant', 'Merchant Group', 'Receipt Merchant', 'Raw Merchant', 'Normalized Merchant', 'Description', 'Type', 'Amount', 'Currency', 'Status', 'Source', 'Reference', 'Tags', 'Memo'];
  const lines = [headers].concat(exportRows.map(row => [
    row.transactionDate, row.accountName, row.categoryName || 'Uncategorized', merchantLabel(row), row.merchantOfficialName || row.merchant || '', row.merchantGroupName || '',
    row.receiptMerchant || '', row.rawMerchant || '', row.normalizedMerchant || '', row.description,
    row.transactionType, row.amount, row.currency, row.status, row.sourceType || '', row.referenceNumber || '', row.tags || '', row.memo || ''
  ]));
  const csv = lines.map(row => row.map(cell => typeof sanitizeCsvCell === 'function' ? sanitizeCsvCell(cell) : '"' + String(cell == null ? '' : cell).replace(/"/g, '""') + '"').join(',')).join('\n');
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }));
  a.download = 'home_accounting_financial_workspace_' + ((document.getElementById('yearFilter').value || defaultYear) === 'all' ? 'all_years' : (document.getElementById('yearFilter').value || defaultYear)) + '.csv';
  a.click();
  URL.revokeObjectURL(a.href);
}

document.querySelectorAll('th[data-sort]').forEach(th => {
  th.addEventListener('click', () => {
    const key = th.getAttribute('data-sort');
    sortState = { key, dir: sortState.key === key && sortState.dir === 'desc' ? 'asc' : 'desc' };
    renderLedger();
  });
});
document.getElementById('runBtn').addEventListener('click', loadAll);
document.getElementById('statementCompareToggle').addEventListener('change', renderStatementComparison);
document.getElementById('resetBtn').addEventListener('click', () => {
  document.getElementById('yearFilter').value = defaultYear;
  syncYearMode();
  document.getElementById('monthFilter').value = '';
  document.getElementById('accountFilter').value = '';
  document.getElementById('accountClassFilter').value = '';
  document.getElementById('currencyFilter').value = 'USD';
  document.getElementById('searchFilter').value = '';
  document.getElementById('typeFilter').value = '';
  document.getElementById('statusFilter').value = '';
  document.getElementById('fromFilter').value = '';
  document.getElementById('toFilter').value = '';
  document.getElementById('merchantCategorySelect').value = '';
  document.getElementById('merchantSummarySelect').value = '';
  document.getElementById('merchantFromDate').value = '';
  document.getElementById('merchantToDate').value = '';
  document.getElementById('merchantRangeMode').value = 'page';
  document.getElementById('merchantTrendGrain').value = 'month';
  document.getElementById('merchantTrendType').value = 'bar';
  selectedCategoryId = '';
  selectedMerchantId = '';
  syncMerchantRangeVisibility();
  loadAll();
});
['yearFilter', 'monthFilter', 'accountFilter', 'accountClassFilter', 'currencyFilter', 'typeFilter', 'statusFilter', 'fromFilter', 'toFilter'].forEach(id => {
  document.getElementById(id).addEventListener('change', () => {
    if (id === 'yearFilter') syncYearMode();
    loadAll();
  });
});
['trendGroup', 'trendGrain', 'trendMeasure', 'trendChartType'].forEach(id => {
  document.getElementById(id).addEventListener('change', () => renderMonthly());
});
document.getElementById('merchantRangeMode').addEventListener('change', () => {
  syncMerchantRangeVisibility();
  if (document.getElementById('merchantRangeMode').value === 'custom' && !document.getElementById('merchantFromDate').value && !document.getElementById('merchantToDate').value) return;
  renderMerchantSummary();
});
['merchantTrendGrain', 'merchantTrendType'].forEach(id => {
  document.getElementById(id).addEventListener('change', () => {
    renderMerchantSummary();
  });
});
['merchantFromDate', 'merchantToDate'].forEach(id => {
  document.getElementById(id).addEventListener('focus', () => {
    if (document.getElementById('merchantRangeMode').value !== 'custom') {
      document.getElementById('merchantRangeMode').value = 'custom';
      document.getElementById('merchantFromDate').value = '';
      document.getElementById('merchantToDate').value = '';
      syncMerchantRangeVisibility();
    }
  });
  document.getElementById(id).addEventListener('change', () => {
    document.getElementById('merchantRangeMode').value = 'custom';
    syncMerchantRangeVisibility();
    renderMerchantSummary();
  });
  document.getElementById(id).addEventListener('keydown', event => {
    if (event.key === 'Enter') {
      event.preventDefault();
      document.getElementById('merchantRangeMode').value = 'custom';
      syncMerchantDateBounds(id);
      applyMerchantCustomRange();
    }
  });
});
document.getElementById('merchantDateApplyBtn').addEventListener('click', () => {
  applyMerchantCustomRange();
});
document.getElementById('merchantCategorySelect').addEventListener('change', () => {
  selectedCategoryId = document.getElementById('merchantCategorySelect').value || '';
  selectedMerchantId = '';
  document.getElementById('merchantSummarySelect').value = '';
  renderMerchantSummary();
});
document.getElementById('merchantSummarySelect').addEventListener('change', () => {
  selectedMerchantId = document.getElementById('merchantSummarySelect').value || '';
  renderMerchantSummary();
});
document.getElementById('merchantHeaderResetBtn').addEventListener('click', () => {
  selectedCategoryId = '';
  selectedMerchantId = '';
  preferTopMerchantOnNextLoad = true;
  document.getElementById('merchantFromDate').value = '';
  document.getElementById('merchantToDate').value = '';
  document.getElementById('merchantCategorySelect').value = '';
  document.getElementById('merchantSummarySelect').value = '';
  document.getElementById('trendGroup').value = 'category';
  document.getElementById('trendMeasure').value = 'expense';
  document.getElementById('merchantRangeMode').value = 'page';
  document.getElementById('merchantTrendGrain').value = 'month';
  document.getElementById('merchantTrendType').value = 'bar';
  syncMerchantRangeVisibility();
  renderMerchantSummary();
});
document.getElementById('trendRefreshBtn').addEventListener('click', () => renderMonthly());
document.getElementById('searchFilter').addEventListener('keydown', event => {
  if (event.key === 'Enter') loadAll();
});
document.getElementById('seedBtn').addEventListener('click', seedSimulation);
document.getElementById('clearBtn').addEventListener('click', clearSimulation);
document.getElementById('exportBtn').addEventListener('click', exportCsv);
document.getElementById('kpiGrid').addEventListener('click', event => {
  const card = event.target.closest('[data-kpi]');
  if (!card) return;
  openKpiDetail(card.dataset.kpi);
});
document.getElementById('kpiDetailCloseBtn').addEventListener('click', () => {
  activeKpiMetric = '';
  kpiDetailData = null;
  document.getElementById('kpiDetailPanel').classList.add('d-none');
  renderKpis(overview.summary || {});
});
document.getElementById('kpiDetailExportBtn').addEventListener('click', exportKpiDetailCsv);
document.getElementById('categorySpendChart').addEventListener('click', event => {
  if (!categorySpendChart) return;
  const points = categorySpendChart.getElementsAtEventForMode(event, 'nearest', { intersect: true }, true);
  if (!points.length) return;
  const index = points[0].index;
  const row = categoryChartRows[index];
  if (!row) return;
  selectedCategoryId = row.categoryId || '';
  selectedMerchantId = '';
  document.getElementById('merchantCategorySelect').value = selectedCategoryId;
  document.getElementById('merchantSummarySelect').value = '';
  document.getElementById('searchFilter').value = '';
  document.getElementById('trendGroup').value = 'category';
  document.getElementById('trendMeasure').value = 'expense';
  renderMerchantSummary();
});
document.getElementById('merchantRankList').addEventListener('click', event => {
  const btn = event.target.closest('.merchant-jump');
  if (!btn) return;
  selectedMerchantId = btn.dataset.merchant || '';
  selectedCategoryId = '';
  document.getElementById('trendGroup').value = 'merchant';
  document.getElementById('trendMeasure').value = 'expense';
  document.getElementById('merchantCategorySelect').value = '';
  document.getElementById('merchantSummarySelect').value = selectedMerchantId;
  if (!selectedMerchantId && btn.dataset.name) document.getElementById('searchFilter').value = btn.dataset.name;
  renderMerchantSummary();
});
document.addEventListener('DOMContentLoaded', async function() {
  syncMerchantRangeVisibility();
  await loadLookups();
  await loadAll();
});
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Financial Workspace - Home Accounting</title>
  <link href="/assets/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/inter.css" rel="stylesheet">
  <link rel="stylesheet" href="/assets/fontawesome.all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .finance-shell { --control-height: 42px; }
    .finance-shell { display: grid; gap: 1rem; }
    .finance-shell .form-select,
    .finance-shell .form-control,
    .finance-shell .btn {
      min-height: var(--control-height);
    }
    .finance-shell .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .filter-grid { display: grid; grid-template-columns: 72px 88px minmax(150px, 1fr) 120px 96px minmax(160px, 1fr) auto; gap: .6rem; align-items: end; }
    .console-toolbar { display: grid; grid-template-columns: minmax(240px, auto) minmax(0, 1fr); gap: .85rem; align-items: end; }
    .console-toolbar-left { min-width: 0; display: block; white-space: normal; }
    .console-toolbar-right { min-width: 0; }
    .console-toolbar-right .filter-grid { grid-template-columns: 72px 88px minmax(150px, 1fr) 120px 96px minmax(170px, 1fr) auto; }
    .console-actions { display: flex; gap: .5rem; align-items: end; }
    .kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .85rem; }
    .kpi-card { border: 1px solid var(--border,#e5e7eb); border-radius: 8px; background: var(--surface,#fff); padding: 1rem; min-height: 116px; }
    .kpi-card-action { width: 100%; color: inherit; text-align: left; cursor: pointer; transition: border-color .18s ease, transform .18s ease, background .18s ease; }
    .kpi-card-action:hover, .kpi-card-action.is-active { border-color: rgba(13,110,253,.5); background: rgba(13,110,253,.08); transform: translateY(-1px); }
    .kpi-card .kpi-icon { width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; background: var(--surface-2,#f1f5f9); color: var(--primary,#0d6efd); }
    .kpi-value { font-size: clamp(1.25rem, 2vw, 1.85rem); font-weight: 800; letter-spacing: 0; line-height: 1.15; }
    .finance-panel { border: 1px solid var(--border,#e5e7eb); border-radius: 8px; background: var(--surface,#fff); padding: 1rem; }
    .statement-toggle { min-height: var(--control-height); border: 1px solid var(--border,#e5e7eb); border-radius: 8px; padding: .45rem .65rem; display: inline-flex; align-items: center; gap: .42rem; white-space: nowrap; background: var(--surface-2,#f1f5f9); font-size: .82rem; font-weight: 700; }
    .statement-compare-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .65rem; align-items: stretch; }
    .statement-compare-item { border: 1px solid rgba(148,163,184,.18); border-radius: 10px; background: rgba(15,23,42,.22); padding: .65rem .75rem; min-width: 0; }
    .statement-compare-value { font-size: 1.05rem; font-weight: 800; line-height: 1.15; }
    .statement-snapshot-list { display: flex; flex-wrap: wrap; gap: .4rem; }
    .statement-snapshot-chip { border: 1px solid rgba(148,163,184,.2); border-radius: 999px; padding: .25rem .55rem; font-size: .76rem; background: rgba(148,163,184,.08); }
    .kpi-detail-summary { display: flex; flex-wrap: wrap; gap: .5rem; }
    .kpi-detail-chip { border: 1px solid rgba(148,163,184,.18); border-radius: 10px; background: rgba(15,23,42,.24); padding: .45rem .65rem; min-width: 138px; }
    .kpi-detail-table-wrap { max-height: 520px; overflow: auto; }
    .kpi-detail-table { font-size: .82rem; }
    .kpi-detail-table th { position: sticky; top: 0; z-index: 1; background: var(--surface-2,#f1f5f9); white-space: nowrap; }
    .source-file-cell { min-width: 180px; max-width: 260px; }
    .bar-track { height: 10px; border-radius: 999px; background: var(--surface-2,#eef2f7); overflow: hidden; }
    .bar-fill { height: 100%; border-radius: 999px; }
    .bar-income { background: #198754; }
    .bar-expense { background: #dc3545; }
    .bar-net { background: #0d6efd; }
    .bar-warning { background: #f59e0b; }
    .bar-row { display: grid; grid-template-columns: 72px minmax(160px, 1fr) 96px; gap: .65rem; align-items: center; margin-bottom: .65rem; }
    .stack-row { display: grid; grid-template-columns: minmax(140px, 1fr) 110px 82px; gap: .65rem; align-items: center; padding: .55rem 0; border-bottom: 1px solid var(--border,#e5e7eb); }
    .stack-row:last-child { border-bottom: 0; }
    .compact-table th { cursor: pointer; user-select: none; }
    .ledger-wrap { max-height: 460px; overflow: auto; max-width: 100%; }
    .finance-chart-frame { position: relative; height: 320px; min-height: 320px; }
    .finance-chart-frame.compact { height: 260px; min-height: 260px; }
    .category-chart-frame { height: 360px; min-height: 360px; }
    .split-layout > .finance-panel:last-child .finance-chart-frame.compact { height: 100%; min-height: 0; flex: 1 1 auto; }
    .rank-list { display: grid; gap: .55rem; }
    .rank-row { display: grid; grid-template-columns: minmax(130px, 1fr) 96px 72px; gap: .65rem; align-items: center; padding: .45rem 0; border-bottom: 1px solid var(--border,#e5e7eb); }
    .rank-row:last-child { border-bottom: 0; }
    .chart-toggle-group { display: inline-flex; gap: .35rem; flex-wrap: wrap; align-items: center; }
    .chart-toggle-group .form-check { margin: 0; min-height: auto; }
    .chart-toggle-group .form-check-label { font-size: .76rem; color: var(--text-muted,#64748b); }
    .status-dot { width: 8px; height: 8px; border-radius: 999px; display: inline-block; margin-right: .35rem; background: #94a3b8; }
    .status-dot.reviewed, .status-dot.reconciled { background: #198754; }
    .status-dot.draft { background: #f59e0b; }
    .status-dot.void { background: #dc3545; }
    .split-layout { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, .9fr); gap: 1rem; align-items: stretch; }
    .split-layout > .finance-panel { height: 100%; }
    .split-layout > .finance-panel:last-child { display: flex; flex-direction: column; }
    .merchant-toolbar { display: flex; align-items: center; justify-content: space-between; gap: .75rem; flex-wrap: wrap; }
    .merchant-toolbar-left { min-width: 0; }
    .merchant-toolbar-right { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
    .merchant-toolbar-right .form-select,
    .merchant-toolbar-right .form-control { width: 160px; }
    .merchant-stat-chip { border: 1px solid rgba(148,163,184,.16); border-radius: 10px; padding: .38rem .65rem; background: rgba(15,23,42,.35); min-width: 120px; min-height: var(--control-height); display: flex; flex-direction: column; justify-content: center; }
    .merchant-stat-chip .small-muted { line-height: 1; margin-bottom: .18rem; }
    .merchant-stat-chip .fw-semibold { line-height: 1.05; }
    .merchant-range-group { display: flex; align-items: end; gap: .5rem; }
    .merchant-range-group.is-inactive { opacity: .6; }
    .merchant-date-field { min-width: 160px; }
    .merchant-date-field label { display: none; }
    .merchant-apply-btn { min-width: 92px; }
    .merchant-chart-stack { display: grid; gap: .75rem; min-width: 0; }
    .merchant-content-layout { align-items: stretch; min-height: 300px; }
    .merchant-content-layout .finance-chart-frame.compact { height: 260px; min-height: 260px; flex: 0 0 auto; }
    .merchant-content-layout .rank-list { height: 535px; min-height: 535px; overflow-y: auto; align-content: start; padding-right: .25rem; }
    .merchant-empty-state { min-height: 300px; display: flex; align-items: center; justify-content: center; text-align: center; }
    .merchant-rank-btn {
      width: 100%;
      border: 1px solid transparent;
      border-radius: 10px;
      background: transparent;
      color: inherit;
      text-decoration: none;
      transition: background-color .18s ease, border-color .18s ease;
    }
    .merchant-rank-btn:hover {
      background: rgba(148,163,184,.08);
      border-color: rgba(148,163,184,.22);
      text-decoration: none;
    }
    .merchant-rank-btn.active {
      background: rgba(13,110,253,.10);
      border-color: rgba(13,110,253,.28);
    }
    .merchant-rank-main {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: .15rem;
    }
    .merchant-summary-strip { display: grid; grid-template-columns: repeat(2, minmax(170px, 220px)); gap: .5rem; align-items: stretch; justify-content: start; }
    .merchant-summary-item { border: 1px solid rgba(148,163,184,.16); border-radius: 10px; padding: .5rem .65rem; background: rgba(15,23,42,.35); min-height: 60px; min-width: 0; max-width: 240px; }
    .merchant-summary-item .fw-semibold { line-height: 1.1; font-size: .95rem; }
    .merchant-summary-item .text-truncate { max-width: 100%; }
    .merchant-summary-item .form-select { min-width: 0; font-size: .9rem; padding-top: .25rem; padding-bottom: .25rem; }
    .three-layout { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; align-items: start; }
    .small-muted { color: var(--text-muted,#64748b); font-size: .78rem; }
    @media (max-width: 1200px) {
      .filter-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .console-toolbar { flex-wrap: wrap; }
      .console-toolbar-left { white-space: normal; }
      .console-toolbar { grid-template-columns: 1fr; }
      .console-toolbar-right .filter-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .statement-compare-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .split-layout, .three-layout { grid-template-columns: 1fr; }
      .merchant-toolbar { align-items: flex-start; }
      .merchant-toolbar-right { width: 100%; }
      .merchant-toolbar-right .form-select, .merchant-toolbar-right .form-control { width: 100%; }
      .merchant-range-group, .merchant-range-group.is-visible { width: 100%; }
      .merchant-summary-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .split-layout > .finance-panel:last-child { display: block; }
    }
    @media (max-width: 640px) {
      .filter-grid, .kpi-grid { grid-template-columns: 1fr; }
      .console-toolbar-right .filter-grid { grid-template-columns: 1fr; }
      .console-actions { width: 100%; }
      .statement-compare-grid { grid-template-columns: 1fr; }
      .bar-row, .stack-row { grid-template-columns: 1fr; gap: .25rem; }
      .split-layout, .three-layout { grid-template-columns: 1fr; }
      .merchant-toolbar-right { flex-direction: column; }
      .merchant-summary-strip { grid-template-columns: 1fr; }
      .split-layout > .finance-panel:last-child { display: block; }
    }
  </style>
</head>
<body>
<div class="wrapper">
  <%- include('partials/sidebar') %>
  <div id="content">
    <nav class="navbar navbar-expand-lg px-4 mb-4">
      <button type="button" id="sidebarCollapse" class="btn btn-primary btn-sm"><i class="fas fa-bars"></i></button>
      <span class="ms-3 fw-bold fs-5">Financial Workspace</span>
      <div class="ms-auto d-flex align-items-center gap-2">
        <button id="themeToggle" class="btn btn-outline-secondary btn-sm" title="Toggle theme"><i class="fas fa-moon"></i></button>
        <span id="userGreeting" class="text-muted small"></span>
        <button id="logoutBtn" class="btn btn-danger btn-sm"><i class="fas fa-sign-out-alt me-1"></i>Logout</button>
      </div>
    </nav>

    <div class="container-fluid px-4 finance-shell">
      <section class="finance-panel">
        <div class="console-toolbar mb-3">
          <div class="console-toolbar-left">
            <h5 class="mb-0">Accounting Console</h5>
            <div class="small-muted">Account, currency, period, budget, and ledger selectors.</div>
          </div>
          <div class="console-toolbar-right">
            <div class="filter-grid">
              <div>
                <label class="form-label">Year</label>
                <select id="yearFilter" class="form-select"><option value="">Loading...</option></select>
              </div>
              <div>
                <label class="form-label">Month</label>
                <select id="monthFilter" class="form-select">
                  <option value="">All</option>
                  <option value="1">Jan</option><option value="2">Feb</option><option value="3">Mar</option>
                  <option value="4">Apr</option><option value="5">May</option><option value="6">Jun</option>
                  <option value="7">Jul</option><option value="8">Aug</option><option value="9">Sep</option>
                  <option value="10">Oct</option><option value="11">Nov</option><option value="12">Dec</option>
                </select>
                <div class="small-muted" id="monthStatementHint"></div>
              </div>
              <div>
                <label class="form-label">Account</label>
                <select id="accountFilter" class="form-select"><option value="">All accounts</option></select>
              </div>
              <div>
                <label class="form-label">Account Type</label>
                <select id="accountClassFilter" class="form-select">
                  <option value="">All types</option>
                  <option value="checking">Checking</option>
                  <option value="savings">Savings</option>
                  <option value="credit_card">Credit Card</option>
                  <option value="investment">Investment</option>
                  <option value="retirement">Retirement</option>
                  <option value="cash">Cash</option>
                  <option value="foreign_currency">Foreign Currency</option>
                </select>
              </div>
              <div>
                <label class="form-label">Currency</label>
                <select id="currencyFilter" class="form-select"><option value="USD">USD</option><option value="ALL">All</option><option value="COP">COP</option><option value="EUR">EUR</option></select>
              </div>
              <div>
                <label class="form-label">Search</label>
                <input id="searchFilter" class="form-control" placeholder="merchant, tag, memo">
              </div>
              <div class="console-actions">
                <button class="btn btn-outline-primary btn-sm d-none" id="seedBtn"><i class="fas fa-chart-line me-1"></i>Load Sample</button>
                <button class="btn btn-outline-danger btn-sm d-none" id="clearBtn"><i class="fas fa-trash-alt me-1"></i>Clear Sample</button>
                <button class="btn btn-primary flex-fill" id="runBtn"><i class="fas fa-search me-1"></i>Run</button>
                <button class="btn btn-outline-secondary" id="resetBtn" title="Reset filters"><i class="fas fa-undo"></i></button>
                <label class="statement-toggle mb-0" for="statementCompareToggle"><input class="form-check-input m-0" type="checkbox" id="statementCompareToggle"> Statement</label>
                <button class="btn btn-outline-success btn-sm" id="exportBtn"><i class="fas fa-file-csv me-1"></i>Export</button>
                <button class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="fas fa-print me-1"></i>Print</button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="finance-panel d-none" id="statementComparePanel">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
          <div>
            <h5 class="mb-1">Statement Balance Comparison</h5>
            <div class="small-muted" id="statementCompareSubtitle">Select one account to compare the dashboard value with imported statement snapshots.</div>
          </div>
          <a class="btn btn-outline-secondary btn-sm" href="/balance-snapshots"><i class="fas fa-camera-retro me-1"></i>Balance Snapshots</a>
        </div>
        <div class="statement-compare-grid mb-3" id="statementCompareGrid"></div>
        <div class="small-muted mb-2">Recent statement snapshots for this account</div>
        <div class="statement-snapshot-list" id="statementSnapshotList"></div>
      </section>

      <section class="kpi-grid" id="kpiGrid"></section>

      <section class="finance-panel d-none" id="kpiDetailPanel">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
          <div>
            <h5 class="mb-1" id="kpiDetailTitle">KPI Detail Report</h5>
            <div class="small-muted" id="kpiDetailFormula">Click a KPI card to inspect the rows behind it.</div>
          </div>
          <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-success btn-sm" type="button" id="kpiDetailExportBtn"><i class="fas fa-file-csv me-1"></i>Export Detail</button>
            <button class="btn btn-outline-secondary btn-sm" type="button" id="kpiDetailCloseBtn"><i class="fas fa-times me-1"></i>Close</button>
          </div>
        </div>
        <div class="kpi-detail-summary mb-3" id="kpiDetailSummary"></div>
        <div class="kpi-detail-table-wrap table-responsive">
          <table class="table table-sm table-hover align-middle kpi-detail-table">
            <thead id="kpiDetailHead"></thead>
            <tbody id="kpiDetailRows"><tr><td class="text-muted">No KPI selected.</td></tr></tbody>
          </table>
        </div>
      </section>

      <section class="split-layout">
        <div class="finance-panel">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Trend Explorer</h5>
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <span class="small-muted" id="periodLabel">Loading...</span>
              <select id="trendGroup" class="form-select form-select-sm" style="width:132px">
                <option value="category">Category</option>
                <option value="merchant">Merchant</option>
                <option value="account">Account</option>
              </select>
              <select id="trendGrain" class="form-select form-select-sm" style="width:110px">
                <option value="month">Month</option>
                <option value="week">Week</option>
                <option value="day">Day</option>
              </select>
              <select id="trendMeasure" class="form-select form-select-sm" style="width:118px">
                <option value="expense">Expense</option>
                <option value="income">Income</option>
                <option value="transfer">Transfer</option>
                <option value="net">Net</option>
              </select>
              <select id="trendChartType" class="form-select form-select-sm" style="width:118px">
                <option value="bar">Bars</option>
                <option value="line">Curve</option>
                <option value="area">Area</option>
              </select>
              <button class="btn btn-outline-primary btn-sm" id="trendRefreshBtn"><i class="fas fa-sync-alt me-1"></i>Refresh</button>
            </div>
          </div>
          <div class="finance-chart-frame"><canvas id="monthlyCashFlowChart"></canvas></div>
        </div>
        <div class="finance-panel">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Spending by Category</h5>
            <span class="small-muted">Top categories</span>
          </div>
          <div class="split-layout">
            <div class="finance-chart-frame category-chart-frame"><canvas id="categorySpendChart"></canvas></div>
          </div>
        </div>
      </section>

      <section class="finance-panel">
        <div class="merchant-toolbar mb-3">
          <div class="merchant-toolbar-left">
            <h5 class="mb-1">Usage by Official Merchant</h5>
            <div class="small-muted">Canonical merchant names from aliases and import review.</div>
          </div>
          <div class="merchant-toolbar-right">
            <select id="merchantCategorySelect" class="form-select form-select-sm">
              <option value="">All categories</option>
            </select>
            <select id="merchantSummarySelect" class="form-select form-select-sm">
              <option value="">All merchants</option>
            </select>
            <select id="merchantRangeMode" class="form-select form-select-sm">
              <option value="page">Page dates</option>
              <option value="custom">Custom dates</option>
            </select>
            <select id="merchantTrendGrain" class="form-select form-select-sm">
              <option value="month">Month</option>
              <option value="week">Week</option>
              <option value="day">Day</option>
              <option value="year">Year</option>
            </select>
            <select id="merchantTrendType" class="form-select form-select-sm">
              <option value="bar">Bars</option>
              <option value="line">Line</option>
              <option value="area">Area</option>
            </select>
            <div id="merchantRangeGroup" class="merchant-range-group">
              <div class="merchant-date-field">
                <label for="merchantFromDate">From</label>
                <input id="merchantFromDate" class="form-control form-control-sm" type="date" aria-label="Merchant custom start date">
              </div>
              <div class="merchant-date-field">
                <label for="merchantToDate">To</label>
                <input id="merchantToDate" class="form-control form-control-sm" type="date" aria-label="Merchant custom end date">
              </div>
            </div>
            <button id="merchantDateApplyBtn" class="btn btn-primary btn-sm merchant-apply-btn" type="button">Enter</button>
            <div class="merchant-stat-chip">
              <div class="small-muted text-uppercase">Spend</div>
              <div id="merchantSummaryAmount" class="fw-semibold">-</div>
            </div>
            <div class="merchant-stat-chip">
              <div class="small-muted text-uppercase">Transactions</div>
              <div id="merchantSummaryCount" class="fw-semibold">-</div>
            </div>
            <button id="merchantHeaderResetBtn" class="btn btn-outline-secondary btn-sm" type="button">Clear</button>
            <a class="btn btn-outline-secondary btn-sm" href="/merchants"><i class="fas fa-store me-1"></i>Official Merchants</a>
          </div>
        </div>
        <div class="split-layout merchant-content-layout">
          <div class="merchant-chart-stack">
            <div class="finance-chart-frame compact"><canvas id="merchantSpendChart"></canvas></div>
            <div class="finance-chart-frame compact"><canvas id="merchantActiveSpendChart"></canvas></div>
          </div>
          <div id="merchantRankList" class="rank-list"></div>
        </div>
      </section>

      <section class="three-layout">
        <div class="finance-panel">
          <h5 class="mb-3">Accounts</h5>
          <div id="accountStack"></div>
        </div>
        <div class="finance-panel">
          <h5 class="mb-3">Budget Watch</h5>
          <div id="budgetWatch"></div>
        </div>
        <div class="finance-panel">
          <h5 class="mb-3">Goals</h5>
          <div id="goalList"></div>
        </div>
      </section>

      <section class="split-layout">
        <div class="finance-panel">
          <h5 class="mb-3">Recurring Calendar</h5>
          <div class="table-responsive">
            <table class="table table-sm align-middle">
              <thead><tr><th>Date</th><th>Name</th><th>Account</th><th>Type</th><th class="text-end">Amount</th></tr></thead>
              <tbody id="recurringRows"><tr><td colspan="5" class="text-muted">Loading...</td></tr></tbody>
            </table>
          </div>
        </div>
        <div class="finance-panel">
          <h5 class="mb-3">Investments</h5>
          <div id="investmentList"></div>
        </div>
      </section>

      <section class="finance-panel">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
          <div>
            <h5 class="mb-1">Transaction Search</h5>
            <div class="small-muted" id="searchCount">0 records</div>
          </div>
          <div class="small-muted text-uppercase">Release v<%= typeof appVersion !== 'undefined' ? appVersion : '0.2.0' %></div>
          <div class="d-flex flex-wrap gap-2">
            <select id="typeFilter" class="form-select form-select-sm" style="width:150px">
              <option value="">All types</option>
              <option value="income">Income</option>
              <option value="expense">Expense</option>
              <option value="transfer">Transfer</option>
              <option value="adjustment">Adjustment</option>
            </select>
            <select id="statusFilter" class="form-select form-select-sm" style="width:150px">
              <option value="">All status</option>
              <option value="draft">Draft</option>
              <option value="reviewed">Reviewed</option>
              <option value="reconciled">Reconciled</option>
              <option value="void">Void</option>
            </select>
            <input id="fromFilter" class="form-control form-control-sm" type="date" style="width:155px">
            <input id="toFilter" class="form-control form-control-sm" type="date" style="width:155px">
          </div>
        </div>
        <div class="ledger-wrap table-responsive">
          <table class="table table-hover align-middle compact-table">
            <thead>
              <tr>
                <th data-sort="transactionDate">Date</th>
                <th data-sort="accountName">Account</th>
                <th data-sort="categoryName">Category</th>
                <th data-sort="merchant">Merchant</th>
                <th data-sort="description">Description</th>
                <th data-sort="transactionType">Type</th>
                <th data-sort="amount" class="text-end">Amount</th>
                <th data-sort="status">Status</th>
              </tr>
            </thead>
            <tbody id="ledgerRows"><tr><td colspan="8" class="text-muted">Loading...</td></tr></tbody>
          </table>
        </div>
      </section>
    </div>
  </div>
</div>

<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100"></div>
<script src="/assets/bootstrap.bundle.min.js"></script>
<script src="/assets/chart.umd.min.js"></script>
<a id="xa-base" href="/login" style="display:none"></a>
<script src="/js/base.js"></script>
<script src="/js/main.js"></script>
<script>
let accounts = [];
let categories = [];
let overview = null;
let searchRows = [];
let searchSummary = { merchantSummary: [] };
let sortState = { key: 'transactionDate', dir: 'desc' };
let selectedCategoryId = '';
let selectedMerchantId = '';
let monthlyCashFlowChart = null;
let categorySpendChart = null;
let merchantSpendChart = null;
let merchantActiveSpendChart = null;
let trendChartData = null;
let merchantTrendData = null;
let merchantActiveTrendData = null;
let explorerRows = [];
let categoryChartRows = [];
let preferTopMerchantOnNextLoad = false;
let merchantRenderSeq = 0;
let activeKpiMetric = '';
let kpiDetailData = null;
let availableYears = [];
let defaultYear = String(new Date().getFullYear());

function authHeaders(json) {
  const token = localStorage.getItem('haToken') || localStorage.getItem('token') || '';
  const headers = token ? { Authorization: 'Bearer ' + token } : {};
  if (json) headers['Content-Type'] = 'application/json';
  return headers;
}
function esc(value) {
  return String(value == null ? '' : value).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
}
function attr(value) {
  return esc(value);
}
function csvCell(value) {
  return '"' + String(value == null ? '' : value).replace(/"/g, '""') + '"';
}
function money(value, currency) {
  const code = currency && currency !== 'ALL' ? currency : (document.getElementById('currencyFilter').value !== 'ALL' ? document.getElementById('currencyFilter').value : 'USD');
  return Number(value || 0).toLocaleString(undefined, { style: 'currency', currency: code, maximumFractionDigits: code === 'COP' ? 0 : 2 });
}
function numberFmt(value) {
  return Number(value || 0).toLocaleString(undefined, { maximumFractionDigits: 1 });
}
function monthShortName(month) {
  return ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'][Number(month || 0) - 1] || '';
}
function toast(message, type) {
  if (typeof showToast === 'function') showToast(message, type || 'success');
}
function qs(params) {
  return Object.keys(params).filter(key => params[key] !== '' && params[key] != null).map(key => encodeURIComponent(key) + '=' + encodeURIComponent(params[key])).join('&');
}
function populateYearSelect(selectId, payload) {
  const select = document.getElementById(selectId);
  const previous = select.value;
  const years = (payload && Array.isArray(payload.years) ? payload.years : [])
    .map(year => String(year))
    .filter(year => /^\d{4}$/.test(year));
  if (!years.length) years.push(String(new Date().getFullYear()));
  availableYears = years;
  defaultYear = String((payload && payload.defaultYear) || years[0]);
  select.innerHTML = '<option value="all">All years</option>' + years.map(year => '<option value="' + esc(year) + '">' + esc(year) + '</option>').join('');
  select.value = previous === 'all' ? 'all' : (years.includes(previous) ? previous : (years.includes(defaultYear) ? defaultYear : years[0]));
  syncYearMode();
}
function syncYearMode() {
  const isAllYears = document.getElementById('yearFilter').value === 'all';
  const monthFilter = document.getElementById('monthFilter');
  if (isAllYears) monthFilter.value = '';
  monthFilter.disabled = isAllYears;
}
function selectedAccountSummary() {
  const accountId = document.getElementById('accountFilter').value;
  if (!accountId || !overview) return null;
  return (overview.accountTotals || []).find(account => String(account.id) === String(accountId)) || null;
}
function accountStatementSnapshots(accountId) {
  return (overview && overview.statementSnapshots ? overview.statementSnapshots : [])
    .filter(snapshot => String(snapshot.accountId) === String(accountId || ''))
    .sort((a, b) => String(b.snapshotDate || '').localeCompare(String(a.snapshotDate || '')));
}
function statementSnapshotForSelection(accountId) {
  const snapshots = accountStatementSnapshots(accountId);
  if (!snapshots.length) return null;
  const year = document.getElementById('yearFilter').value;
  const month = document.getElementById('monthFilter').value;
  if (year && year !== 'all' && month) {
    const prefix = year + '-' + String(month).padStart(2, '0');
    return snapshots.find(snapshot => String(snapshot.snapshotDate || '').startsWith(prefix)) || snapshots.find(snapshot => String(snapshot.snapshotDate || '') <= prefix + '-31') || snapshots[0];
  }
  if (year && year !== 'all') {
    return snapshots.find(snapshot => String(snapshot.snapshotDate || '').startsWith(year + '-')) || snapshots[0];
  }
  return snapshots[0];
}
function resetMonthLabels() {
  const monthFilter = document.getElementById('monthFilter');
  Array.from(monthFilter.options).forEach(option => {
    if (!option.value) {
      option.textContent = 'All';
    } else {
      option.textContent = monthShortName(option.value);
      option.title = '';
    }
  });
}
function updateMonthStatementHints() {
  resetMonthLabels();
  const hint = document.getElementById('monthStatementHint');
  if (hint) hint.textContent = '';
  if (!overview) return;
  const accountId = document.getElementById('accountFilter').value;
  const year = document.getElementById('yearFilter').value;
  if (!accountId || !year || year === 'all') return;
  const snapshots = accountStatementSnapshots(accountId).filter(snapshot => String(snapshot.snapshotDate || '').startsWith(year + '-'));
  const byMonth = new Map();
  snapshots.forEach(snapshot => {
    const month = String(snapshot.snapshotDate || '').slice(5, 7);
    if (!byMonth.has(month)) byMonth.set(month, snapshot);
  });
  const monthFilter = document.getElementById('monthFilter');
  Array.from(monthFilter.options).forEach(option => {
    if (!option.value) return;
    const key = String(option.value).padStart(2, '0');
    const snapshot = byMonth.get(key);
    if (!snapshot) return;
    option.textContent = monthShortName(option.value) + ' | stmt ' + money(snapshot.balance, snapshot.currency) + ' ' + snapshot.snapshotDate;
    option.title = 'Statement balance ' + money(snapshot.balance, snapshot.currency) + ' on ' + snapshot.snapshotDate;
  });
  const selectedSnapshot = statementSnapshotForSelection(accountId);
  if (hint && selectedSnapshot) {
    hint.textContent = 'Statement ' + money(selectedSnapshot.balance, selectedSnapshot.currency) + ' on ' + selectedSnapshot.snapshotDate;
  }
}
function statementCompareItem(label, value, subtext, tone) {
  return '<div class="statement-compare-item">' +
    '<div class="small-muted text-uppercase">' + esc(label) + '</div>' +
    '<div class="statement-compare-value ' + (tone || '') + '">' + esc(value) + '</div>' +
    '<div class="small-muted mt-1">' + esc(subtext || '') + '</div>' +
  '</div>';
}
function renderStatementComparison() {
  const panel = document.getElementById('statementComparePanel');
  const toggle = document.getElementById('statementCompareToggle');
  updateMonthStatementHints();
  if (!panel || !toggle || !toggle.checked) {
    if (panel) panel.classList.add('d-none');
    return;
  }
  const accountId = document.getElementById('accountFilter').value;
  const account = selectedAccountSummary();
  if (!accountId || !account) {
    panel.classList.remove('d-none');
    document.getElementById('statementCompareSubtitle').textContent = 'Select one account to compare against statement snapshots.';
    document.getElementById('statementCompareGrid').innerHTML = '<div class="text-muted">Choose an account from the Account filter.</div>';
    document.getElementById('statementSnapshotList').innerHTML = '';
    return;
  }
  const snapshot = statementSnapshotForSelection(accountId);
  const dashboardBalance = Number(account.balance || 0);
  const statementBalance = snapshot ? Number(snapshot.balance || 0) : null;
  const difference = snapshot ? dashboardBalance - statementBalance : null;
  const diffTone = snapshot && Math.abs(difference) <= 0.01 ? 'text-success' : 'text-warning';
  panel.classList.remove('d-none');
  document.getElementById('statementCompareSubtitle').textContent = account.name + ' | dashboard period ' + (overview.filters && overview.filters.year ? overview.filters.year : '') + (overview.filters && overview.filters.month ? '-' + String(overview.filters.month).padStart(2, '0') : '');
  document.getElementById('statementCompareGrid').innerHTML = [
    statementCompareItem('Dashboard balance', money(dashboardBalance, account.currency), 'Value currently used by the workspace.'),
    statementCompareItem('Statement snapshot', snapshot ? money(statementBalance, snapshot.currency) : 'No snapshot', snapshot ? ('Cutoff ' + snapshot.snapshotDate) : 'No statement checkpoint found.'),
    statementCompareItem('Difference', snapshot ? money(difference, account.currency) : '-', snapshot ? 'Dashboard minus statement.' : 'Select a period with a statement.', diffTone),
    statementCompareItem('Ledger movement', money(account.ledgerBalance == null ? 0 : account.ledgerBalance, account.currency), 'Current account balance plus selected-period movement.')
  ].join('');
  const snapshots = accountStatementSnapshots(accountId).slice(0, 10);
  document.getElementById('statementSnapshotList').innerHTML = snapshots.length ? snapshots.map(item => (
    '<span class="statement-snapshot-chip">' + esc(item.snapshotDate) + ' ' + esc(money(item.balance, item.currency)) + '</span>'
  )).join('') : '<span class="text-muted">No statement snapshots found for this account.</span>';
}
function merchantLabel(row) {
  return row.merchantDisplayName || row.merchantOfficialName || row.merchant || row.receiptMerchant || row.normalizedMerchant || row.description || '';
}
function merchantDetail(row) {
  const primary = merchantLabel(row);
  return [row.merchantOfficialName, row.merchantGroupName, row.receiptMerchant, row.rawMerchant, row.normalizedMerchant]
    .filter(value => value && value !== primary)
    .find(Boolean) || '';
}
function merchantRowKey(row) {
  if (!row) return '';
  return row.merchantKey || (row.merchantId ? 'merchant:' + row.merchantId : '');
}
function merchantOptionHtml(row) {
  return '<option value="' + esc(merchantRowKey(row)) + '">' + esc(row.name) + '</option>';
}
function percentBar(value, colorClass) {
  const width = Math.max(0, Math.min(100, Number(value || 0)));
  return '<div class="bar-track"><div class="bar-fill ' + (colorClass || 'bar-net') + '" style="width:' + width + '%"></div></div>';
}
function maxAbs(rows, keys) {
  return Math.max(1, ...rows.flatMap(row => keys.map(key => Math.abs(Number(row[key] || 0)))));
}
function chartColor(index) {
  const colors = ['#0d6efd', '#198754', '#dc3545', '#f59e0b', '#14b8a6', '#7c3aed', '#0ea5e9', '#db2777', '#64748b', '#84cc16'];
  return colors[index % colors.length];
}
function merchantCustomRange() {
  return {
    from: document.getElementById('merchantFromDate').value,
    to: document.getElementById('merchantToDate').value
  };
}
function normalizeMerchantCustomRange(options) {
  const opts = options || {};
  const fromInput = document.getElementById('merchantFromDate');
  const toInput = document.getElementById('merchantToDate');
  let from = fromInput.value;
  let to = toInput.value;

  if (opts.fillSingleDate) {
    if (from && !to) to = from;
    if (to && !from) from = to;
  }
  if (from && to && from > to) {
    const lower = to;
    to = from;
    from = lower;
  }

  if (opts.updateInputs) {
    fromInput.value = from;
    toInput.value = to;
  }

  return { from, to };
}
function merchantCardFilterParams() {
  const f = filters();
  const grain = document.getElementById('merchantTrendGrain').value || 'month';
  const rangeMode = document.getElementById('merchantRangeMode').value || 'page';
  const useCustomRange = rangeMode === 'custom';
  const customRange = useCustomRange ? normalizeMerchantCustomRange({ updateInputs: true }) : merchantCustomRange();
  return {
    year: f.year,
    month: f.month,
    accountId: f.accountId,
    accountClass: f.accountClass,
    currency: f.currency,
    status: document.getElementById('statusFilter').value,
    categoryId: selectedCategoryId || '',
    merchantKey: selectedMerchantId || '',
    from: useCustomRange ? customRange.from : document.getElementById('fromFilter').value,
    to: useCustomRange ? customRange.to : document.getElementById('toFilter').value,
    grain,
    rangeMode,
    chartType: document.getElementById('merchantTrendType').value || 'bar'
  };
}
function syncMerchantDateBounds(changedField) {
  normalizeMerchantCustomRange({ updateInputs: changedField === 'apply', fillSingleDate: changedField === 'apply' });
}
function syncMerchantRangeVisibility() {
  const isCustom = (document.getElementById('merchantRangeMode').value || 'page') === 'custom';
  const rangeGroup = document.getElementById('merchantRangeGroup');
  const fromInput = document.getElementById('merchantFromDate');
  const toInput = document.getElementById('merchantToDate');
  rangeGroup.classList.toggle('is-inactive', !isCustom);
  syncMerchantDateBounds();
}
function applyMerchantCustomRange() {
  document.getElementById('merchantRangeMode').value = 'custom';
  syncMerchantRangeVisibility();
  syncMerchantDateBounds('apply');
  renderMerchantSummary();
}
function buildMerchantSummary(rows) {
  const map = new Map();
  (rows || []).forEach(row => {
    const amount = Math.abs(Number(row.amount || 0));
    const name = merchantLabel(row) || 'No merchant';
    const key = row.merchantKey || (row.merchantId ? 'merchant:' + row.merchantId : 'text:' + name.toLowerCase());
    if (!map.has(key)) map.set(key, { merchantKey: key, merchantId: row.merchantId || null, name, amount: 0, count: 0 });
    const item = map.get(key);
    item.amount += amount;
    item.count += 1;
  });
  return Array.from(map.values()).sort((a, b) => b.amount - a.amount);
}

async function loadLookups() {
  const [accountRows, categoryRows, yearPayload] = await Promise.all([
    fetch('/api/accounts', { headers: authHeaders() }).then(r => r.ok ? r.json() : []),
    fetch('/api/categories', { headers: authHeaders() }).then(r => r.ok ? r.json() : []),
    fetch('/api/finance/years', { headers: authHeaders() }).then(r => r.ok ? r.json() : null)
  ]);
  accounts = accountRows;
  categories = categoryRows;
  populateYearSelect('yearFilter', yearPayload);
  document.getElementById('accountFilter').innerHTML = '<option value="">All accounts</option>' + accounts.map(account => '<option value="' + account.id + '">' + esc(account.name) + '</option>').join('');
  document.getElementById('merchantCategorySelect').innerHTML = '<option value="">All categories</option>' + categories.map(category => '<option value="' + category.id + '">' + esc(category.name) + '</option>').join('');
  document.getElementById('merchantSummarySelect').innerHTML = '<option value="">All merchants</option>';
}

function filters() {
  const year = document.getElementById('yearFilter').value || defaultYear;
  const month = document.getElementById('monthFilter').value;
  return {
    year,
    month,
    accountId: document.getElementById('accountFilter').value,
    accountClass: document.getElementById('accountClassFilter').value,
    currency: document.getElementById('currencyFilter').value || 'USD'
  };
}

async function loadOverview() {
  const response = await fetch('/api/finance/overview?' + qs(filters()), { headers: authHeaders() });
  if (!response.ok) throw new Error('Overview failed');
  overview = await response.json();
  if (overview.filters && overview.filters.currencies) {
    const selected = document.getElementById('currencyFilter').value || 'ALL';
    document.getElementById('currencyFilter').innerHTML = '<option value="USD">USD</option><option value="ALL">All</option>' + overview.filters.currencies.filter(currency => currency !== 'USD').map(currency => '<option value="' + esc(currency) + '">' + esc(currency) + '</option>').join('');
    document.getElementById('currencyFilter').value = selected;
  }
  renderOverview();
}

async function loadSearch() {
  const f = filters();
  const params = {
    q: document.getElementById('searchFilter').value.trim(),
    year: f.year,
    month: f.month,
    accountId: f.accountId,
    currency: f.currency,
    type: document.getElementById('typeFilter').value,
    status: document.getElementById('statusFilter').value,
    categoryId: document.getElementById('merchantCategorySelect').value || selectedCategoryId,
    merchantKey: document.getElementById('merchantSummarySelect').value || selectedMerchantId,
    from: document.getElementById('fromFilter').value,
    to: document.getElementById('toFilter').value,
    limit: 500
  };
  const response = await fetch('/api/finance/search?' + qs(params), { headers: authHeaders() });
  if (!response.ok) throw new Error('Search failed');
  const data = await response.json();
  searchRows = data.rows || [];
  searchSummary = { merchantSummary: data.merchantSummary || buildMerchantSummary(searchRows) };
  explorerRows = searchSummary.merchantSummary || [];
  preferTopMerchantOnNextLoad = false;
  document.getElementById('merchantSummarySelect').innerHTML = '<option value="">All merchants</option>' + explorerRows.map(merchantOptionHtml).join('');
  document.getElementById('merchantSummarySelect').value = selectedMerchantId || '';
  document.getElementById('merchantCategorySelect').value = selectedCategoryId || '';
  renderLedger();
  renderMerchantSummary();
}

function renderKpis(summary) {
  const cards = [
    { key: 'netWorth', label: 'Net Worth', value: summary.netWorth, icon: 'fa-wallet', hint: 'Includes eligible accounts and holdings' },
    { key: 'cashFlow', label: 'Cash Flow', value: summary.cashFlow, icon: 'fa-scale-balanced', hint: 'Income less expenses' },
    { key: 'income', label: 'Income', value: summary.income, icon: 'fa-arrow-trend-up', hint: 'Reviewed activity' },
    { key: 'expenses', label: 'Expenses', value: summary.expenses, icon: 'fa-arrow-trend-down', hint: 'Spend categories' },
    { key: 'savingsRate', label: 'Savings Rate', value: summary.savingsRatePct + '%', icon: 'fa-piggy-bank', hint: 'Cash flow over income', plain: true },
    { key: 'creditUtilization', label: 'Credit Utilization', value: summary.creditUtilizationPct + '%', icon: 'fa-credit-card', hint: 'Current card use', plain: true },
    { key: 'investments', label: 'Investments', value: summary.investmentValue, icon: 'fa-chart-area', hint: 'Market value' },
    { key: 'budgetUsed', label: 'Budget Used', value: summary.budgetUsagePct + '%', icon: 'fa-clipboard-check', hint: 'Actual over plan', plain: true }
  ];
  document.getElementById('kpiGrid').innerHTML = cards.map(card => (
    '<button class="kpi-card kpi-card-action ' + (activeKpiMetric === card.key ? 'is-active' : '') + '" type="button" data-kpi="' + esc(card.key) + '" aria-label="Open ' + esc(card.label) + ' detail">' +
      '<div class="d-flex justify-content-between align-items-start mb-3">' +
        '<div class="small-muted">' + esc(card.label) + '</div>' +
        '<span class="kpi-icon"><i class="fas ' + card.icon + '"></i></span>' +
      '</div>' +
      '<div class="kpi-value">' + (card.plain ? esc(card.value) : money(card.value)) + '</div>' +
      '<div class="small-muted mt-2">' + esc(card.hint) + '</div>' +
    '</button>'
  )).join('');
}

async function renderMonthly() {
  if (!overview) return;
  const selectedMonth = overview.filters && overview.filters.month ? Number(overview.filters.month) : null;
  const selectedYear = overview.filters ? overview.filters.year : defaultYear;
  const groupBy = document.getElementById('trendGroup').value;
  const grain = document.getElementById('trendGrain').value;
  const measure = document.getElementById('trendMeasure').value;
  const chartType = document.getElementById('trendChartType').value;
  document.getElementById('periodLabel').textContent = selectedYear === 'all' ? 'All years' : selectedYear + (overview.filters.month ? '-' + String(overview.filters.month).padStart(2, '0') : '');
  const response = await fetch('/api/finance/trends?' + qs({
    year: selectedYear,
    month: selectedMonth || '',
    accountId: document.getElementById('accountFilter').value,
    accountClass: document.getElementById('accountClassFilter').value,
    currency: document.getElementById('currencyFilter').value || 'USD',
    groupBy,
    grain,
    measure,
    top: 8
  }), { headers: authHeaders() });
  if (!response.ok) return;
  trendChartData = await response.json();
  const type = chartType === 'bar' ? 'bar' : 'line';
  const datasets = (trendChartData.series || []).map((serie, index) => ({
    label: serie.name,
    data: serie.values,
    borderColor: chartColor(index),
    backgroundColor: chartType === 'area' ? chartColor(index) + '22' : (type === 'line' ? chartColor(index) + '22' : chartColor(index) + 'bb'),
    borderWidth: 2,
    tension: chartType === 'bar' ? 0 : .4,
    fill: chartType !== 'bar',
    pointRadius: chartType === 'bar' ? 0 : 3
  }));
  if (monthlyCashFlowChart) monthlyCashFlowChart.destroy();
  monthlyCashFlowChart = new Chart(document.getElementById('monthlyCashFlowChart'), {
    type,
    data: { labels: trendChartData.labels || [], datasets },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { position: 'bottom' } },
      scales: { y: { beginAtZero: true } }
    }
  });
}

function renderCategories() {
  const rows = overview.categoryTotals || [];
  const chartRows = rows.slice(0, 12);
  categoryChartRows = chartRows;
  if (categorySpendChart) categorySpendChart.destroy();
  categorySpendChart = new Chart(document.getElementById('categorySpendChart'), {
    type: 'bar',
    data: {
      labels: chartRows.map(row => row.name),
      datasets: [{
        label: 'Spending',
        data: chartRows.map(row => Number(row.amount || 0)),
        backgroundColor: chartRows.map((row, index) => chartColor(index) + 'bb'),
        borderColor: chartRows.map((row, index) => chartColor(index)),
        borderWidth: 1
      }]
    },
    options: {
      indexAxis: 'y',
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: { x: { beginAtZero: true } }
    }
  });
}

function merchantVisibleSeries(data, selectedRow) {
  const seriesList = Array.isArray(data && data.series) ? data.series : [];
  const targetName = selectedRow ? selectedRow.name : '';
  const targetKey = merchantRowKey(selectedRow);
  const chosen = seriesList.find(serie => String(serie.key || '') === String(targetKey || '') || String(serie.name || '') === String(targetName || '')) || seriesList[0] || null;
  return selectedRow ? (chosen ? [chosen] : []) : seriesList.slice(0, 8);
}

function parseTrendDate(value) {
  const text = String(value || '').trim();
  const iso = /^\d{4}-\d{2}-\d{2}/.test(text)
    ? text.slice(0, 10)
    : (/^\d{4}-\d{2}$/.test(text) ? text + '-01' : (/^\d{4}$/.test(text) ? text + '-01-01' : ''));
  if (!iso) return null;
  const date = new Date(iso + 'T00:00:00Z');
  return Number.isNaN(date.getTime()) ? null : date;
}

function trendIsoDate(date) {
  return date.toISOString().slice(0, 10);
}

function trendDayOffset(date, startDate) {
  return Math.round((date.getTime() - startDate.getTime()) / 86400000);
}

function trendDateFromOffset(startDate, offset) {
  return new Date(startDate.getTime() + (Number(offset) || 0) * 86400000);
}

function merchantCalendarAxis(data, cardFilters) {
  const labels = data && Array.isArray(data.labels) ? data.labels : [];
  const labelDates = labels.map(parseTrendDate).filter(Boolean);
  let startDate = parseTrendDate(cardFilters && cardFilters.from) || labelDates[0] || null;
  let endDate = parseTrendDate(cardFilters && cardFilters.to) || labelDates[labelDates.length - 1] || startDate;
  if (!startDate || !endDate) return null;
  if (startDate > endDate) {
    const swap = startDate;
    startDate = endDate;
    endDate = swap;
  }
  return {
    startDate,
    endDate,
    min: 0,
    max: Math.max(1, trendDayOffset(endDate, startDate))
  };
}

function merchantCalendarValues(values, labels, axisMeta) {
  return (values || []).map((value, index) => {
    const date = parseTrendDate(labels[index]);
    return {
      x: date ? trendDayOffset(date, axisMeta.startDate) : index,
      y: Number(value || 0)
    };
  });
}

function merchantChartDatasets(data, selectedRow, chartType, axisMeta) {
  const labels = data && Array.isArray(data.labels) ? data.labels : [];
  return merchantVisibleSeries(data, selectedRow).map((serie, index) => ({
    label: serie.name || 'Merchant',
    data: axisMeta ? merchantCalendarValues(serie.values || [], labels, axisMeta) : (serie.values || []),
    borderColor: chartColor(index),
    backgroundColor: chartType === 'area' ? chartColor(index) + '22' : (chartType === 'line' ? chartColor(index) + '22' : chartColor(index) + 'bb'),
    borderWidth: 2,
    tension: chartType === 'bar' ? 0 : .35,
    fill: chartType !== 'bar',
    pointRadius: chartType === 'bar' ? 0 : 3
  }));
}

function renderMerchantTrendCanvas(canvasId, data, selectedRow, chartType, titleText, options) {
  const opts = options || {};
  const axisMeta = opts.calendarAxis ? merchantCalendarAxis(data, opts.cardFilters || {}) : null;
  const datasets = merchantChartDatasets(data, selectedRow, chartType, axisMeta);
  return new Chart(document.getElementById(canvasId), {
    type: chartType === 'bar' ? 'bar' : 'line',
    data: axisMeta ? {
      datasets
    } : {
      labels: data && data.labels ? data.labels : [],
      datasets
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: datasets.length > 0, position: 'bottom' },
        title: {
          display: true,
          text: titleText
        }
      },
      scales: axisMeta
        ? {
            x: {
              type: 'linear',
              min: axisMeta.min,
              max: axisMeta.max,
              title: { display: true, text: 'Calendar position' },
              ticks: {
                callback: value => trendIsoDate(trendDateFromOffset(axisMeta.startDate, value))
              }
            },
            y: { beginAtZero: true }
          }
        : { y: { beginAtZero: true } }
    }
  });
}

function renderMerchantSummary() {
  const renderSeq = ++merchantRenderSeq;
  selectedMerchantId = document.getElementById('merchantSummarySelect').value || '';
  const cardFilters = merchantCardFilterParams();
  const grain = cardFilters.grain;
  const chartType = cardFilters.chartType;
  const summaryParams = {
    q: '',
    year: cardFilters.year,
    month: cardFilters.month,
    accountId: cardFilters.accountId,
    accountClass: cardFilters.accountClass,
    currency: cardFilters.currency,
    type: 'expense',
    status: cardFilters.status,
    categoryId: cardFilters.categoryId,
    from: cardFilters.from,
    to: cardFilters.to,
    limit: 500
  };
  fetch('/api/finance/search?' + qs(summaryParams), { headers: authHeaders() })
    .then(r => r.ok ? r.json() : null)
    .then(summaryData => {
      if (renderSeq !== merchantRenderSeq) return null;
      if (!summaryData) return null;
      const allRows = summaryData.merchantSummary || [];
      const rows = allRows.slice(0, 20);
      const selectedRow = selectedMerchantId
        ? rows.find(row => String(merchantRowKey(row)) === String(selectedMerchantId || '')) || null
        : null;
      if (selectedMerchantId && !selectedRow) selectedMerchantId = '';
      const totalAmount = allRows.reduce((sum, row) => sum + Number(row.amount || 0), 0);
      const totalCount = allRows.reduce((sum, row) => sum + Number(row.count || 0), 0);
      document.getElementById('merchantSummarySelect').innerHTML = '<option value="">All merchants</option>' + rows.map(merchantOptionHtml).join('');
      document.getElementById('merchantSummarySelect').value = selectedMerchantId || '';
      document.getElementById('merchantSummaryAmount').textContent = rows.length ? money(selectedRow ? selectedRow.amount : totalAmount) : money(0);
      document.getElementById('merchantSummaryCount').textContent = rows.length ? ((selectedRow ? selectedRow.count : totalCount) + ' tx') : '-';
      document.getElementById('merchantCategorySelect').value = selectedCategoryId || '';
      document.getElementById('merchantRankList').innerHTML = rows.length ? rows.map(row => (
        '<button class="rank-row merchant-rank-btn text-start merchant-jump ' + (String(merchantRowKey(row)) === String(selectedMerchantId || '') ? 'active' : '') + '" type="button" data-merchant="' + esc(merchantRowKey(row)) + '" data-name="' + esc(row.name) + '">' +
          '<span class="merchant-rank-main"><span class="fw-semibold text-truncate">' + esc(row.name) + '</span></span>' +
          '<span class="text-end">' + money(row.amount) + '</span>' +
          '<span class="small-muted text-end">' + esc(row.count) + ' tx</span>' +
        '</button>'
      )).join('') : '<div class="merchant-empty-state text-muted">No merchant activity for this filter.</div>';
      return { selectedRow, showAll: !selectedRow && rows.length > 0 };
    })
    .then(selection => {
      if (renderSeq !== merchantRenderSeq) return;
      if (selection === null) return;
      const selectedRow = selection.selectedRow;
      const showAll = selection.showAll;
      if (!selectedRow && !showAll) {
        if (merchantSpendChart) {
          merchantSpendChart.destroy();
          merchantSpendChart = null;
        }
        if (merchantActiveSpendChart) {
          merchantActiveSpendChart.destroy();
          merchantActiveSpendChart = null;
        }
        return;
      }
      const params = {
        page: null,
        limit: null,
        sort: null,
        dir: null,
        groupBy: selectedRow ? 'merchant' : 'total',
        grain,
        measure: 'expense',
        categoryId: cardFilters.categoryId,
        merchantKey: selectedRow ? merchantRowKey(selectedRow) : '',
        year: cardFilters.year,
        month: cardFilters.month,
        from: cardFilters.from,
        to: cardFilters.to,
        accountId: cardFilters.accountId,
        accountClass: cardFilters.accountClass,
        currency: cardFilters.currency
      };
      const activeParams = { ...params, calendar: 'active' };
      Promise.all([
        fetch('/api/finance/trends?' + qs(params), { headers: authHeaders() }).then(r => r.ok ? r.json() : null),
        fetch('/api/finance/trends?' + qs(activeParams), { headers: authHeaders() }).then(r => r.ok ? r.json() : null)
      ]).then(([rangeData, activeData]) => {
        if (renderSeq !== merchantRenderSeq) return;
        if (!rangeData || !activeData) return;
        merchantTrendData = rangeData;
        merchantActiveTrendData = activeData;
        if (merchantSpendChart) merchantSpendChart.destroy();
        if (merchantActiveSpendChart) merchantActiveSpendChart.destroy();
        const baseTitle = selectedRow ? selectedRow.name + ' expenditure' : 'Total expenditure';
        merchantSpendChart = renderMerchantTrendCanvas(
          'merchantSpendChart',
          rangeData,
          selectedRow,
          chartType,
          selectedRow ? (selectedRow.name + ' expenditure over time') : 'Total expenditure over time'
        );
        merchantActiveSpendChart = renderMerchantTrendCanvas(
          'merchantActiveSpendChart',
          activeData,
          selectedRow,
          chartType,
          baseTitle + ' on active dates only'
        );
        document.getElementById('merchantTrendGrain').value = grain;
        document.getElementById('merchantCategorySelect').value = selectedCategoryId || '';
      });
    });
}


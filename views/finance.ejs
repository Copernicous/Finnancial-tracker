<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Financial Workspace - Home Accounting</title>
  <link href="/assets/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/inter.css" rel="stylesheet">
  <link rel="stylesheet" href="/assets/fontawesome.all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .finance-shell { display: grid; gap: 1rem; }
    .filter-grid { display: grid; grid-template-columns: repeat(8, minmax(118px, 1fr)); gap: .75rem; align-items: end; }
    .kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .85rem; }
    .kpi-card { border: 1px solid var(--border,#e5e7eb); border-radius: 8px; background: var(--surface,#fff); padding: 1rem; min-height: 116px; }
    .kpi-card .kpi-icon { width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; background: var(--surface-2,#f1f5f9); color: var(--primary,#0d6efd); }
    .kpi-value { font-size: clamp(1.25rem, 2vw, 1.85rem); font-weight: 800; letter-spacing: 0; line-height: 1.15; }
    .finance-panel { border: 1px solid var(--border,#e5e7eb); border-radius: 8px; background: var(--surface,#fff); padding: 1rem; }
    .bar-track { height: 10px; border-radius: 999px; background: var(--surface-2,#eef2f7); overflow: hidden; }
    .bar-fill { height: 100%; border-radius: 999px; }
    .bar-income { background: #198754; }
    .bar-expense { background: #dc3545; }
    .bar-net { background: #0d6efd; }
    .bar-warning { background: #f59e0b; }
    .bar-row { display: grid; grid-template-columns: 72px minmax(160px, 1fr) 96px; gap: .65rem; align-items: center; margin-bottom: .65rem; }
    .stack-row { display: grid; grid-template-columns: minmax(140px, 1fr) 110px 82px; gap: .65rem; align-items: center; padding: .55rem 0; border-bottom: 1px solid var(--border,#e5e7eb); }
    .stack-row:last-child { border-bottom: 0; }
    .compact-table th { cursor: pointer; user-select: none; }
    .ledger-wrap { max-height: 460px; overflow: auto; max-width: 100%; }
    .finance-chart-frame { position: relative; height: 320px; min-height: 320px; }
    .finance-chart-frame.compact { height: 260px; min-height: 260px; }
    .category-chart-frame { height: 360px; min-height: 360px; }
    .split-layout > .finance-panel:last-child .finance-chart-frame.compact { height: 100%; min-height: 0; flex: 1 1 auto; }
    .rank-list { display: grid; gap: .55rem; }
    .rank-row { display: grid; grid-template-columns: minmax(130px, 1fr) 96px 72px; gap: .65rem; align-items: center; padding: .45rem 0; border-bottom: 1px solid var(--border,#e5e7eb); }
    .rank-row:last-child { border-bottom: 0; }
    .chart-toggle-group { display: inline-flex; gap: .35rem; flex-wrap: wrap; align-items: center; }
    .chart-toggle-group .form-check { margin: 0; min-height: auto; }
    .chart-toggle-group .form-check-label { font-size: .76rem; color: var(--text-muted,#64748b); }
    .status-dot { width: 8px; height: 8px; border-radius: 999px; display: inline-block; margin-right: .35rem; background: #94a3b8; }
    .status-dot.reviewed, .status-dot.reconciled { background: #198754; }
    .status-dot.draft { background: #f59e0b; }
    .status-dot.void { background: #dc3545; }
    .split-layout { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, .9fr); gap: 1rem; align-items: stretch; }
    .split-layout > .finance-panel { height: 100%; }
    .split-layout > .finance-panel:last-child { display: flex; flex-direction: column; }
    .merchant-summary-strip { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .75rem; }
    .merchant-summary-item { border: 1px solid rgba(148,163,184,.16); border-radius: 10px; padding: .75rem .85rem; background: rgba(15,23,42,.35); min-height: 68px; }
    .merchant-summary-item .fw-semibold { line-height: 1.15; }
    .merchant-summary-item .text-truncate { max-width: 100%; }
    .three-layout { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; align-items: start; }
    .small-muted { color: var(--text-muted,#64748b); font-size: .78rem; }
    @media (max-width: 1200px) {
      .filter-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .split-layout, .three-layout { grid-template-columns: 1fr; }
      .merchant-summary-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .split-layout > .finance-panel:last-child { display: block; }
    }
    @media (max-width: 640px) {
      .filter-grid, .kpi-grid { grid-template-columns: 1fr; }
      .bar-row, .stack-row { grid-template-columns: 1fr; gap: .25rem; }
      .split-layout, .three-layout { grid-template-columns: 1fr; }
      .merchant-summary-strip { grid-template-columns: 1fr; }
      .split-layout > .finance-panel:last-child { display: block; }
    }
  </style>
</head>
<body>
<div class="wrapper">
  <%- include('partials/sidebar') %>
  <div id="content">
    <nav class="navbar navbar-expand-lg px-4 mb-4">
      <button type="button" id="sidebarCollapse" class="btn btn-primary btn-sm"><i class="fas fa-bars"></i></button>
      <span class="ms-3 fw-bold fs-5">Financial Workspace</span>
      <div class="ms-auto d-flex align-items-center gap-2">
        <button id="themeToggle" class="btn btn-outline-secondary btn-sm" title="Toggle theme"><i class="fas fa-moon"></i></button>
        <span id="userGreeting" class="text-muted small"></span>
        <button id="logoutBtn" class="btn btn-danger btn-sm"><i class="fas fa-sign-out-alt me-1"></i>Logout</button>
      </div>
    </nav>

    <div class="container-fluid px-4 finance-shell">
      <section class="finance-panel">
        <div class="d-flex justify-content-between flex-wrap gap-3 mb-3">
          <div>
            <h5 class="mb-1">2026 Accounting Console</h5>
            <div class="small-muted">Account, currency, period, budget, and ledger selectors.</div>
          </div>
          <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-primary btn-sm d-none" id="seedBtn"><i class="fas fa-chart-line me-1"></i>Load Sample</button>
            <button class="btn btn-outline-danger btn-sm d-none" id="clearBtn"><i class="fas fa-trash-alt me-1"></i>Clear Sample</button>
            <button class="btn btn-outline-success btn-sm" id="exportBtn"><i class="fas fa-file-csv me-1"></i>Export</button>
            <button class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="fas fa-print me-1"></i>Print</button>
          </div>
        </div>
        <div class="filter-grid">
          <div>
            <label class="form-label">Year</label>
            <select id="yearFilter" class="form-select"><option value="2026">2026</option></select>
          </div>
          <div>
            <label class="form-label">Month</label>
            <select id="monthFilter" class="form-select">
              <option value="">All</option>
              <option value="1">Jan</option><option value="2">Feb</option><option value="3">Mar</option>
              <option value="4">Apr</option><option value="5">May</option><option value="6">Jun</option>
              <option value="7">Jul</option><option value="8">Aug</option><option value="9">Sep</option>
              <option value="10">Oct</option><option value="11">Nov</option><option value="12">Dec</option>
            </select>
          </div>
          <div>
            <label class="form-label">Account</label>
            <select id="accountFilter" class="form-select"><option value="">All accounts</option></select>
          </div>
          <div>
            <label class="form-label">Account Type</label>
            <select id="accountClassFilter" class="form-select">
              <option value="">All types</option>
              <option value="checking">Checking</option>
              <option value="savings">Savings</option>
              <option value="credit_card">Credit Card</option>
              <option value="investment">Investment</option>
              <option value="retirement">Retirement</option>
              <option value="cash">Cash</option>
              <option value="foreign_currency">Foreign Currency</option>
            </select>
          </div>
          <div>
            <label class="form-label">Currency</label>
            <select id="currencyFilter" class="form-select"><option value="USD">USD</option><option value="ALL">All</option><option value="COP">COP</option><option value="EUR">EUR</option></select>
          </div>
          <div>
            <label class="form-label">Search</label>
            <input id="searchFilter" class="form-control" placeholder="merchant, tag, memo">
          </div>
          <div class="d-flex gap-2">
            <button class="btn btn-primary flex-fill" id="runBtn"><i class="fas fa-search me-1"></i>Run</button>
            <button class="btn btn-outline-secondary" id="resetBtn" title="Reset filters"><i class="fas fa-undo"></i></button>
          </div>
        </div>
      </section>

      <section class="kpi-grid" id="kpiGrid"></section>

      <section class="finance-panel">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h5 class="mb-1">Explorer</h5>
            <div class="small-muted">Jump across all categories and merchants.</div>
          </div>
          <div class="d-flex gap-2 flex-wrap">
            <select id="explorerGrain" class="form-select form-select-sm" style="width:110px">
              <option value="month">Month</option>
              <option value="week">Week</option>
              <option value="day">Day</option>
              <option value="year">Year</option>
            </select>
            <select id="explorerType" class="form-select form-select-sm" style="width:110px">
              <option value="bar">Bars</option>
              <option value="line">Line</option>
              <option value="area">Area</option>
            </select>
          </div>
        </div>
        <div class="filter-grid">
          <div>
            <label class="form-label">Category</label>
            <select id="categoryExplorerSelect" class="form-select"></select>
          </div>
          <div>
            <label class="form-label">Merchant</label>
            <select id="merchantExplorerSelect" class="form-select"></select>
          </div>
          <div>
            <label class="form-label">From</label>
            <input id="explorerFrom" type="date" class="form-control">
          </div>
          <div>
            <label class="form-label">To</label>
            <input id="explorerTo" type="date" class="form-control">
          </div>
          <div class="d-flex align-items-end gap-2">
            <button id="explorerRunBtn" class="btn btn-primary flex-fill"><i class="fas fa-search me-1"></i>Show</button>
            <button id="explorerClearBtn" class="btn btn-outline-secondary" type="button"><i class="fas fa-undo"></i></button>
          </div>
        </div>
      </section>

      <section class="split-layout">
        <div class="finance-panel">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Trend Explorer</h5>
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <span class="small-muted" id="periodLabel">2026</span>
              <select id="trendGroup" class="form-select form-select-sm" style="width:132px">
                <option value="category">Category</option>
                <option value="merchant">Merchant</option>
                <option value="account">Account</option>
              </select>
              <select id="trendGrain" class="form-select form-select-sm" style="width:110px">
                <option value="month">Month</option>
                <option value="week">Week</option>
                <option value="day">Day</option>
              </select>
              <select id="trendMeasure" class="form-select form-select-sm" style="width:118px">
                <option value="expense">Expense</option>
                <option value="income">Income</option>
                <option value="transfer">Transfer</option>
                <option value="net">Net</option>
              </select>
              <select id="trendChartType" class="form-select form-select-sm" style="width:118px">
                <option value="bar">Bars</option>
                <option value="line">Curve</option>
                <option value="area">Area</option>
              </select>
              <button class="btn btn-outline-primary btn-sm" id="trendRefreshBtn"><i class="fas fa-sync-alt me-1"></i>Refresh</button>
            </div>
          </div>
          <div class="finance-chart-frame"><canvas id="monthlyCashFlowChart"></canvas></div>
        </div>
        <div class="finance-panel">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Spending by Category</h5>
            <span class="small-muted">Top categories</span>
          </div>
          <div class="split-layout">
            <div class="finance-chart-frame category-chart-frame"><canvas id="categorySpendChart"></canvas></div>
          </div>
        </div>
      </section>

      <section class="finance-panel">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h5 class="mb-1">Usage by Official Merchant</h5>
            <div class="small-muted">Canonical merchant names from aliases and import review.</div>
          </div>
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <select id="merchantTrendGrain" class="form-select form-select-sm" style="width:110px">
              <option value="month">Month</option>
              <option value="week">Week</option>
              <option value="day">Day</option>
              <option value="year">Year</option>
              <option value="custom">Custom</option>
            </select>
            <select id="merchantTrendType" class="form-select form-select-sm" style="width:116px">
              <option value="bar">Bars</option>
              <option value="line">Line</option>
              <option value="area">Area</option>
            </select>
            <a class="btn btn-outline-secondary btn-sm" href="/merchants"><i class="fas fa-store me-1"></i>Manage Merchants</a>
          </div>
        </div>
        <div class="merchant-summary-strip mb-3">
          <div class="merchant-summary-item">
            <div class="small-muted text-uppercase">Selected category</div>
            <div id="merchantCategoryName" class="fw-semibold text-truncate">All categories</div>
          </div>
          <div class="merchant-summary-item">
            <div class="small-muted text-uppercase">Selected merchant</div>
            <div id="merchantSummaryName" class="fw-semibold text-truncate">-</div>
          </div>
          <div class="merchant-summary-item">
            <div class="small-muted text-uppercase">Spend</div>
            <div id="merchantSummaryAmount" class="fw-semibold">-</div>
          </div>
          <div class="merchant-summary-item">
            <div class="small-muted text-uppercase">Transactions</div>
            <div id="merchantSummaryCount" class="fw-semibold">-</div>
          </div>
          <div class="merchant-summary-item">
            <div class="small-muted text-uppercase">Timeline</div>
            <div id="merchantSummaryGrain" class="fw-semibold">-</div>
          </div>
        </div>
        <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
          <label class="small-muted text-uppercase mb-0" for="merchantSubSelect">Merchant</label>
          <select id="merchantSubSelect" class="form-select form-select-sm" style="max-width:320px"></select>
        </div>
        <div class="split-layout">
          <div class="finance-chart-frame compact"><canvas id="merchantSpendChart"></canvas></div>
          <div id="merchantRankList" class="rank-list"></div>
        </div>
      </section>

      <section class="three-layout">
        <div class="finance-panel">
          <h5 class="mb-3">Accounts</h5>
          <div id="accountStack"></div>
        </div>
        <div class="finance-panel">
          <h5 class="mb-3">Budget Watch</h5>
          <div id="budgetWatch"></div>
        </div>
        <div class="finance-panel">
          <h5 class="mb-3">Goals</h5>
          <div id="goalList"></div>
        </div>
      </section>

      <section class="split-layout">
        <div class="finance-panel">
          <h5 class="mb-3">Recurring Calendar</h5>
          <div class="table-responsive">
            <table class="table table-sm align-middle">
              <thead><tr><th>Date</th><th>Name</th><th>Account</th><th>Type</th><th class="text-end">Amount</th></tr></thead>
              <tbody id="recurringRows"><tr><td colspan="5" class="text-muted">Loading...</td></tr></tbody>
            </table>
          </div>
        </div>
        <div class="finance-panel">
          <h5 class="mb-3">Investments</h5>
          <div id="investmentList"></div>
        </div>
      </section>

      <section class="finance-panel">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
          <div>
            <h5 class="mb-1">Transaction Search</h5>
            <div class="small-muted" id="searchCount">0 records</div>
          </div>
          <div class="d-flex flex-wrap gap-2">
            <select id="typeFilter" class="form-select form-select-sm" style="width:150px">
              <option value="">All types</option>
              <option value="income">Income</option>
              <option value="expense">Expense</option>
              <option value="transfer">Transfer</option>
              <option value="adjustment">Adjustment</option>
            </select>
            <select id="statusFilter" class="form-select form-select-sm" style="width:150px">
              <option value="">All status</option>
              <option value="draft">Draft</option>
              <option value="reviewed">Reviewed</option>
              <option value="reconciled">Reconciled</option>
              <option value="void">Void</option>
            </select>
            <input id="fromFilter" class="form-control form-control-sm" type="date" style="width:155px">
            <input id="toFilter" class="form-control form-control-sm" type="date" style="width:155px">
          </div>
        </div>
        <div class="ledger-wrap table-responsive">
          <table class="table table-hover align-middle compact-table">
            <thead>
              <tr>
                <th data-sort="transactionDate">Date</th>
                <th data-sort="accountName">Account</th>
                <th data-sort="categoryName">Category</th>
                <th data-sort="merchant">Merchant</th>
                <th data-sort="description">Description</th>
                <th data-sort="transactionType">Type</th>
                <th data-sort="amount" class="text-end">Amount</th>
                <th data-sort="status">Status</th>
              </tr>
            </thead>
            <tbody id="ledgerRows"><tr><td colspan="8" class="text-muted">Loading...</td></tr></tbody>
          </table>
        </div>
      </section>
    </div>
  </div>
</div>

<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100"></div>
<script src="/assets/bootstrap.bundle.min.js"></script>
<script src="/assets/chart.umd.min.js"></script>
<a id="xa-base" href="/login" style="display:none"></a>
<script src="/js/base.js"></script>
<script src="/js/main.js"></script>
<script>
let accounts = [];
let categories = [];
let overview = null;
let searchRows = [];
let searchSummary = { merchantSummary: [] };
let sortState = { key: 'transactionDate', dir: 'desc' };
let selectedCategoryId = '';
let selectedMerchantId = '';
let monthlyCashFlowChart = null;
let categorySpendChart = null;
let merchantSpendChart = null;
let trendChartData = null;
let merchantTrendData = null;
let explorerRows = [];

function authHeaders(json) {
  const token = localStorage.getItem('haToken') || localStorage.getItem('token') || '';
  const headers = token ? { Authorization: 'Bearer ' + token } : {};
  if (json) headers['Content-Type'] = 'application/json';
  return headers;
}
function esc(value) {
  return String(value == null ? '' : value).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
}
function money(value, currency) {
  const code = currency && currency !== 'ALL' ? currency : (document.getElementById('currencyFilter').value !== 'ALL' ? document.getElementById('currencyFilter').value : 'USD');
  return Number(value || 0).toLocaleString(undefined, { style: 'currency', currency: code, maximumFractionDigits: code === 'COP' ? 0 : 2 });
}
function numberFmt(value) {
  return Number(value || 0).toLocaleString(undefined, { maximumFractionDigits: 1 });
}
function toast(message, type) {
  if (typeof showToast === 'function') showToast(message, type || 'success');
}
function qs(params) {
  return Object.keys(params).filter(key => params[key] !== '' && params[key] != null).map(key => encodeURIComponent(key) + '=' + encodeURIComponent(params[key])).join('&');
}
function percentBar(value, colorClass) {
  const width = Math.max(0, Math.min(100, Number(value || 0)));
  return '<div class="bar-track"><div class="bar-fill ' + (colorClass || 'bar-net') + '" style="width:' + width + '%"></div></div>';
}
function maxAbs(rows, keys) {
  return Math.max(1, ...rows.flatMap(row => keys.map(key => Math.abs(Number(row[key] || 0)))));
}
function chartColor(index) {
  const colors = ['#0d6efd', '#198754', '#dc3545', '#f59e0b', '#14b8a6', '#7c3aed', '#0ea5e9', '#db2777', '#64748b', '#84cc16'];
  return colors[index % colors.length];
}
function buildMerchantSummary(rows) {
  const map = new Map();
  (rows || []).forEach(row => {
    const amount = Math.abs(Number(row.amount || 0));
    const name = row.merchant || row.receiptMerchant || row.normalizedMerchant || row.description || 'No merchant';
    const key = row.merchantId ? 'merchant:' + row.merchantId : name.toLowerCase();
    if (!map.has(key)) map.set(key, { merchantId: row.merchantId || null, name, amount: 0, count: 0 });
    const item = map.get(key);
    item.amount += amount;
    item.count += 1;
  });
  return Array.from(map.values()).sort((a, b) => b.amount - a.amount);
}

async function loadLookups() {
  const [accountRows, categoryRows] = await Promise.all([
    fetch('/api/accounts', { headers: authHeaders() }).then(r => r.ok ? r.json() : []),
    fetch('/api/categories', { headers: authHeaders() }).then(r => r.ok ? r.json() : [])
  ]);
  accounts = accountRows;
  categories = categoryRows;
  document.getElementById('accountFilter').innerHTML = '<option value="">All accounts</option>' + accounts.map(account => '<option value="' + account.id + '">' + esc(account.name) + '</option>').join('');
  document.getElementById('categoryExplorerSelect').innerHTML = '<option value="">All categories</option>' + categories.map(category => '<option value="' + category.id + '">' + esc(category.name) + '</option>').join('');
  document.getElementById('merchantExplorerSelect').innerHTML = '<option value="">All merchants</option>';
}

function filters() {
  const year = document.getElementById('yearFilter').value || '2026';
  const month = document.getElementById('monthFilter').value;
  return {
    year,
    month,
    accountId: document.getElementById('accountFilter').value,
    accountClass: document.getElementById('accountClassFilter').value,
    currency: document.getElementById('currencyFilter').value || 'USD'
  };
}

async function loadOverview() {
  const response = await fetch('/api/finance/overview?' + qs(filters()), { headers: authHeaders() });
  if (!response.ok) throw new Error('Overview failed');
  overview = await response.json();
  if (overview.filters && overview.filters.currencies) {
    const selected = document.getElementById('currencyFilter').value || 'ALL';
    document.getElementById('currencyFilter').innerHTML = '<option value="USD">USD</option><option value="ALL">All</option>' + overview.filters.currencies.filter(currency => currency !== 'USD').map(currency => '<option value="' + esc(currency) + '">' + esc(currency) + '</option>').join('');
    document.getElementById('currencyFilter').value = selected;
  }
  renderOverview();
}

async function loadSearch() {
  const f = filters();
  const params = {
    q: document.getElementById('searchFilter').value.trim(),
    accountId: f.accountId,
    currency: f.currency,
    type: document.getElementById('typeFilter').value,
    status: document.getElementById('statusFilter').value,
    categoryId: document.getElementById('categoryExplorerSelect').value || selectedCategoryId,
    merchantId: document.getElementById('merchantExplorerSelect').value || selectedMerchantId,
    from: document.getElementById('fromFilter').value,
    to: document.getElementById('toFilter').value,
    limit: 500
  };
  const response = await fetch('/api/finance/search?' + qs(params), { headers: authHeaders() });
  if (!response.ok) throw new Error('Search failed');
  const data = await response.json();
  searchRows = data.rows || [];
  searchSummary = { merchantSummary: data.merchantSummary || buildMerchantSummary(searchRows) };
  explorerRows = searchSummary.merchantSummary || [];
  const merchantExplorer = document.getElementById('merchantExplorerSelect');
  merchantExplorer.innerHTML = '<option value="">All merchants</option>' + explorerRows.map(row => '<option value="' + (row.merchantId || '') + '">' + esc(row.name) + '</option>').join('');
  if (selectedCategoryId && !selectedMerchantId && explorerRows.length) {
    selectedMerchantId = explorerRows[0].merchantId || '';
    merchantExplorer.value = selectedMerchantId;
  }
  if (selectedMerchantId) merchantExplorer.value = selectedMerchantId;
  document.getElementById('merchantSubSelect').innerHTML = '<option value="">Choose merchant...</option>' + explorerRows.map(row => '<option value="' + (row.merchantId || '') + '">' + esc(row.name) + '</option>').join('');
  document.getElementById('merchantSubSelect').value = selectedMerchantId || '';
  renderLedger();
  renderMerchantSummary();
}

function renderKpis(summary) {
  const cards = [
    ['Net Worth', summary.netWorth, 'fa-wallet', 'Includes eligible accounts and holdings'],
    ['Cash Flow', summary.cashFlow, 'fa-scale-balanced', 'Income less expenses'],
    ['Income', summary.income, 'fa-arrow-trend-up', 'Reviewed activity'],
    ['Expenses', summary.expenses, 'fa-arrow-trend-down', 'Spend categories'],
    ['Savings Rate', summary.savingsRatePct + '%', 'fa-piggy-bank', 'Cash flow over income', true],
    ['Credit Utilization', summary.creditUtilizationPct + '%', 'fa-credit-card', 'Current card use', true],
    ['Investments', summary.investmentValue, 'fa-chart-area', 'Market value'],
    ['Budget Used', summary.budgetUsagePct + '%', 'fa-clipboard-check', 'Actual over plan', true]
  ];
  document.getElementById('kpiGrid').innerHTML = cards.map(card => (
    '<div class="kpi-card">' +
      '<div class="d-flex justify-content-between align-items-start mb-3">' +
        '<div class="small-muted">' + esc(card[0]) + '</div>' +
        '<span class="kpi-icon"><i class="fas ' + card[2] + '"></i></span>' +
      '</div>' +
      '<div class="kpi-value">' + (card[4] ? esc(card[1]) : money(card[1])) + '</div>' +
      '<div class="small-muted mt-2">' + esc(card[3]) + '</div>' +
    '</div>'
  )).join('');
}

async function renderMonthly() {
  if (!overview) return;
  const selectedMonth = overview.filters && overview.filters.month ? Number(overview.filters.month) : null;
  const selectedYear = overview.filters ? overview.filters.year : '2026';
  const groupBy = document.getElementById('trendGroup').value;
  const grain = document.getElementById('trendGrain').value;
  const measure = document.getElementById('trendMeasure').value;
  const chartType = document.getElementById('trendChartType').value;
  document.getElementById('periodLabel').textContent = selectedYear + (overview.filters.month ? '-' + String(overview.filters.month).padStart(2, '0') : '');
  const response = await fetch('/api/finance/trends?' + qs({
    year: selectedYear,
    month: selectedMonth || '',
    accountId: document.getElementById('accountFilter').value,
    accountClass: document.getElementById('accountClassFilter').value,
    currency: document.getElementById('currencyFilter').value || 'USD',
    groupBy,
    grain,
    measure,
    top: 8
  }), { headers: authHeaders() });
  if (!response.ok) return;
  trendChartData = await response.json();
  const type = chartType === 'bar' ? 'bar' : 'line';
  const datasets = (trendChartData.series || []).map((serie, index) => ({
    label: serie.name,
    data: serie.values,
    borderColor: chartColor(index),
    backgroundColor: chartType === 'area' ? chartColor(index) + '22' : (type === 'line' ? chartColor(index) + '22' : chartColor(index) + 'bb'),
    borderWidth: 2,
    tension: chartType === 'bar' ? 0 : .4,
    fill: chartType !== 'bar',
    pointRadius: chartType === 'bar' ? 0 : 3
  }));
  if (monthlyCashFlowChart) monthlyCashFlowChart.destroy();
  monthlyCashFlowChart = new Chart(document.getElementById('monthlyCashFlowChart'), {
    type,
    data: { labels: trendChartData.labels || [], datasets },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { position: 'bottom' } },
      scales: { y: { beginAtZero: true } }
    }
  });
}

function renderCategories() {
  const rows = overview.categoryTotals || [];
  const chartRows = rows.slice(0, 12);
  if (categorySpendChart) categorySpendChart.destroy();
  categorySpendChart = new Chart(document.getElementById('categorySpendChart'), {
    type: 'bar',
    data: {
      labels: chartRows.map(row => row.name),
      datasets: [{
        label: 'Spending',
        data: chartRows.map(row => Number(row.amount || 0)),
        backgroundColor: chartRows.map((row, index) => chartColor(index) + 'bb'),
        borderColor: chartRows.map((row, index) => chartColor(index)),
        borderWidth: 1
      }]
    },
    options: {
      indexAxis: 'y',
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: { x: { beginAtZero: true } }
    }
  });
}

function renderMerchantSummary() {
  const rows = (searchSummary.merchantSummary || []).slice(0, 10);
  const grain = document.getElementById('merchantTrendGrain').value || 'month';
  const chartType = document.getElementById('merchantTrendType').value || 'bar';
  if (!selectedMerchantId && rows.length) selectedMerchantId = rows[0].merchantId || '';
  const selectedRow = rows.find(row => String(row.merchantId || '') === String(selectedMerchantId || '')) || rows[0] || null;
  const categoryRow = (overview.categoryTotals || []).find(row => String(row.categoryId || '') === String(selectedCategoryId || ''));
  const merchantSelect = document.getElementById('merchantSubSelect');
  merchantSelect.innerHTML = rows.length ? '<option value="">Choose merchant...</option>' + rows.map(row => '<option value="' + (row.merchantId || '') + '">' + esc(row.name) + '</option>').join('') : '<option value="">No merchants</option>';
  merchantSelect.value = selectedMerchantId || '';
  const f = filters();
  const params = {
    page: null,
    limit: null,
    sort: null,
    dir: null,
    groupBy: 'merchant',
    grain: grain === 'custom' ? 'month' : grain,
    measure: 'expense',
    from: grain === 'custom' ? document.getElementById('fromFilter').value : '',
    to: grain === 'custom' ? document.getElementById('toFilter').value : '',
    accountId: f.accountId,
    accountClass: f.accountClass,
    currency: f.currency
  };
  fetch('/api/finance/trends?' + qs(params), { headers: authHeaders() })
    .then(r => r.ok ? r.json() : null)
    .then(data => {
      if (!data) return;
      merchantTrendData = data;
      if (merchantSpendChart) merchantSpendChart.destroy();
      const seriesList = Array.isArray(data.series) ? data.series : [];
      const targetName = selectedRow ? selectedRow.name : '';
      const targetKey = String(selectedRow && selectedRow.merchantId ? selectedRow.merchantId : '');
      const chosen = seriesList.find(serie => String(serie.key || '').includes(targetKey) || String(serie.name || '') === String(targetName || '')) || seriesList[0] || null;
      const datasets = chosen ? [{
        label: chosen.name || 'Merchant',
        data: chosen.values || [],
        borderColor: chartColor(0),
        backgroundColor: chartType === 'area' ? chartColor(0) + '22' : (chartType === 'line' ? chartColor(0) + '22' : chartColor(0) + 'bb'),
        borderWidth: 2,
        tension: chartType === 'bar' ? 0 : .35,
        fill: chartType !== 'bar',
        pointRadius: chartType === 'bar' ? 0 : 3
      }] : [];
      const type = chartType === 'bar' ? 'bar' : 'line';
      const canvas = document.getElementById('merchantSpendChart');
      merchantSpendChart = new Chart(document.getElementById('merchantSpendChart'), {
        type,
        data: {
          labels: data.labels || [],
          datasets
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: !!chosen, position: 'bottom' },
            title: {
              display: !!selectedRow,
              text: selectedRow ? (selectedRow.name + ' over time') : 'Select a merchant'
            }
          },
          scales: chartType === 'bar'
            ? { y: { beginAtZero: true } }
            : { y: { beginAtZero: true } }
        }
      });
      document.getElementById('merchantSummaryName').textContent = selectedRow ? selectedRow.name : 'All merchants';
      document.getElementById('merchantSummaryAmount').textContent = selectedRow ? money(selectedRow.amount) : money(0);
      document.getElementById('merchantSummaryCount').textContent = selectedRow ? (selectedRow.count + ' tx') : '-';
      document.getElementById('merchantSummaryGrain').textContent = grain.charAt(0).toUpperCase() + grain.slice(1);
      document.getElementById('merchantCategoryName').textContent = categoryRow ? categoryRow.name : 'All categories';
    });
  document.getElementById('merchantRankList').innerHTML = rows.length ? rows.map(row => (
    '<button class="rank-row btn btn-link text-start p-0 merchant-jump ' + (String(row.merchantId || '') === String(selectedMerchantId || '') ? 'active' : '') + '" type="button" data-merchant="' + (row.merchantId || '') + '" data-name="' + esc(row.name) + '">' +
      '<span class="fw-semibold text-truncate">' + esc(row.name) + '</span>' +
      '<span class="text-end">' + money(row.amount) + '</span>' +
      '<span class="small-muted text-end">' + esc(row.count) + ' tx</span>' +
    '</button>'
  )).join('') : '<div class="text-muted">No merchant activity for this filter.</div>';
}

function renderAccounts() {
  const rows = overview.accountTotals || [];
  document.getElementById('accountStack').innerHTML = rows.length ? rows.map(account => (
    '<div class="stack-row">' +
      '<div><div class="fw-semibold">' + esc(account.name) + '</div><div class="small-muted">' + esc(account.accountClass || '') + (account.accountSubtype ? ' - ' + esc(account.accountSubtype) : '') + '</div></div>' +
      '<div class="text-end fw-semibold">' + money(account.balance, account.currency) + '</div>' +
      '<div class="text-end small-muted">' + esc(account.status || '') + '</div>' +
    '</div>'
  )).join('') : '<div class="text-muted">No accounts match the filter.</div>';
}

function renderBudgets() {
  const rows = overview.budgets || [];
  document.getElementById('budgetWatch').innerHTML = rows.length ? rows.map(row => {
    const warn = row.usagePct >= row.alertThresholdPct;
    return '<div class="mb-3">' +
      '<div class="d-flex justify-content-between gap-2 mb-1"><span class="fw-semibold">' + esc(row.name) + '</span><span class="' + (warn ? 'text-danger' : '') + '">' + esc(row.usagePct) + '%</span></div>' +
      percentBar(row.usagePct, warn ? 'bar-expense' : 'bar-net') +
      '<div class="small-muted mt-1">' + money(row.actualAmount, row.currency) + ' of ' + money(row.plannedAmount, row.currency) + '</div>' +
    '</div>';
  }).join('') : '<div class="text-muted">No active budgets for this filter.</div>';
}

function renderGoals() {
  const rows = overview.goals || [];
  document.getElementById('goalList').innerHTML = rows.length ? rows.map(goal => (
    '<div class="mb-3">' +
      '<div class="d-flex justify-content-between gap-2 mb-1"><span class="fw-semibold">' + esc(goal.name) + '</span><span>' + esc(goal.progressPct) + '%</span></div>' +
      percentBar(goal.progressPct, goal.progressPct >= 100 ? 'bar-income' : 'bar-net') +
      '<div class="small-muted mt-1">' + money(goal.currentAmount, goal.currency) + ' of ' + money(goal.targetAmount, goal.currency) + (goal.targetDate ? ' by ' + esc(goal.targetDate) : '') + '</div>' +
    '</div>'
  )).join('') : '<div class="text-muted">No goals for this filter.</div>';
}

function renderRecurring() {
  const rows = overview.recurring || [];
  document.getElementById('recurringRows').innerHTML = rows.length ? rows.slice(0, 12).map(row => (
    '<tr><td>' + esc(row.nextDate) + '</td><td>' + esc(row.name) + '</td><td>' + esc(row.accountName) + '</td><td>' + esc(row.transactionType) + '</td><td class="text-end">' + money(row.amount, row.currency) + '</td></tr>'
  )).join('') : '<tr><td colspan="5" class="text-muted">No recurring items.</td></tr>';
}

function renderInvestments() {
  const rows = overview.holdings || [];
  document.getElementById('investmentList').innerHTML = rows.length ? rows.map(row => (
    '<div class="stack-row">' +
      '<div><div class="fw-semibold">' + esc(row.symbol) + ' ' + esc(row.name || '') + '</div><div class="small-muted">' + esc(row.assetClass) + ' - ' + esc(row.accountName) + '</div></div>' +
      '<div class="text-end fw-semibold">' + money(row.marketValue, row.currency) + '</div>' +
      '<div class="text-end ' + (row.unrealizedGain >= 0 ? 'text-success' : 'text-danger') + '">' + money(row.unrealizedGain, row.currency) + '</div>' +
    '</div>'
  )).join('') : '<div class="text-muted">No investment holdings.</div>';
}

function renderOverview() {
  renderKpis(overview.summary || {});
  renderMonthly();
  renderCategories();
  renderAccounts();
  renderBudgets();
  renderGoals();
  renderRecurring();
  renderInvestments();
}

function renderLedger() {
  const key = sortState.key;
  const dir = sortState.dir === 'asc' ? 1 : -1;
  const sorted = searchRows.slice().sort((a, b) => {
    const av = a[key];
    const bv = b[key];
    if (key === 'amount') return (Number(av || 0) - Number(bv || 0)) * dir;
    return String(av || '').localeCompare(String(bv || '')) * dir;
  });
  document.getElementById('searchCount').textContent = sorted.length + ' records';
  document.getElementById('ledgerRows').innerHTML = sorted.length ? sorted.map(row => (
    '<tr>' +
      '<td>' + esc(row.transactionDate) + '</td>' +
      '<td>' + esc(row.accountName) + '</td>' +
      '<td>' + esc(row.categoryName) + '</td>' +
      '<td>' + esc(row.merchant || '') + '<div class="small-muted">' + esc(row.receiptMerchant && row.receiptMerchant !== row.merchant ? row.receiptMerchant : '') + '</div></td>' +
      '<td>' + esc(row.description) + '<div class="small-muted">' + esc(row.tags || '') + '</div></td>' +
      '<td>' + esc(row.transactionType) + '</td>' +
      '<td class="text-end fw-semibold">' + money(row.amount, row.currency) + '</td>' +
      '<td><span class="status-dot ' + esc(row.status) + '"></span>' + esc(row.status) + '</td>' +
    '</tr>'
  )).join('') : '<tr><td colspan="8" class="text-muted">No transactions match this search.</td></tr>';
}

async function loadAll() {
  try {
    await loadOverview();
    await loadSearch();
  } catch (err) {
    toast('Unable to load financial workspace.', 'danger');
  }
}

async function seedSimulation() {
  const res = await fetch('/api/simulation/seed', { method: 'POST', headers: authHeaders(true) });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) return toast(data.message || data.error || 'Unable to load sample data.', 'danger');
  toast('Sample data loaded: ' + data.created + ' transactions.');
  await loadLookups();
  await loadAll();
}

async function clearSimulation() {
  if (!confirm('Clear all sample simulation accounting data?')) return;
  const res = await fetch('/api/simulation', { method: 'DELETE', headers: authHeaders() });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) return toast(data.message || data.error || 'Unable to clear sample data.', 'danger');
  toast('Sample data cleared.');
  await loadLookups();
  await loadAll();
}

function exportCsv() {
  const headers = ['Date', 'Account', 'Category', 'Merchant', 'Receipt Merchant', 'Description', 'Type', 'Amount', 'Currency', 'Status', 'Tags'];
  const lines = [headers].concat(searchRows.map(row => [
    row.transactionDate, row.accountName, row.categoryName, row.merchant || '', row.receiptMerchant || '', row.description,
    row.transactionType, row.amount, row.currency, row.status, row.tags || ''
  ]));
  const csv = lines.map(row => row.map(cell => typeof sanitizeCsvCell === 'function' ? sanitizeCsvCell(cell) : '"' + String(cell == null ? '' : cell).replace(/"/g, '""') + '"').join(',')).join('\n');
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }));
  a.download = 'home_accounting_financial_workspace_2026.csv';
  a.click();
  URL.revokeObjectURL(a.href);
}

document.querySelectorAll('th[data-sort]').forEach(th => {
  th.addEventListener('click', () => {
    const key = th.getAttribute('data-sort');
    sortState = { key, dir: sortState.key === key && sortState.dir === 'desc' ? 'asc' : 'desc' };
    renderLedger();
  });
});
document.getElementById('runBtn').addEventListener('click', loadAll);
document.getElementById('resetBtn').addEventListener('click', () => {
  document.getElementById('monthFilter').value = '';
  document.getElementById('accountFilter').value = '';
  document.getElementById('accountClassFilter').value = '';
  document.getElementById('currencyFilter').value = 'USD';
  document.getElementById('searchFilter').value = '';
  document.getElementById('typeFilter').value = '';
  document.getElementById('statusFilter').value = '';
  document.getElementById('fromFilter').value = '';
  document.getElementById('toFilter').value = '';
  selectedCategoryId = '';
  selectedMerchantId = '';
  loadAll();
});
['monthFilter', 'accountFilter', 'accountClassFilter', 'currencyFilter', 'typeFilter', 'statusFilter', 'fromFilter', 'toFilter'].forEach(id => {
  document.getElementById(id).addEventListener('change', loadAll);
});
['trendGroup', 'trendGrain', 'trendMeasure', 'trendChartType'].forEach(id => {
  document.getElementById(id).addEventListener('change', () => renderMonthly());
});
['merchantTrendGrain', 'merchantTrendType'].forEach(id => {
  document.getElementById(id).addEventListener('change', () => renderMerchantSummary());
});
['explorerGrain', 'explorerType'].forEach(id => {
  document.getElementById(id).addEventListener('change', () => renderMonthly());
});
document.getElementById('categoryExplorerSelect').addEventListener('change', () => {
  selectedCategoryId = document.getElementById('categoryExplorerSelect').value || '';
  selectedMerchantId = '';
  document.getElementById('merchantExplorerSelect').value = '';
  document.getElementById('merchantSubSelect').value = '';
  loadSearch();
  renderMonthly();
});
document.getElementById('merchantExplorerSelect').addEventListener('change', () => {
  selectedMerchantId = document.getElementById('merchantExplorerSelect').value || '';
  loadSearch();
  renderMonthly();
});
document.getElementById('merchantSubSelect').addEventListener('change', () => {
  selectedMerchantId = document.getElementById('merchantSubSelect').value || '';
  document.getElementById('merchantExplorerSelect').value = selectedMerchantId;
  loadSearch();
  renderMonthly();
});
document.getElementById('explorerRunBtn').addEventListener('click', () => {
  document.getElementById('fromFilter').value = document.getElementById('explorerFrom').value;
  document.getElementById('toFilter').value = document.getElementById('explorerTo').value;
  document.getElementById('merchantTrendGrain').value = document.getElementById('explorerGrain').value;
  document.getElementById('merchantTrendType').value = document.getElementById('explorerType').value;
  loadSearch();
  renderMonthly();
});
document.getElementById('explorerClearBtn').addEventListener('click', () => {
  document.getElementById('categoryExplorerSelect').value = '';
  document.getElementById('merchantExplorerSelect').value = '';
  document.getElementById('explorerFrom').value = '';
  document.getElementById('explorerTo').value = '';
  selectedCategoryId = '';
  selectedMerchantId = '';
  loadSearch();
  renderMonthly();
});
document.getElementById('trendRefreshBtn').addEventListener('click', () => renderMonthly());
document.getElementById('searchFilter').addEventListener('keydown', event => {
  if (event.key === 'Enter') loadAll();
});
document.getElementById('seedBtn').addEventListener('click', seedSimulation);
document.getElementById('clearBtn').addEventListener('click', clearSimulation);
document.getElementById('exportBtn').addEventListener('click', exportCsv);
document.getElementById('categorySpendChart').addEventListener('click', event => {
  if (!categorySpendChart) return;
  const points = categorySpendChart.getElementsAtEventForMode(event, 'nearest', { intersect: true }, true);
  if (!points.length) return;
  const index = points[0].index;
  const row = (overview.categoryTotals || [])[index];
  if (!row) return;
  selectedCategoryId = row.categoryId || '';
  selectedMerchantId = '';
  document.getElementById('merchantExplorerSelect').value = '';
  document.getElementById('merchantSubSelect').value = '';
  document.getElementById('trendGroup').value = 'category';
  document.getElementById('trendMeasure').value = 'expense';
  document.getElementById('searchFilter').value = row.name || '';
  loadSearch();
  renderMonthly();
});
document.getElementById('merchantRankList').addEventListener('click', event => {
  const btn = event.target.closest('.merchant-jump');
  if (!btn) return;
  selectedMerchantId = btn.dataset.merchant || '';
  selectedCategoryId = '';
  document.getElementById('trendGroup').value = 'merchant';
  document.getElementById('trendMeasure').value = 'expense';
  if (!selectedMerchantId && btn.dataset.name) document.getElementById('searchFilter').value = btn.dataset.name;
  loadSearch();
  renderMonthly();
});
document.addEventListener('DOMContentLoaded', async function() {
  await loadLookups();
  await loadAll();
});
</script>
</body>
</html>

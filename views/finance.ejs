function renderKpiDetailSummary(data) {
  const s = data.summary || {};
  const chips = [];
  if (data.detailType === 'transactions') {
    if (data.metric === 'income') chips.push(detailChip('Income', s.income || 0, true));
    if (data.metric === 'expenses') chips.push(detailChip('Expenses', s.expenses || 0, true));
    if (data.metric === 'transfers') chips.push(detailChip('Transfers', s.transfers || 0, true));
    if (data.metric === 'cashFlow' || data.metric === 'savingsRate') {
      chips.push(detailChip('Income', s.income || 0, true));
      chips.push(detailChip('Expenses', s.expenses || 0, true));
      chips.push(detailChip('Cash Flow', s.cashFlow || 0, true));
    }
    if (data.metric === 'savingsRate') chips.push(detailChip('Savings Rate', (s.savingsRatePct || 0) + '%', false));
    chips.push(detailChip('Rows', Number(s.rowCount || 0).toLocaleString(), false));
    if (s.returnedRowCount != null && Number(s.returnedRowCount) !== Number(s.rowCount || 0)) {
      chips.push(detailChip('Visible', Number(s.returnedRowCount || 0).toLocaleString(), false));
    }
    chips.push(detailChip('Source Files', Number(s.sourceFileCount || 0).toLocaleString(), false));
  } else if (data.detailType === 'accounts') {
    chips.push(detailChip(data.metric === 'netWorth' ? 'Net Worth' : 'Credit Utilization', data.metric === 'netWorth' ? (s.total || 0) : ((s.total || 0) + '%'), data.metric === 'netWorth'));
    if (data.metric !== 'netWorth') {
      chips.push(detailChip('Credit Used', s.creditUsed || 0, true));
      chips.push(detailChip('Credit Limit', s.creditLimit || 0, true));
    }
    chips.push(detailChip('Accounts', Number(s.rowCount || 0).toLocaleString(), false));
  } else if (data.detailType === 'holdings') {
    chips.push(detailChip('Market Value', s.total || 0, true));
    chips.push(detailChip('Holdings', Number(s.rowCount || 0).toLocaleString(), false));
  } else if (data.detailType === 'budgets') {
    chips.push(detailChip('Budget Used', (s.total || 0) + '%', false));
    chips.push(detailChip('Planned', s.plannedTotal || 0, true));
    chips.push(detailChip('Actual', s.actualTotal || 0, true));
    chips.push(detailChip('Budget Rows', Number(s.rowCount || 0).toLocaleString(), false));
  }
  document.getElementById('kpiDetailSummary').innerHTML = chips.join('');
}


<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Who's Online - Home Accounting</title>
  <link href="/assets/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/inter.css" rel="stylesheet">
  <link rel="stylesheet" href="/assets/fontawesome.all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="wrapper">
  <%- include('partials/sidebar') %>
  <div id="content">
    <nav class="navbar navbar-expand-lg px-4 mb-4">
      <button type="button" id="sidebarCollapse" class="btn btn-primary btn-sm"><i class="fas fa-bars"></i></button>
      <span class="ms-3 fw-bold fs-5">Who's Online</span>
      <div class="ms-auto d-flex align-items-center gap-3">
        <span id="userGreeting" class="text-muted small"></span>
        <button id="logoutBtn" class="btn btn-danger btn-sm"><i class="fas fa-sign-out-alt me-1"></i>Logout</button>
      </div>
    </nav>

    <div class="container-fluid px-4">
      <div class="glass-card p-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
          <div>
            <h5 class="mb-1">Active Sessions</h5>
            <div class="text-muted small">Users seen in the accounting workspace during the last 15 minutes.</div>
          </div>
          <button class="btn btn-outline-primary btn-sm" onclick="loadSessions()"><i class="fas fa-sync-alt me-1"></i>Refresh</button>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead><tr><th>User</th><th>Role</th><th>Current Page</th><th>Last Seen</th><th>Idle</th><th>IP</th></tr></thead>
            <tbody id="sessionsBody"><tr><td colspan="6" class="text-muted">Loading...</td></tr></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="/assets/bootstrap.bundle.min.js"></script>
<a id="xa-base" href="/login" style="display:none"></a>
<script src="/js/base.js"></script>
<script src="/js/main.js"></script>
<script>
function authHeaders() {
  const token = localStorage.getItem('haToken') || localStorage.getItem('token') || '';
  return token ? { Authorization: 'Bearer ' + token } : {};
}
function esc(value) {
  return String(value == null ? '' : value).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
}
function idle(ms) {
  const minutes = Math.floor((ms || 0) / 60000);
  if (minutes < 1) return 'Now';
  return minutes + ' min';
}
async function loadSessions() {
  const body = document.getElementById('sessionsBody');
  body.innerHTML = '<tr><td colspan="6" class="text-muted">Loading...</td></tr>';
  const res = await fetch('/api/active-sessions', { headers: authHeaders() });
  if (!res.ok) {
    body.innerHTML = '<tr><td colspan="6" class="text-danger">Unable to load active users.</td></tr>';
    return;
  }
  const rows = await res.json();
  if (!rows.length) {
    body.innerHTML = '<tr><td colspan="6" class="text-muted">No active sessions yet.</td></tr>';
    return;
  }
  body.innerHTML = rows.map(row => {
    const name = ((row.firstName || '') + ' ' + (row.lastName || '')).trim() || row.username;
    return '<tr><td><strong>' + esc(name) + '</strong><br><small class="text-muted">@' + esc(row.username) + '</small></td><td>' + esc(row.role) + '</td><td>' + esc(row.currentPage || row.currentUrl) + '</td><td>' + esc(new Date(row.lastSeen).toLocaleString()) + '</td><td>' + esc(idle(row.idleMs)) + '</td><td>' + esc(row.ip) + '</td></tr>';
  }).join('');
}
document.addEventListener('DOMContentLoaded', function() {
  loadSessions();
  setInterval(loadSessions, 30000);
});
</script>
</body>
</html>

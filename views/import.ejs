  applyReviewFilters();
});
document.querySelectorAll('[data-review-sort]').forEach(btn => btn.addEventListener('click', () => {
  const key = btn.dataset.reviewSort;
  reviewSort.direction = reviewSort.key === key && reviewSort.direction === 'asc' ? 'desc' : 'asc';
  reviewSort.key = key;
  sortReviewRows();
}));

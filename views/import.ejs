  if (!res.ok) return reviewMessage(data.error || data.message || 'Unable to save reviewed rows.', 'danger');
  reviewMessage(data.updated + ' row(s) saved for review.', 'success');
  await openBatch(selectedBatchId);
  await loadBatches();
}
async function postSelectedRows() {
  if (!selectedBatchId) return;
  const rows = collectReviewRows(true);
  if (!rows.length) return reviewMessage('Select at least one postable row.', 'warning');
  const res = await fetch('/api/import/batches/' + selectedBatchId + '/post', {
    method: 'POST',
    headers: authHeaders(true),
    body: JSON.stringify({
      rows,
      accountId: document.getElementById('reviewDefaultAccount').value || null,
      categoryId: document.getElementById('reviewDefaultCategory').value || null,
      transactionStatus: document.getElementById('reviewDefaultStatus').value || 'draft'
    })
  });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) {
    reviewMessage(data.error || data.message || 'Unable to post selected rows.', 'danger');
    if (data.existingBatchId) openBatch(data.existingBatchId);
    return;
  }
  reviewMessage(data.message + (data.duplicates ? ' Duplicates skipped: ' + data.duplicates + '.' : '') + (data.errors && data.errors.length ? ' Rows needing fixes: ' + data.errors.length + '.' : ''), data.errors && data.errors.length ? 'warning' : 'success');
  await openBatch(selectedBatchId);
  await loadBatches();
}
function applyReviewDefaults() {
  const defaultAccount = document.getElementById('reviewDefaultAccount').value;
  const defaultCategory = document.getElementById('reviewDefaultCategory').value;
  document.querySelectorAll('#reviewRows tr[data-row-id]').forEach(tr => {
    if (tr.classList.contains('d-none')) return;
    const checkbox = tr.querySelector('.review-check');
    if (!checkbox || checkbox.disabled) return;
    if (defaultAccount) tr.querySelector('.review-account').value = defaultAccount;
    if (defaultCategory) tr.querySelector('.review-category').value = defaultCategory;
    const status = tr.querySelector('.review-row-status');
    if (status.value === 'staged' || status.value === 'error') status.value = 'ready';
  });
  applyReviewFilters();
}
async function requestMerchantSuggestion(draft, onlineLookup) {
  const res = await fetch('/api/import/merchant-suggest', {
    method: 'POST',
    headers: authHeaders(true),
    body: JSON.stringify({
      merchant: draft.merchant || draft.description,
      description: draft.description,
      transactionType: draft.transactionType,
      onlineLookup: !!onlineLookup
    })
  });
  if (!res.ok) return null;
  const data = await res.json().catch(() => ({}));
  return data;
}
function applySuggestionToRow(tr, suggestion) {
  if (!suggestion || !suggestion.categoryId) return false;
  tr.querySelector('.review-category').value = String(suggestion.categoryId);
  if (suggestion.transactionType) tr.querySelector('.review-type').value = suggestion.transactionType;
  const status = tr.querySelector('.review-row-status');
  if (status.value === 'staged' || status.value === 'error') status.value = 'ready';
  const checkbox = tr.querySelector('.review-check');
  if (checkbox && !checkbox.disabled) checkbox.checked = true;
  return true;
}
function suggestionSourceLabel(source) {
  if (source === 'category_keygroup') return 'category keyword';
  if (source === 'online_lookup') return 'online lookup';
  if (source === 'user') return 'learned rule';
  if (source === 'default') return 'default rule';
  return source || 'rule';
}
function setRowLookupNote(tr, data, onlineLookup) {
  const rowId = tr.dataset.rowId;
  const suggestion = data && data.suggestion;
  const source = suggestion ? suggestionSourceLabel(suggestion.source) : (onlineLookup ? 'online checked' : 'no match');
  const sourceUrl = data && data.lookupSources && data.lookupSources.length ? data.lookupSources[0].url : '';
  rowLookupDetails[rowId] = {
    title: (tr.querySelector('.review-merchant') ? tr.querySelector('.review-merchant').value : '') || 'Lookup Detail',
    category: suggestion ? suggestion.categoryName : '',
    source,
    pattern: suggestion && suggestion.matchedPattern ? suggestion.matchedPattern : '',
    query: data && data.lookupQuery ? data.lookupQuery : '',
    summary: data && data.lookupSummary ? data.lookupSummary : '',
    error: data && data.lookupError ? data.lookupError : '',
    url: sourceUrl,
    cached: !!(data && data.lookupCached)
  };
  const label = suggestion ? suggestion.categoryName : (data && data.lookupError ? 'Lookup limited' : 'No match');
  const badgeClass = suggestion ? 'text-bg-success' : (data && data.lookupError ? 'text-bg-warning' : 'text-bg-secondary');
  const hasDetail = !!(rowLookupDetails[rowId].summary || rowLookupDetails[rowId].query || rowLookupDetails[rowId].error || rowLookupDetails[rowId].url);
  const html = '<div class="lookup-compact">' +
    '<span class="badge ' + badgeClass + ' lookup-label">' + esc(label) + '</span>' +
    (hasDetail ? '<button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" onclick="showLookupDetail(' + Number(rowId) + ')">Details</button>' : '') +
    '</div><div class="small text-muted">' + esc(source) + (suggestion && suggestion.matchedPattern ? ' / ' + esc(suggestion.matchedPattern) : '') + '</div>';
  rowLookupNotes[rowId] = html;
  const note = tr.querySelector('.review-note');
  if (note) note.innerHTML = html;
}
async function suggestReviewCategories(onlineLookup) {
  const defaultAccount = document.getElementById('reviewDefaultAccount').value || singleActiveAccountId();
  let suggested = 0;
  let accountFilled = 0;
  let lookedUp = 0;
  let emptyLookup = 0;
  let lookupErrors = 0;
  let localFallbacks = 0;
  const matchExamples = [];
  const rows = Array.from(document.querySelectorAll('#reviewRows tr[data-row-id]'));
  const visiblePostableRows = rows.filter(tr => {
    const checkbox = tr.querySelector('.review-check');
    return checkbox && !checkbox.disabled && !tr.classList.contains('d-none');
  });
  const checkedRows = visiblePostableRows.filter(tr => {
    const checkbox = tr.querySelector('.review-check');
    return checkbox && checkbox.checked;
  });
  const targetRows = onlineLookup
    ? (checkedRows.length ? checkedRows : visiblePostableRows.filter(tr => !(tr.querySelector('.review-category') || {}).value))
    : visiblePostableRows;
  if (onlineLookup && !targetRows.length) {
    return reviewMessage('Select rows or filter to visible rows with missing categories before running online lookup.', 'warning');
  }
  const button = document.getElementById(onlineLookup ? 'lookupOnlineBtn' : 'suggestCategoriesBtn');
  const originalButtonHtml = button.innerHTML;
  button.disabled = true;
  button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>' + (onlineLookup ? 'Looking Up' : 'Suggesting');
  reviewMessage((onlineLookup ? 'Looking up selected merchants online...' : 'Suggesting categories from merchant index...'), 'info');
  try {
    for (const tr of targetRows) {
      const original = batchRows.find(row => Number(row.id) === Number(tr.dataset.rowId)) || {};
      const draft = {
        ...rowDraft(original),
        description: tr.querySelector('.review-description').value,
        merchant: tr.querySelector('.review-merchant').value,
        transactionType: tr.querySelector('.review-type').value
      };
      const accountSelect = tr.querySelector('.review-account');
      if (!accountSelect.value && defaultAccount) {
        accountSelect.value = defaultAccount;
        accountFilled += 1;
      }
      const data = await requestMerchantSuggestion(draft, onlineLookup);
      if (!data) continue;
      if (onlineLookup) {
        lookedUp += 1;
        if (data.lookupError) lookupErrors += 1;
        if (!data.lookupSummary && !data.lookupError) emptyLookup += 1;
        if (!data.onlineSuggestion && data.localSuggestion) localFallbacks += 1;
      }
      setRowLookupNote(tr, data, onlineLookup);
      if (applySuggestionToRow(tr, data.suggestion)) {
        suggested += 1;
        if (data.suggestion && matchExamples.length < 5) {
          matchExamples.push((draft.merchant || draft.description || 'row') + ' -> ' + data.suggestion.categoryName + ' (' + suggestionSourceLabel(data.suggestion.source) + ')');
        }
      }
    }
  } catch (err) {
    reviewMessage(err.message || 'Unable to complete category lookup.', 'danger');
    return;
  } finally {
    button.disabled = false;
    button.innerHTML = originalButtonHtml;
  }
  if (onlineLookup) {
    applyReviewFilters();
    reviewMessage(
      'Online lookup checked ' + lookedUp + ' row(s) and applied ' + suggested + ' categorization(s).' +
        (matchExamples.length ? ' Matches: ' + matchExamples.join('; ') + '.' : '') +
        (localFallbacks ? ' Local rules filled ' + localFallbacks + ' row(s) when public lookup did not improve the match.' : '') +
        (emptyLookup ? ' No public lookup text returned for ' + emptyLookup + ' row(s).' : '') +
        (lookupErrors ? ' Lookup errors: ' + lookupErrors + '.' : '') +
        (accountFilled ? ' Account filled on ' + accountFilled + ' row(s).' : ''),
      suggested ? 'success' : 'warning'
    );
    return;
  }
  applyReviewFilters();
  reviewMessage('Merchant index suggested ' + suggested + ' categorization(s)' + (matchExamples.length ? ' Matches: ' + matchExamples.join('; ') + '.' : '') + (accountFilled ? ' Account filled on ' + accountFilled + ' row(s).' : ''), suggested ? 'success' : 'warning');
}
async function learnSelectedRules() {
  const rows = Array.from(document.querySelectorAll('#reviewRows tr[data-row-id]'));
  let learned = 0;
  for (const tr of rows) {
    if (tr.classList.contains('d-none')) continue;
    const checkbox = tr.querySelector('.review-check');
    if (!checkbox || !checkbox.checked || checkbox.disabled) continue;
    const merchant = tr.querySelector('.review-merchant').value || tr.querySelector('.review-description').value;
    const categoryId = tr.querySelector('.review-category').value;
    if (!merchant || !categoryId) continue;
    const res = await fetch('/api/import/merchant-rules', {
      method: 'POST',
      headers: authHeaders(true),
      body: JSON.stringify({
        pattern: merchant.toLowerCase().slice(0, 60),
        categoryId: Number(categoryId),
        transactionType: tr.querySelector('.review-type').value,
        notes: 'Learned from import batch #' + selectedBatchId
      })
    });
    if (res.ok) learned += 1;
  }
  reviewMessage('Learned ' + learned + ' merchant rule(s) for future imports.', learned ? 'success' : 'warning');
}
function selectPostableRows() {
  document.querySelectorAll('#reviewRows tr[data-row-id]').forEach(tr => {
    if (tr.classList.contains('d-none')) return;
    const checkbox = tr.querySelector('.review-check');
    if (checkbox && !checkbox.disabled) checkbox.checked = true;
  });
}
async function stageFile() {
  if (!selectedFile) return;
  const form = new FormData();
  form.append('file', selectedFile);
  const res = await fetch('/api/import/' + selectedDataset, { method: 'POST', headers: authHeaders(), body: form });
  const data = await res.json().catch(() => ({}));
  const result = document.getElementById('result');
  result.classList.remove('d-none', 'alert-success', 'alert-danger');
  result.classList.add(res.ok ? 'alert-success' : 'alert-danger');
  result.innerHTML = res.ok
    ? '<strong>Batch #' + data.batchId + ' staged.</strong><br>' + esc(data.message) + '<br>Rows received: ' + esc(data.rowCount)
    : esc(data.error || data.message || 'Unable to stage file.');
  if (res.ok) loadBatches();
}
function categorySetupMessage(message, type) {
  const result = document.getElementById('categoryImportResult');
  result.className = 'alert alert-' + (type || 'info') + ' mt-3';
  result.textContent = message;
}
function merchantKeySearchMessage(message, type) {
  const result = document.getElementById('merchantKeySearchResult');
  result.className = 'alert alert-' + (type || 'info') + ' mt-3';
  result.textContent = message;
}
async function exportCategoriesFile() {
  const btn = document.getElementById('categoryExportBtn');
  const originalHtml = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Exporting';
  try {
    const res = await fetch('/api/import/categories/export', { headers: authHeaders() });
    if (!res.ok) {
      const data = await res.json().catch(() => ({}));
      categorySetupMessage(data.error || data.message || 'Unable to export categories.', 'danger');
      return;
    }
    const blob = await res.blob();
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = 'home_accounting_categories.csv';
    document.body.appendChild(link);
    link.click();
    link.remove();
    URL.revokeObjectURL(url);
    categorySetupMessage('Category CSV exported.', 'success');
  } catch (err) {
    categorySetupMessage(err.message || 'Unable to export categories.', 'danger');
  } finally {
    btn.disabled = false;
    btn.innerHTML = originalHtml;
  }
}
async function importCategoriesFile() {
  const file = document.getElementById('categoryImportFile').files[0];
  if (!file) return categorySetupMessage('Select a category CSV first.', 'warning');
  const btn = document.getElementById('categoryImportBtn');
  const originalHtml = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Importing';
  try {
    const form = new FormData();
    form.append('file', file);
    const res = await fetch('/api/import/categories/import', { method: 'POST', headers: authHeaders(), body: form });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) {
      categorySetupMessage(data.error || data.message || 'Unable to import categories.', 'danger');
      return;
    }
    categorySetupMessage(
      (data.message || 'Categories imported.') +
        (data.keywordRulesCreated || data.keywordRulesUpdated ? ' Merchant keyword rules: ' + (data.keywordRulesCreated || 0) + ' created, ' + (data.keywordRulesUpdated || 0) + ' updated.' : '') +
        (data.skipped ? ' Skipped: ' + data.skipped + '.' : '') +
        (data.warnings && data.warnings.length ? ' Warnings: ' + data.warnings.length + '.' : ''),
      data.warnings && data.warnings.length ? 'warning' : 'success'
    );
    await loadStatementSetup();
    if (selectedBatchId) await openBatch(selectedBatchId);
  } catch (err) {
    categorySetupMessage(err.message || 'Unable to import categories.', 'danger');
  } finally {
    btn.disabled = false;
    btn.innerHTML = originalHtml;
  }
}
async function searchMerchantKeygroup() {
  const text = document.getElementById('merchantKeySearch').value.trim();
  if (!text) return merchantKeySearchMessage('Enter a merchant, payee, or statement phrase first.', 'warning');
  const btn = document.getElementById('merchantKeySearchBtn');
  const originalHtml = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Searching';
  try {
    const res = await fetch('/api/import/merchant-suggest', {
      method: 'POST',
      headers: authHeaders(true),
      body: JSON.stringify({
        merchant: text,
        description: text,
        transactionType: document.getElementById('merchantKeySearchType').value || 'expense',
        onlineLookup: false
      })
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) return merchantKeySearchMessage(data.error || data.message || 'Unable to search merchant keywords.', 'danger');
    if (!data.suggestion) return merchantKeySearchMessage('No category matched the current merchant keyword index.', 'warning');
    merchantKeySearchMessage(
      'Matched ' + data.suggestion.categoryName +
        ' using "' + data.suggestion.matchedPattern + '"' +
        (data.suggestion.source ? ' from ' + data.suggestion.source + '.' : '.'),
      'success'
    );
  } catch (err) {
    merchantKeySearchMessage(err.message || 'Unable to search merchant keywords.', 'danger');
  } finally {
    btn.disabled = false;
    btn.innerHTML = originalHtml;
  }
}
function renderHistoryTypeFilter() {
  const select = document.getElementById('historyTypeFilter');
  const current = select.value;
  const types = Array.from(new Set(historyRowsCache.map(row => row.importType).filter(Boolean))).sort();
  select.innerHTML = '<option value="">All datasets</option>' + types.map(type =>
    '<option value="' + esc(type) + '"' + (type === current ? ' selected' : '') + '>' + esc(type) + '</option>'
  ).join('');
}
function filteredHistoryRows() {
  const search = plain(document.getElementById('historySearchFilter').value);
  const status = document.getElementById('historyStatusFilter').value;
  const type = document.getElementById('historyTypeFilter').value;
  return historyRowsCache.filter(row => {
    const haystack = plain([row.id, row.importType, row.fileName, row.status, row.createdBy, row.createdAt].join(' '));
    if (search && !haystack.includes(search)) return false;
    if (status && row.status !== status) return false;
    if (type && row.importType !== type) return false;
    return true;
  }).sort((a, b) => compareValues(a[historySort.key], b[historySort.key], historySort.direction));
}
function renderHistoryRows() {
  const rows = filteredHistoryRows();
  updateSortIndicators('history', historySort);
  document.getElementById('historyVisibleCount').textContent = rows.length + ' of ' + historyRowsCache.length + ' batches';
  document.getElementById('historyRows').innerHTML = rows.length ? rows.map(row =>
    '<tr>' +
      '<td>#' + esc(row.id) + '</td>' +
      '<td>' + esc(row.importType) + '</td>' +
      '<td>' + esc(row.fileName || '') + '</td>' +
      '<td>' + esc(row.rowCount) + '<div class="small text-muted">' + esc(row.acceptedCount || 0) + ' posted / ' + esc(row.rejectedCount || 0) + ' blocked</div></td>' +
      '<td><span class="badge ' + (row.status === 'removed' ? 'bg-danger' : 'bg-secondary') + '">' + esc(row.status) + '</span></td>' +
      '<td>' + esc(row.createdAt ? String(row.createdAt).slice(0, 19).replace('T', ' ') : '') + '</td>' +
      '<td>' + esc(row.createdBy || '') + '</td>' +
      '<td class="text-end"><div class="d-inline-flex gap-2">' +
        '<button class="btn btn-outline-primary btn-sm" onclick="openBatch(' + Number(row.id) + ')"><i class="fas fa-clipboard-check me-1"></i>Open</button>' +
        '<button class="btn btn-outline-danger btn-sm" ' + (row.status === 'removed' ? 'disabled' : '') + ' onclick="removeBatch(' + Number(row.id) + ', \'' + esc(String(row.fileName || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'")) + '\')"><i class="fas fa-trash-alt me-1"></i>Remove</button>' +
      '</div></td>' +
    '</tr>'
  ).join('') : '<tr><td colspan="8" class="text-muted">No staged batches match the current filters.</td></tr>';
}
async function loadBatches() {
  const includeRemoved = document.getElementById('showRemovedBatches').checked;
  const res = await fetch('/api/import/batches' + (includeRemoved ? '?includeRemoved=1' : ''), { headers: authHeaders() });
  historyRowsCache = res.ok ? await res.json() : [];
  renderHistoryTypeFilter();
  renderHistoryRows();
}
async function removeBatch(id, fileName) {
  if (!id) return;
  const label = fileName || ('batch #' + id);
  if (!window.confirm('Remove ' + label + ' from the active staging queue? Posted ledger transactions will stay protected.')) return;
  const res = await fetch('/api/import/batches/' + id, {
    method: 'DELETE',
    headers: authHeaders(true),
    body: JSON.stringify({ reason: 'Removed from staging queue from import screen.' })
  });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) {
    reviewMessage(data.error || data.message || 'Unable to remove staged document.', 'danger');
    return;
  }
  if (Number(selectedBatchId) === Number(id)) {
    selectedBatchId = null;
    batchRows = [];
    document.getElementById('batchReviewPanel').classList.add('d-none');
  }
  await loadBatches();
  const result = document.getElementById('statementResult');
  result.className = 'alert alert-success mt-3';
  result.textContent = data.message || 'Staged document removed from active queue.';
}

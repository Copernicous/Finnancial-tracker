<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Curated Data Import - Home Accounting</title>
  <link href="/assets/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/inter.css" rel="stylesheet">
  <link rel="stylesheet" href="/assets/fontawesome.all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .import-layout { display: block; }
    .dataset-strip { margin-bottom: 1rem; }
    #datasetCards { display: flex; gap: .6rem; overflow-x: auto; overflow-y: hidden; padding: .1rem .1rem .35rem; scroll-snap-type: x proximity; -webkit-overflow-scrolling: touch; }
    #datasetCards::-webkit-scrollbar { height: 8px; }
    #datasetCards::-webkit-scrollbar-thumb { background: rgba(100,116,139,.45); border-radius: 999px; }
    .dataset-card { flex: 0 0 210px; border: 1px solid var(--border,#e2e8f0); border-radius: 8px; padding: .65rem .75rem; cursor: pointer; background: var(--surface,#fff); transition: border-color .15s, box-shadow .15s; min-height: 70px; scroll-snap-align: start; }
    .dataset-card.active { border-color: var(--primary,#0d6efd); box-shadow: 0 0 0 3px rgba(13,110,253,.12); }
    .dataset-card .fw-semibold { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .dataset-card .dataset-desc { font-size: .76rem; line-height: 1.2; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .drop-zone { border: 2px dashed var(--border,#cbd5e1); border-radius: 8px; padding: 1.25rem; background: var(--surface-2,#f8fafc); text-align: center; cursor: pointer; }
    .drop-zone.dragging { border-color: var(--primary,#0d6efd); background: rgba(13,110,253,.06); }
    .spec-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: .5rem; }
    .spec-chip { border: 1px solid var(--border,#e2e8f0); border-radius: 8px; padding: .55rem .65rem; background: var(--surface,#fff); font-size: .82rem; }
    .step-pill { display: inline-flex; align-items: center; gap: .4rem; border: 1px solid var(--border,#e2e8f0); border-radius: 999px; padding: .35rem .7rem; font-size: .78rem; color: var(--text-muted,#64748b); }
    .step-pill.active { color: var(--primary,#0d6efd); border-color: rgba(13,110,253,.45); background: rgba(13,110,253,.06); }
    .preview-wrap { max-height: 330px; overflow: auto; border: 1px solid var(--border,#e2e8f0); border-radius: 8px; }
    .preview-wrap table { margin: 0; min-width: 720px; }
    .field-required { color: #dc3545; font-weight: 700; }
    .statement-grid { display: grid; grid-template-columns: repeat(4, minmax(150px, 1fr)); gap: .75rem; align-items: end; }
    .statement-result-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .5rem; }
    .review-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: .75rem; align-items: end; }
    .review-wrap { max-height: 520px; overflow: auto; border: 1px solid var(--border,#e2e8f0); border-radius: 8px; }
    .review-wrap table { margin: 0; min-width: 1280px; }
    .review-wrap .form-control, .review-wrap .form-select { min-width: 120px; }
    .review-wrap .description-input { min-width: 280px; }
    .review-wrap .amount-input { min-width: 105px; }
    .row-status { text-transform: capitalize; }
    .row-status.duplicate, .row-status.error { color: #dc3545; font-weight: 700; }
    .row-status.posted { color: #198754; font-weight: 700; }
    .filter-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .75rem; align-items: end; }
    .sort-btn { border: 0; background: transparent; padding: 0; color: inherit; font: inherit; font-weight: 700; white-space: nowrap; }
    .sort-btn:hover { color: var(--primary,#0d6efd); }
    .lookup-note { max-width: 260px; color: var(--text-muted,#64748b); }
    .lookup-compact { display: flex; align-items: center; gap: .4rem; min-width: 180px; }
    .lookup-compact .lookup-label { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .lookup-note strong { color: var(--text,#0f172a); }
    .lookup-detail-body { white-space: pre-wrap; }
    [data-theme="dark"] .lookup-note strong { color: var(--text,#e2e8f0); }
    @media (max-width: 768px) { .dataset-card { flex-basis: 170px; } .statement-grid, .review-grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
<div class="wrapper">
  <%- include('partials/sidebar') %>
  <div id="content">
    <nav class="navbar navbar-expand-lg px-4 mb-4">
      <button type="button" id="sidebarCollapse" class="btn btn-primary btn-sm"><i class="fas fa-bars"></i></button>
      <span class="ms-3 fw-bold fs-5">Curated Data Import</span>
      <div class="ms-auto d-flex align-items-center gap-3">
        <span id="userGreeting" class="text-muted small"></span>
        <button id="logoutBtn" class="btn btn-danger btn-sm"><i class="fas fa-sign-out-alt me-1"></i>Logout</button>
      </div>
    </nav>

    <div class="container-fluid px-4">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div class="d-flex flex-wrap gap-2">
          <span class="step-pill active"><i class="fas fa-table"></i>Template</span>
          <span class="step-pill active"><i class="fas fa-search"></i>Preview</span>
          <span class="step-pill"><i class="fas fa-archive"></i>Stage Only</span>
          <span class="step-pill"><i class="fas fa-user-check"></i>Future Review</span>
        </div>
        <button class="btn btn-outline-secondary btn-sm" type="button" id="datasetToggleBtn" aria-controls="datasetPanel" aria-expanded="true"><i class="fas fa-eye-slash me-1"></i>Hide Datasets</button>
      </div>

      <section class="glass-card p-3 dataset-strip" id="datasetPanel">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold mb-0">Accounting Datasets</h6>
            <span class="badge bg-primary">2026</span>
          </div>
          <div id="datasetCards"></div>
      </section>

      <div class="import-layout">
        <main class="d-grid gap-3">
          <section class="glass-card p-4">
            <div class="d-flex justify-content-between flex-wrap gap-3 mb-3">
              <div>
                <h5 class="mb-1" id="datasetTitle">Dataset</h5>
                <div class="text-muted small" id="datasetDescription"></div>
              </div>
              <a class="btn btn-outline-primary btn-sm align-self-start" id="templateLink" href="#">
                <i class="fas fa-download me-1"></i>Download Template
              </a>
            </div>

            <div class="row g-3">
              <div class="col-lg-7">
                <div class="drop-zone" id="dropZone">
                  <i class="fas fa-cloud-upload-alt text-primary mb-2" style="font-size:2rem"></i>
                  <div class="fw-semibold">Drop curated CSV here</div>
                  <div class="text-muted small">or click to browse. Data is staged only, not posted to the ledger.</div>
                  <div class="mt-2 small fw-semibold text-primary" id="fileLabel"></div>
                  <input type="file" id="file" accept=".csv" hidden>
                </div>
              </div>
              <div class="col-lg-5">
                <div class="spec-grid" id="qualityCards"></div>
              </div>
            </div>
          </section>

          <section class="glass-card p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
              <div>
                <h5 class="mb-1">Template Compare</h5>
                <div class="text-muted small">Local browser preview checks headers before the file is staged.</div>
              </div>
              <button class="btn btn-primary" id="stageBtn" disabled><i class="fas fa-inbox me-1"></i>Stage File</button>
            </div>

            <div id="comparePanel" class="alert alert-secondary py-2">Select a file to compare it against the selected accounting template.</div>
            <div class="preview-wrap d-none" id="previewWrap">
              <table class="table table-sm table-hover">
                <thead id="previewHead"></thead>
                <tbody id="previewBody"></tbody>
              </table>
            </div>
            <div class="alert mt-3 d-none" id="result"></div>
          </section>

          <section class="glass-card p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
              <div>
                <h5 class="mb-1">Category Setup</h5>
                <div class="text-muted small">Export the category chart or import curated CSV/JSON with merchant keyword groups.</div>
              </div>
              <button class="btn btn-outline-primary btn-sm" id="categoryExportBtn"><i class="fas fa-file-export me-1"></i>Export Categories</button>
            </div>
            <div class="row g-3 align-items-end">
              <div class="col-lg-8">
                <label class="form-label">Curated Category CSV or JSON</label>
                <input class="form-control" type="file" id="categoryImportFile" accept=".csv,.json,.txt,text/csv,application/json,text/plain">
              </div>
              <div class="col-lg-4 d-grid">
                <button class="btn btn-primary" id="categoryImportBtn"><i class="fas fa-tags me-1"></i>Import Categories</button>
              </div>
            </div>
            <div class="row g-3 align-items-end mt-1">
              <div class="col-lg-6">
                <label class="form-label">Merchant Keyword Search</label>
                <input class="form-control" id="merchantKeySearch" placeholder="Merchant, payee, or statement text">
              </div>
              <div class="col-lg-3">
                <label class="form-label">Type</label>
                <select class="form-select" id="merchantKeySearchType">
                  <option value="expense">expense</option>
                  <option value="income">income</option>
                  <option value="transfer">transfer</option>
                  <option value="adjustment">adjustment</option>
                </select>
              </div>
              <div class="col-lg-3 d-grid">
                <button class="btn btn-outline-secondary" id="merchantKeySearchBtn"><i class="fas fa-search me-1"></i>Find Category</button>
              </div>
            </div>
            <div class="alert mt-3 d-none" id="categoryImportResult"></div>
            <div class="alert mt-3 d-none" id="merchantKeySearchResult"></div>
          </section>

          <section class="glass-card p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
              <div>
                <h5 class="mb-1">Bank Statement Import</h5>
                <div class="text-muted small">Parse uploaded bank statements into staged rows for review. Nothing posts to the ledger.</div>
              </div>
              <span class="badge bg-warning text-dark"><i class="fas fa-lock me-1"></i>Stage Only</span>
            </div>

            <div class="statement-grid">
              <div>
                <label class="form-label">Profile</label>
                <select class="form-select" id="statementProfile"></select>
              </div>
              <div>
                <label class="form-label">Target Account</label>
                <select class="form-select" id="statementAccount"><option value="">No account selected</option></select>
              </div>
              <div>
                <label class="form-label">Statement PDF</label>
                <input class="form-control" type="file" id="statementFile" accept=".pdf,application/pdf">
              </div>
              <div class="d-grid">
                <button class="btn btn-primary" id="statementStageBtn"><i class="fas fa-file-invoice-dollar me-1"></i>Parse & Stage</button>
              </div>
            </div>

            <div class="alert mt-3 d-none" id="statementResult"></div>
            <div class="statement-result-grid mt-3 d-none" id="statementMeta"></div>
            <div class="preview-wrap mt-3 d-none" id="statementPreviewWrap">
              <table class="table table-sm table-hover">
                <thead><tr><th>Post Date</th><th>Cardholder</th><th>Section</th><th>Description</th><th class="text-end">Statement Amount</th><th class="text-end">Suggested Ledger</th></tr></thead>
                <tbody id="statementPreviewRows"></tbody>
              </table>
            </div>
          </section>

          <section class="glass-card p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
              <div>
                <h5 class="mb-1">Staged Import Batches</h5>
                <div class="text-muted small">Uploaded rows waiting for future curated mapping and review.</div>
              </div>
              <div class="d-flex flex-wrap gap-2 align-items-center">
                <div class="form-check form-switch mb-0">
                  <input class="form-check-input" type="checkbox" id="showRemovedBatches">
                  <label class="form-check-label small" for="showRemovedBatches">Show Removed</label>
                </div>
                <button class="btn btn-outline-primary btn-sm" id="refreshHistoryBtn"><i class="fas fa-sync-alt me-1"></i>Refresh</button>
              </div>
            </div>
            <div class="filter-grid mb-3">
              <div>
                <label class="form-label">Search</label>
                <input class="form-control" id="historySearchFilter" placeholder="File, dataset, user">
              </div>
              <div>
                <label class="form-label">Status</label>
                <select class="form-select" id="historyStatusFilter">
                  <option value="">All statuses</option>
                  <option value="staged">staged</option>
                  <option value="needs_review">needs_review</option>
                  <option value="partially_posted">partially_posted</option>
                  <option value="posted">posted</option>
                  <option value="removed">removed</option>
                  <option value="closed">closed</option>
                </select>
              </div>
              <div>
                <label class="form-label">Dataset</label>
                <select class="form-select" id="historyTypeFilter"><option value="">All datasets</option></select>
              </div>
              <div>
                <label class="form-label">Visible</label>
                <div class="fw-semibold" id="historyVisibleCount">0 batches</div>
              </div>
            </div>
            <div class="table-responsive">
              <table class="table table-hover align-middle">
                <thead><tr>
                  <th><button class="sort-btn" data-history-sort="id">Batch <span class="sort-indicator"></span></button></th>
                  <th><button class="sort-btn" data-history-sort="importType">Dataset <span class="sort-indicator"></span></button></th>
                  <th><button class="sort-btn" data-history-sort="fileName">File <span class="sort-indicator"></span></button></th>
                  <th><button class="sort-btn" data-history-sort="rowCount">Rows <span class="sort-indicator"></span></button></th>
                  <th><button class="sort-btn" data-history-sort="status">Status <span class="sort-indicator"></span></button></th>
                  <th><button class="sort-btn" data-history-sort="createdAt">Created <span class="sort-indicator"></span></button></th>
                  <th><button class="sort-btn" data-history-sort="createdBy">User <span class="sort-indicator"></span></button></th>
                  <th></th>
                </tr></thead>
                <tbody id="historyRows"><tr><td colspan="8" class="text-muted">Loading...</td></tr></tbody>
              </table>
            </div>
          </section>

          <section class="glass-card p-4 d-none" id="batchReviewPanel">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
              <div>
                <h5 class="mb-1">Review & Post Batch <span id="reviewBatchLabel"></span></h5>
                <div class="text-muted small" id="reviewBatchMeta">Edit staged rows, reject duplicates, then post selected rows to the ledger.</div>
              </div>
              <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-secondary btn-sm" id="selectPostableBtn"><i class="fas fa-check-square me-1"></i>Select Postable</button>
                <button class="btn btn-outline-success btn-sm" id="suggestCategoriesBtn"><i class="fas fa-magic me-1"></i>Suggest Categories</button>
                <button class="btn btn-outline-info btn-sm" id="lookupOnlineBtn"><i class="fas fa-search me-1"></i>Lookup Online</button>
                <button class="btn btn-outline-secondary btn-sm" id="learnRulesBtn"><i class="fas fa-bookmark me-1"></i>Learn Selected</button>
                <button class="btn btn-outline-primary btn-sm" id="saveReviewBtn"><i class="fas fa-save me-1"></i>Save Review</button>
                <button class="btn btn-success btn-sm" id="postRowsBtn"><i class="fas fa-file-import me-1"></i>Post Selected</button>
              </div>
            </div>

            <div class="review-grid mb-3">
              <div>
                <label class="form-label">Default Account</label>
                <select class="form-select" id="reviewDefaultAccount"><option value="">No default</option></select>
              </div>
              <div>
                <label class="form-label">Default Category</label>
                <select class="form-select" id="reviewDefaultCategory"><option value="">No default</option></select>
              </div>
              <div>
                <label class="form-label">Category Search</label>
                <input class="form-control" id="reviewCategorySearch" placeholder="Type to filter categories">
              </div>
              <div>
                <label class="form-label">Ledger Status</label>
                <select class="form-select" id="reviewDefaultStatus">
                  <option value="draft">draft</option>
                  <option value="reviewed">reviewed</option>
                  <option value="reconciled">reconciled</option>
                </select>
              </div>
              <div class="d-grid">
                <button class="btn btn-outline-primary" id="applyDefaultsBtn"><i class="fas fa-magic me-1"></i>Apply Defaults</button>
              </div>
              <div class="d-grid">
                <button class="btn btn-outline-secondary" id="reloadReviewBtn"><i class="fas fa-sync-alt me-1"></i>Reload Rows</button>
              </div>
            </div>

            <div class="filter-grid mb-3">
              <div>
                <label class="form-label">Search Rows</label>
                <input class="form-control" id="reviewSearchFilter" placeholder="Description, merchant, note">
              </div>
              <div>
                <label class="form-label">Row Status</label>
                <select class="form-select" id="reviewStatusFilter">
                  <option value="">All statuses</option>
                  <option value="staged">staged</option>
                  <option value="ready">ready</option>
                  <option value="error">error</option>
                  <option value="duplicate">duplicate</option>
                  <option value="posted">posted</option>
                  <option value="rejected">rejected</option>
                </select>
              </div>
              <div>
                <label class="form-label">Category</label>
                <select class="form-select" id="reviewCategoryFilter">
                  <option value="">All categories</option>
                  <option value="missing">Missing category</option>
                  <option value="present">Has category</option>
                </select>
              </div>
              <div>
                <label class="form-label">Type</label>
                <select class="form-select" id="reviewTypeFilter">
                  <option value="">All types</option>
                  <option value="expense">expense</option>
                  <option value="income">income</option>
                  <option value="transfer">transfer</option>
                  <option value="adjustment">adjustment</option>
                </select>
              </div>
              <div>
                <label class="form-label">Visible</label>
                <div class="fw-semibold" id="reviewVisibleCount">0 rows</div>
              </div>
            </div>

            <div class="alert d-none" id="reviewResult"></div>
            <div class="review-wrap">
              <table class="table table-sm table-hover align-middle">
                <thead>
                  <tr>
                    <th><input class="form-check-input" type="checkbox" id="selectAllReview"></th>
                    <th><button class="sort-btn" data-review-sort="rowNumber">Row <span class="sort-indicator"></span></button></th>
                    <th><button class="sort-btn" data-review-sort="status">Status <span class="sort-indicator"></span></button></th>
                    <th><button class="sort-btn" data-review-sort="date">Date <span class="sort-indicator"></span></button></th>
                    <th><button class="sort-btn" data-review-sort="account">Account <span class="sort-indicator"></span></button></th>
                    <th><button class="sort-btn" data-review-sort="category">Category <span class="sort-indicator"></span></button></th>
                    <th><button class="sort-btn" data-review-sort="type">Type <span class="sort-indicator"></span></button></th>
                    <th class="text-end"><button class="sort-btn" data-review-sort="amount">Amount <span class="sort-indicator"></span></button></th>
                    <th><button class="sort-btn" data-review-sort="description">Description <span class="sort-indicator"></span></button></th>
                    <th><button class="sort-btn" data-review-sort="merchant">Merchant <span class="sort-indicator"></span></button></th>
                    <th>Lookup / Note</th>
                  </tr>
                </thead>
                <tbody id="reviewRows"><tr><td colspan="11" class="text-muted">Open a staged batch to review rows.</td></tr></tbody>
              </table>
            </div>
          </section>
        </main>
      </div>
    </div>
  </div>
</div>
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100"></div>
<div class="modal fade" id="lookupDetailModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="lookupDetailTitle">Lookup Detail</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="d-grid gap-3" id="lookupDetailBody"></div>
      </div>
    </div>
  </div>
</div>
<script src="/assets/bootstrap.bundle.min.js"></script>
<a id="xa-base" href="/login" style="display:none"></a>
<script src="/js/base.js"></script>
<script src="/js/main.js"></script>
<script>
const DATASETS = {
  accounts: {
    icon: 'fa-wallet',
    title: 'Accounts',
    description: 'Chart of accounts, opening balances, and institution references.',
    required: ['name', 'accountType', 'currency'],
    headers: ['name', 'accountCode', 'accountType', 'accountClass', 'accountSubtype', 'currency', 'financialInstitutionName', 'openingBalance', 'openingBalanceDate', 'currentBalance', 'creditLimit', 'interestRate', 'includeInNetWorth', 'status', 'notes']
  },
  transactions: {
    icon: 'fa-receipt',
    title: 'Transactions',
    description: 'Curated 2026 ledger activity ready for accounting review.',
    required: ['transactionDate', 'accountName', 'description', 'transactionType', 'amount'],
    headers: ['transactionDate', 'accountName', 'categoryName', 'relatedAccountName', 'description', 'merchant', 'transactionType', 'amount', 'currency', 'originalAmount', 'originalCurrency', 'exchangeRate', 'status', 'referenceNumber', 'tags', 'clearedDate', 'memo']
  },
  categories: {
    icon: 'fa-tags',
    title: 'Categories',
    description: 'Income, expense, transfer, adjustment categories, and merchant keyword groups.',
    required: ['name', 'categoryType'],
    headers: ['name', 'categoryType', 'groupName', 'budgetBehavior', 'parentName', 'taxRelevant', 'isActive', 'merchantKeywords']
  },
  budgets: {
    icon: 'fa-scale-balanced',
    title: 'Budgets',
    description: 'Monthly, annual, and one-time plans by category.',
    required: ['name', 'year', 'plannedAmount'],
    headers: ['name', 'year', 'month', 'categoryName', 'budgetType', 'plannedAmount', 'currency', 'alertThresholdPct', 'isActive', 'notes']
  },
  recurring: {
    icon: 'fa-calendar-check',
    title: 'Recurring Items',
    description: 'Salary, utilities, transfers, and repeating household obligations.',
    required: ['name', 'accountName', 'transactionType', 'amount', 'nextDate'],
    headers: ['name', 'accountName', 'categoryName', 'transactionType', 'amount', 'currency', 'frequency', 'nextDate', 'endDate', 'merchant', 'isActive', 'notes']
  },
  goals: {
    icon: 'fa-bullseye',
    title: 'Financial Goals',
    description: 'Savings targets, debt payoff plans, and sinking funds.',
    required: ['name', 'goalType', 'targetAmount'],
    headers: ['name', 'goalType', 'accountName', 'targetAmount', 'currentAmount', 'currency', 'targetDate', 'priority', 'status', 'notes']
  },
  investments: {
    icon: 'fa-chart-area',
    title: 'Investments',
    description: 'Holdings, balances, and market values by account.',
    required: ['accountName', 'symbol', 'marketValue'],
    headers: ['accountName', 'symbol', 'name', 'assetClass', 'quantity', 'costBasis', 'marketValue', 'currency', 'priceDate', 'notes']
  },
  currency_rates: {
    icon: 'fa-coins',
    title: 'Currency Rates',
    description: 'Manual FX rates used for multi-currency review.',
    required: ['rateDate', 'fromCurrency', 'toCurrency', 'rate'],
    headers: ['rateDate', 'fromCurrency', 'toCurrency', 'rate', 'source', 'notes']
  },
  balance_snapshots: {
    icon: 'fa-camera-retro',
    title: 'Balance Snapshots',

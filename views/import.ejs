<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Curated Data Import - Home Accounting</title>
  <link href="/assets/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/inter.css" rel="stylesheet">
  <link rel="stylesheet" href="/assets/fontawesome.all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .import-layout { display: grid; grid-template-columns: 340px minmax(0, 1fr); gap: 1rem; }
    .dataset-card { border: 1px solid var(--border,#e2e8f0); border-radius: 8px; padding: .9rem; cursor: pointer; background: var(--surface,#fff); transition: border-color .15s, box-shadow .15s; }
    .dataset-card.active { border-color: var(--primary,#0d6efd); box-shadow: 0 0 0 3px rgba(13,110,253,.12); }
    .drop-zone { border: 2px dashed var(--border,#cbd5e1); border-radius: 8px; padding: 1.25rem; background: var(--surface-2,#f8fafc); text-align: center; cursor: pointer; }
    .drop-zone.dragging { border-color: var(--primary,#0d6efd); background: rgba(13,110,253,.06); }
    .spec-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: .5rem; }
    .spec-chip { border: 1px solid var(--border,#e2e8f0); border-radius: 8px; padding: .55rem .65rem; background: var(--surface,#fff); font-size: .82rem; }
    .step-pill { display: inline-flex; align-items: center; gap: .4rem; border: 1px solid var(--border,#e2e8f0); border-radius: 999px; padding: .35rem .7rem; font-size: .78rem; color: var(--text-muted,#64748b); }
    .step-pill.active { color: var(--primary,#0d6efd); border-color: rgba(13,110,253,.45); background: rgba(13,110,253,.06); }
    .preview-wrap { max-height: 330px; overflow: auto; border: 1px solid var(--border,#e2e8f0); border-radius: 8px; }
    .preview-wrap table { margin: 0; min-width: 720px; }
    .field-required { color: #dc3545; font-weight: 700; }
    .statement-grid { display: grid; grid-template-columns: repeat(4, minmax(150px, 1fr)); gap: .75rem; align-items: end; }
    .statement-result-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .5rem; }
    .review-grid { display: grid; grid-template-columns: repeat(5, minmax(130px, 1fr)); gap: .75rem; align-items: end; }
    .review-wrap { max-height: 520px; overflow: auto; border: 1px solid var(--border,#e2e8f0); border-radius: 8px; }
    .review-wrap table { margin: 0; min-width: 1280px; }
    .review-wrap .form-control, .review-wrap .form-select { min-width: 120px; }
    .review-wrap .description-input { min-width: 280px; }
    .review-wrap .amount-input { min-width: 105px; }
    .row-status { text-transform: capitalize; }
    .row-status.duplicate, .row-status.error { color: #dc3545; font-weight: 700; }
    .row-status.posted { color: #198754; font-weight: 700; }
    @media (max-width: 992px) { .import-layout { grid-template-columns: 1fr; } }
    @media (max-width: 768px) { .statement-grid, .review-grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
<div class="wrapper">
  <%- include('partials/sidebar') %>
  <div id="content">
    <nav class="navbar navbar-expand-lg px-4 mb-4">
      <button type="button" id="sidebarCollapse" class="btn btn-primary btn-sm"><i class="fas fa-bars"></i></button>
      <span class="ms-3 fw-bold fs-5">Curated Data Import</span>
      <div class="ms-auto d-flex align-items-center gap-3">
        <span id="userGreeting" class="text-muted small"></span>
        <button id="logoutBtn" class="btn btn-danger btn-sm"><i class="fas fa-sign-out-alt me-1"></i>Logout</button>
      </div>
    </nav>

    <div class="container-fluid px-4">
      <div class="d-flex flex-wrap gap-2 mb-3">
        <span class="step-pill active"><i class="fas fa-table"></i>Template</span>
        <span class="step-pill active"><i class="fas fa-search"></i>Preview</span>
        <span class="step-pill"><i class="fas fa-archive"></i>Stage Only</span>
        <span class="step-pill"><i class="fas fa-user-check"></i>Future Review</span>
      </div>

      <div class="import-layout">
        <aside class="glass-card p-3">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="fw-bold mb-0">Accounting Datasets</h6>
            <span class="badge bg-primary">2026</span>
          </div>
          <div id="datasetCards" class="d-grid gap-2"></div>
        </aside>

        <main class="d-grid gap-3">
          <section class="glass-card p-4">
            <div class="d-flex justify-content-between flex-wrap gap-3 mb-3">
              <div>
                <h5 class="mb-1" id="datasetTitle">Dataset</h5>
                <div class="text-muted small" id="datasetDescription"></div>
              </div>
              <a class="btn btn-outline-primary btn-sm align-self-start" id="templateLink" href="#">
                <i class="fas fa-download me-1"></i>Download Template
              </a>
            </div>

            <div class="row g-3">
              <div class="col-lg-7">
                <div class="drop-zone" id="dropZone">
                  <i class="fas fa-cloud-upload-alt text-primary mb-2" style="font-size:2rem"></i>
                  <div class="fw-semibold">Drop curated CSV here</div>
                  <div class="text-muted small">or click to browse. Data is staged only, not posted to the ledger.</div>
                  <div class="mt-2 small fw-semibold text-primary" id="fileLabel"></div>
                  <input type="file" id="file" accept=".csv" hidden>
                </div>
              </div>
              <div class="col-lg-5">
                <div class="spec-grid" id="qualityCards"></div>
              </div>
            </div>
          </section>

          <section class="glass-card p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
              <div>
                <h5 class="mb-1">Template Compare</h5>
                <div class="text-muted small">Local browser preview checks headers before the file is staged.</div>
              </div>
              <button class="btn btn-primary" id="stageBtn" disabled><i class="fas fa-inbox me-1"></i>Stage File</button>
            </div>

            <div id="comparePanel" class="alert alert-secondary py-2">Select a file to compare it against the selected accounting template.</div>
            <div class="preview-wrap d-none" id="previewWrap">
              <table class="table table-sm table-hover">
                <thead id="previewHead"></thead>
                <tbody id="previewBody"></tbody>
              </table>
            </div>
            <div class="alert mt-3 d-none" id="result"></div>
          </section>

          <section class="glass-card p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
              <div>
                <h5 class="mb-1">Bank Statement Import</h5>
                <div class="text-muted small">Parse uploaded bank statements into staged rows for review. Nothing posts to the ledger.</div>
              </div>
              <span class="badge bg-warning text-dark"><i class="fas fa-lock me-1"></i>Stage Only</span>
            </div>

            <div class="statement-grid">
              <div>
                <label class="form-label">Profile</label>
                <select class="form-select" id="statementProfile"></select>
              </div>
              <div>
                <label class="form-label">Target Account</label>
                <select class="form-select" id="statementAccount"><option value="">No account selected</option></select>
              </div>
              <div>
                <label class="form-label">Statement PDF</label>
                <input class="form-control" type="file" id="statementFile" accept=".pdf,application/pdf">
              </div>
              <div class="d-grid">
                <button class="btn btn-primary" id="statementStageBtn"><i class="fas fa-file-invoice-dollar me-1"></i>Parse & Stage</button>
              </div>
            </div>

            <div class="alert mt-3 d-none" id="statementResult"></div>
            <div class="statement-result-grid mt-3 d-none" id="statementMeta"></div>
            <div class="preview-wrap mt-3 d-none" id="statementPreviewWrap">
              <table class="table table-sm table-hover">
                <thead><tr><th>Post Date</th><th>Cardholder</th><th>Section</th><th>Description</th><th class="text-end">Statement Amount</th><th class="text-end">Suggested Ledger</th></tr></thead>
                <tbody id="statementPreviewRows"></tbody>
              </table>
            </div>
          </section>

          <section class="glass-card p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
              <div>
                <h5 class="mb-1">Staged Import Batches</h5>
                <div class="text-muted small">Uploaded rows waiting for future curated mapping and review.</div>
              </div>
              <button class="btn btn-outline-primary btn-sm" id="refreshHistoryBtn"><i class="fas fa-sync-alt me-1"></i>Refresh</button>
            </div>
            <div class="table-responsive">
              <table class="table table-hover align-middle">
                <thead><tr><th>Batch</th><th>Dataset</th><th>File</th><th>Rows</th><th>Status</th><th>Created</th><th>User</th><th></th></tr></thead>
                <tbody id="historyRows"><tr><td colspan="8" class="text-muted">Loading...</td></tr></tbody>
              </table>
            </div>
          </section>

          <section class="glass-card p-4 d-none" id="batchReviewPanel">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
              <div>
                <h5 class="mb-1">Review & Post Batch <span id="reviewBatchLabel"></span></h5>
                <div class="text-muted small" id="reviewBatchMeta">Edit staged rows, reject duplicates, then post selected rows to the ledger.</div>
              </div>
              <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-secondary btn-sm" id="selectPostableBtn"><i class="fas fa-check-square me-1"></i>Select Postable</button>
                <button class="btn btn-outline-primary btn-sm" id="saveReviewBtn"><i class="fas fa-save me-1"></i>Save Review</button>
                <button class="btn btn-success btn-sm" id="postRowsBtn"><i class="fas fa-file-import me-1"></i>Post Selected</button>
              </div>
            </div>

            <div class="review-grid mb-3">
              <div>
                <label class="form-label">Default Account</label>
                <select class="form-select" id="reviewDefaultAccount"><option value="">No default</option></select>
              </div>
              <div>
                <label class="form-label">Default Category</label>
                <select class="form-select" id="reviewDefaultCategory"><option value="">No default</option></select>
              </div>
              <div>
                <label class="form-label">Ledger Status</label>
                <select class="form-select" id="reviewDefaultStatus">
                  <option value="draft">draft</option>
                  <option value="reviewed">reviewed</option>
                  <option value="reconciled">reconciled</option>
                </select>
              </div>
              <div class="d-grid">
                <button class="btn btn-outline-primary" id="applyDefaultsBtn"><i class="fas fa-magic me-1"></i>Apply Defaults</button>
              </div>
              <div class="d-grid">
                <button class="btn btn-outline-secondary" id="reloadReviewBtn"><i class="fas fa-sync-alt me-1"></i>Reload Rows</button>
              </div>
            </div>

            <div class="alert d-none" id="reviewResult"></div>
            <div class="review-wrap">
              <table class="table table-sm table-hover align-middle">
                <thead>
                  <tr>
                    <th><input class="form-check-input" type="checkbox" id="selectAllReview"></th>
                    <th>Row</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th>Account</th>
                    <th>Category</th>
                    <th>Type</th>
                    <th class="text-end">Amount</th>
                    <th>Description</th>
                    <th>Merchant</th>
                    <th>Note</th>
                  </tr>
                </thead>
                <tbody id="reviewRows"><tr><td colspan="11" class="text-muted">Open a staged batch to review rows.</td></tr></tbody>
              </table>
            </div>
          </section>
        </main>
      </div>
    </div>
  </div>
</div>
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100"></div>
<script src="/assets/bootstrap.bundle.min.js"></script>
<a id="xa-base" href="/login" style="display:none"></a>
<script src="/js/base.js"></script>
<script src="/js/main.js"></script>
<script>
const DATASETS = {
  accounts: {
    icon: 'fa-wallet',
    title: 'Accounts',
    description: 'Chart of accounts, opening balances, and institution references.',
    required: ['name', 'accountType', 'currency'],
    headers: ['name', 'accountCode', 'accountType', 'accountClass', 'accountSubtype', 'currency', 'financialInstitutionName', 'openingBalance', 'openingBalanceDate', 'currentBalance', 'creditLimit', 'interestRate', 'includeInNetWorth', 'status', 'notes']
  },
  transactions: {
    icon: 'fa-receipt',
    title: 'Transactions',
    description: 'Curated 2026 ledger activity ready for accounting review.',
    required: ['transactionDate', 'accountName', 'description', 'transactionType', 'amount'],
    headers: ['transactionDate', 'accountName', 'categoryName', 'relatedAccountName', 'description', 'merchant', 'transactionType', 'amount', 'currency', 'originalAmount', 'originalCurrency', 'exchangeRate', 'status', 'referenceNumber', 'tags', 'clearedDate', 'memo']
  },
  categories: {
    icon: 'fa-tags',
    title: 'Categories',
    description: 'Income, expense, transfer, and adjustment categories.',
    required: ['name', 'categoryType'],
    headers: ['name', 'categoryType', 'groupName', 'budgetBehavior', 'parentName', 'taxRelevant', 'isActive']
  },
  budgets: {
    icon: 'fa-scale-balanced',
    title: 'Budgets',
    description: 'Monthly, annual, and one-time plans by category.',
    required: ['name', 'year', 'plannedAmount'],
    headers: ['name', 'year', 'month', 'categoryName', 'budgetType', 'plannedAmount', 'currency', 'alertThresholdPct', 'isActive', 'notes']
  },
  recurring: {
    icon: 'fa-calendar-check',
    title: 'Recurring Items',
    description: 'Salary, utilities, transfers, and repeating household obligations.',
    required: ['name', 'accountName', 'transactionType', 'amount', 'nextDate'],
    headers: ['name', 'accountName', 'categoryName', 'transactionType', 'amount', 'currency', 'frequency', 'nextDate', 'endDate', 'merchant', 'isActive', 'notes']
  },
  goals: {
    icon: 'fa-bullseye',
    title: 'Financial Goals',
    description: 'Savings targets, debt payoff plans, and sinking funds.',
    required: ['name', 'goalType', 'targetAmount'],
    headers: ['name', 'goalType', 'accountName', 'targetAmount', 'currentAmount', 'currency', 'targetDate', 'priority', 'status', 'notes']
  },
  investments: {
    icon: 'fa-chart-area',
    title: 'Investments',
    description: 'Holdings, balances, and market values by account.',
    required: ['accountName', 'symbol', 'marketValue'],
    headers: ['accountName', 'symbol', 'name', 'assetClass', 'quantity', 'costBasis', 'marketValue', 'currency', 'priceDate', 'notes']
  },
  currency_rates: {
    icon: 'fa-coins',
    title: 'Currency Rates',
    description: 'Manual FX rates used for multi-currency review.',
    required: ['rateDate', 'fromCurrency', 'toCurrency', 'rate'],
    headers: ['rateDate', 'fromCurrency', 'toCurrency', 'rate', 'source', 'notes']
  },
  balance_snapshots: {
    icon: 'fa-camera-retro',
    title: 'Balance Snapshots',
    description: 'Statement or manual balance checkpoints by account.',
    required: ['accountName', 'snapshotDate', 'balance'],
    headers: ['accountName', 'snapshotDate', 'balance', 'currency', 'source', 'notes']
  },
  proofs: {
    icon: 'fa-paperclip',
    title: 'Proofs',
    description: 'Document references tied to accounting records.',
    required: ['ownerType', 'originalName'],
    headers: ['ownerType', 'ownerExternalRef', 'originalName', 'provider', 'driveWebViewLink', 'localPath', 'notes']
  }
};
let selectedDataset = 'transactions';
let selectedFile = null;
let parsedRows = [];
let statementProfiles = [];
let accountRows = [];
let categoryRows = [];
let selectedBatchId = null;
let batchRows = [];

function authHeaders(json) {
  const token = localStorage.getItem('haToken') || localStorage.getItem('token') || '';
  const headers = token ? { Authorization: 'Bearer ' + token } : {};
  if (json) headers['Content-Type'] = 'application/json';
  return headers;
}
function esc(value) {
  return String(value == null ? '' : value).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
}
function parseCsv(text) {
  const rows = [];
  let row = [], cell = '', quoted = false;
  for (let i = 0; i < text.length; i++) {
    const ch = text[i], next = text[i + 1];
    if (ch === '"' && quoted && next === '"') { cell += '"'; i++; continue; }
    if (ch === '"') { quoted = !quoted; continue; }
    if (ch === ',' && !quoted) { row.push(cell); cell = ''; continue; }
    if ((ch === '\n' || ch === '\r') && !quoted) {
      if (ch === '\r' && next === '\n') i++;
      row.push(cell); cell = '';
      if (row.some(v => v.trim() !== '')) rows.push(row);
      row = [];
      continue;
    }
    cell += ch;
  }
  row.push(cell);
  if (row.some(v => v.trim() !== '')) rows.push(row);
  return rows;
}
function renderDatasets() {
  document.getElementById('datasetCards').innerHTML = Object.keys(DATASETS).map(key => {
    const d = DATASETS[key];
    return '<div class="dataset-card ' + (key === selectedDataset ? 'active' : '') + '" onclick="selectDataset(\'' + key + '\')">' +
      '<div class="d-flex align-items-start gap-2"><i class="fas ' + d.icon + ' text-primary mt-1"></i><div><div class="fw-semibold">' + esc(d.title) + '</div><div class="text-muted small">' + esc(d.description) + '</div></div></div>' +
      '</div>';
  }).join('');
}
function renderSelected() {
  const d = DATASETS[selectedDataset];
  document.getElementById('datasetTitle').textContent = d.title;
  document.getElementById('datasetDescription').textContent = d.description;
  document.getElementById('templateLink').href = '/api/import/template/' + selectedDataset;
  document.getElementById('qualityCards').innerHTML = [
    ['Expected Columns', d.headers.length, 'fa-columns'],
    ['Required Fields', d.required.length, 'fa-exclamation-circle'],
    ['Import Mode', 'Stage', 'fa-archive'],
    ['Ledger Posting', 'Manual Review', 'fa-user-check']
  ].map(item => '<div class="spec-chip"><div class="text-muted small"><i class="fas ' + item[2] + ' me-1"></i>' + esc(item[0]) + '</div><div class="fw-bold">' + esc(item[1]) + '</div></div>').join('');
  renderDatasets();
  compareFile();
}
function selectDataset(key) {
  selectedDataset = key;
  renderSelected();
}
function compareFile() {
  const panel = document.getElementById('comparePanel');
  const wrap = document.getElementById('previewWrap');
  const stageBtn = document.getElementById('stageBtn');
  wrap.classList.add('d-none');
  stageBtn.disabled = true;
  if (!parsedRows.length) {
    panel.className = 'alert alert-secondary py-2';
    panel.textContent = 'Select a file to compare it against the selected accounting template.';
    return;
  }
  const expected = DATASETS[selectedDataset].headers;
  const required = DATASETS[selectedDataset].required;
  const actual = parsedRows[0].map(h => h.trim());
  const missing = expected.filter(h => !actual.includes(h));
  const missingRequired = required.filter(h => !actual.includes(h));
  const extra = actual.filter(h => !expected.includes(h));
  const ok = missingRequired.length === 0;
  panel.className = 'alert py-2 ' + (ok ? 'alert-success' : 'alert-danger');
  panel.innerHTML = '<strong>' + (ok ? 'Header check passed.' : 'Missing required headers.') + '</strong> ' +
    'Rows detected: ' + Math.max(parsedRows.length - 1, 0) +
    (missing.length ? '<br>Missing expected: ' + esc(missing.join(', ')) : '') +
    (extra.length ? '<br>Extra columns staged as reference only: ' + esc(extra.join(', ')) : '');
  stageBtn.disabled = !ok || !selectedFile;

  document.getElementById('previewHead').innerHTML = '<tr>' + actual.map(h => '<th>' + esc(h) + (required.includes(h) ? ' <span class="field-required">*</span>' : '') + '</th>').join('') + '</tr>';
  document.getElementById('previewBody').innerHTML = parsedRows.slice(1, 8).map(row => '<tr>' + actual.map((_, i) => '<td>' + esc(row[i] || '') + '</td>').join('') + '</tr>').join('') || '<tr><td class="text-muted">No data rows.</td></tr>';
  wrap.classList.remove('d-none');
}
async function loadStatementSetup() {
  const [profilesRes, accountsRes, categoriesRes] = await Promise.all([
    fetch('/api/import/bank-statement/profiles', { headers: authHeaders() }),
    fetch('/api/accounts', { headers: authHeaders() }),
    fetch('/api/categories', { headers: authHeaders() })
  ]);
  statementProfiles = profilesRes.ok ? await profilesRes.json() : [];
  accountRows = accountsRes.ok ? await accountsRes.json() : [];
  categoryRows = categoriesRes.ok ? await categoriesRes.json() : [];
  document.getElementById('statementProfile').innerHTML = statementProfiles.map(profile =>
    '<option value="' + esc(profile.key) + '">' + esc(profile.label) + '</option>'
  ).join('');
  const activeAccounts = accountRows.filter(account => account.status !== 'inactive' && account.status !== 'closed');
  const accountOptions = activeAccounts.map(account =>
    '<option value="' + account.id + '">' + esc(account.name) + ' (' + esc(account.currency || '') + ')</option>'
  ).join('');
  const categoryOptions = categoryRows.filter(category => category.isActive !== false).map(category =>
    '<option value="' + category.id + '">' + esc(category.groupName ? category.groupName + ' / ' + category.name : category.name) + '</option>'
  ).join('');
  document.getElementById('statementAccount').innerHTML = '<option value="">No account selected</option>' + accountOptions;
  document.getElementById('reviewDefaultAccount').innerHTML = '<option value="">No default</option>' + accountOptions;
  document.getElementById('reviewDefaultCategory').innerHTML = '<option value="">No default</option>' + categoryOptions;
}
async function handleFile(file) {
  selectedFile = file;
  document.getElementById('fileLabel').textContent = file ? file.name : '';
  if (!file) return;
  parsedRows = parseCsv(await file.text());
  compareFile();
}
function money(value) {
  return Number(value || 0).toLocaleString(undefined, { style: 'currency', currency: 'USD' });
}
function renderStatementPreview(data) {
  const result = document.getElementById('statementResult');
  const meta = document.getElementById('statementMeta');
  const wrap = document.getElementById('statementPreviewWrap');
  result.classList.remove('d-none', 'alert-success', 'alert-danger', 'alert-warning');
  result.classList.add(data.ok ? 'alert-success' : 'alert-danger');
  result.innerHTML = data.ok
    ? '<strong>Batch #' + esc(data.batchId) + ' staged.</strong> ' + esc(data.message) + ' Rows: ' + esc(data.rowCount) + (data.duplicateCount ? ' Duplicates: ' + esc(data.duplicateCount) : '')
    : esc(data.error || data.message || 'Unable to parse statement.') + (data.existingBatchId ? ' <button class="btn btn-sm btn-outline-primary ms-2" onclick="openBatch(' + Number(data.existingBatchId) + ')">Open Batch #' + esc(data.existingBatchId) + '</button>' : '');

  if (!data.ok) return;
  const m = data.metadata || {};
  meta.classList.remove('d-none');
  meta.innerHTML = [
    ['Statement Date', m.statementDate || ''],
    ['Billing Period', (m.billingPeriodStart || '') + ' to ' + (m.billingPeriodEnd || '')],
    ['Account Last 4', m.accountLast4 || ''],
    ['New Balance', m.newBalance == null ? '' : money(m.newBalance)],
    ['Minimum Due', m.minimumPaymentDue == null ? '' : money(m.minimumPaymentDue)],
    ['Due Date', m.paymentDueDate || '']
  ].map(item => '<div class="spec-chip"><div class="text-muted small">' + esc(item[0]) + '</div><div class="fw-bold">' + esc(item[1]) + '</div></div>').join('');

  const rows = data.previewRows || [];
  document.getElementById('statementPreviewRows').innerHTML = rows.length ? rows.map(row =>
    '<tr>' +
      '<td>' + esc(row.postDate || '') + '</td>' +
      '<td>' + esc(row.cardholder || '') + '</td>' +
      '<td>' + esc(row.section || '') + '</td>' +
      '<td>' + esc(row.description || '') + '</td>' +
      '<td class="text-end">' + money(row.amount) + '</td>' +
      '<td class="text-end">' + money(row.suggestedLedgerAmount) + (row.rowStatus === 'duplicate' ? '<div class="small text-danger">Duplicate</div>' : '') + '</td>' +
    '</tr>'
  ).join('') : '<tr><td colspan="6" class="text-muted">No rows detected.</td></tr>';
  wrap.classList.remove('d-none');
}
async function stageStatementFile() {
  const file = document.getElementById('statementFile').files[0];
  if (!file) {
    const result = document.getElementById('statementResult');
    result.className = 'alert alert-warning mt-3';
    result.textContent = 'Select a statement PDF first.';
    return;
  }
  const btn = document.getElementById('statementStageBtn');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Parsing';
  try {
    const form = new FormData();
    form.append('profile', document.getElementById('statementProfile').value || 'advantage_citi_pdf');
    form.append('accountId', document.getElementById('statementAccount').value || '');
    form.append('file', file);
    const res = await fetch('/api/import/bank-statement', { method: 'POST', headers: authHeaders(), body: form });
    const data = await res.json().catch(() => ({}));
    renderStatementPreview(Object.assign({ ok: res.ok }, data));
    if (res.ok) {
      await loadBatches();
      openBatch(data.batchId);
    } else if (data.existingBatchId) {
      await loadBatches();
      openBatch(data.existingBatchId);
    }
  } catch (err) {
    renderStatementPreview({ ok: false, error: err.message || 'Unable to parse statement.' });
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-file-invoice-dollar me-1"></i>Parse & Stage';
  }
}
function optionList(rows, selected, emptyLabel, labelFn) {
  const selectedText = selected == null ? '' : String(selected);
  return '<option value="">' + esc(emptyLabel) + '</option>' + rows.map(row => {
    const value = String(row.id);
    return '<option value="' + esc(value) + '"' + (value === selectedText ? ' selected' : '') + '>' + esc(labelFn(row)) + '</option>';
  }).join('');
}
function rowDraft(row) {
  return row && row.normalizedData ? row.normalizedData : {};
}
function postableStatus(status) {
  return ['staged', 'ready', 'error'].includes(String(status || 'staged'));
}
function reviewMessage(message, type) {
  const result = document.getElementById('reviewResult');
  result.className = 'alert alert-' + (type || 'info');
  result.textContent = message;
}
function renderBatchReview() {
  const panel = document.getElementById('batchReviewPanel');
  panel.classList.remove('d-none');
  document.getElementById('reviewBatchLabel').textContent = selectedBatchId ? '#' + selectedBatchId : '';
  document.getElementById('reviewBatchMeta').textContent = batchRows.length + ' staged row(s). Duplicate and posted rows are locked.';

  const accountChoices = accountRows.filter(account => account.status !== 'inactive' && account.status !== 'closed');
  const categoryChoices = categoryRows.filter(category => category.isActive !== false);
  document.getElementById('reviewRows').innerHTML = batchRows.length ? batchRows.map(row => {
    const draft = rowDraft(row);
    const status = row.status || 'staged';
    const disabled = !postableStatus(status);
    const note = row.errorMessage || (row.rawData && row.rawData.duplicateReason) || '';
    return '<tr data-row-id="' + esc(row.id) + '">' +
      '<td><input class="form-check-input review-check" type="checkbox" ' + (disabled ? 'disabled' : '') + '></td>' +
      '<td>' + esc(row.rowNumber) + '</td>' +
      '<td><select class="form-select form-select-sm review-row-status" ' + (status === 'posted' || status === 'duplicate' ? 'disabled' : '') + '>' +
        ['staged', 'ready', 'rejected', 'duplicate', 'error', 'posted'].map(item => '<option value="' + item + '"' + (item === status ? ' selected' : '') + '>' + item + '</option>').join('') +
      '</select><div class="row-status ' + esc(status) + '">' + esc(status) + '</div></td>' +
      '<td><input class="form-control form-control-sm review-date" type="date" value="' + esc(draft.transactionDate || '') + '" ' + (disabled ? 'disabled' : '') + '></td>' +
      '<td><select class="form-select form-select-sm review-account" ' + (disabled ? 'disabled' : '') + '>' + optionList(accountChoices, draft.accountId, 'Select account', account => account.name + (account.currency ? ' (' + account.currency + ')' : '')) + '</select></td>' +
      '<td><select class="form-select form-select-sm review-category" ' + (disabled ? 'disabled' : '') + '>' + optionList(categoryChoices, draft.categoryId, 'No category', category => (category.groupName ? category.groupName + ' / ' : '') + category.name) + '</select></td>' +
      '<td><select class="form-select form-select-sm review-type" ' + (disabled ? 'disabled' : '') + '>' +
        ['expense', 'income', 'transfer', 'adjustment'].map(item => '<option value="' + item + '"' + (item === draft.transactionType ? ' selected' : '') + '>' + item + '</option>').join('') +
      '</select></td>' +
      '<td><input class="form-control form-control-sm amount-input text-end review-amount" type="number" step="0.01" value="' + esc(draft.amount == null ? '' : draft.amount) + '" ' + (disabled ? 'disabled' : '') + '></td>' +
      '<td><input class="form-control form-control-sm description-input review-description" value="' + esc(draft.description || '') + '" ' + (disabled ? 'disabled' : '') + '></td>' +
      '<td><input class="form-control form-control-sm review-merchant" value="' + esc(draft.merchant || '') + '" ' + (disabled ? 'disabled' : '') + '></td>' +
      '<td class="small text-muted">' + esc(note) + '</td>' +
    '</tr>';
  }).join('') : '<tr><td colspan="11" class="text-muted">No rows in this batch.</td></tr>';
  document.getElementById('batchReviewPanel').scrollIntoView({ behavior: 'smooth', block: 'start' });
}
async function openBatch(id) {
  if (!id) return;
  selectedBatchId = Number(id);
  const res = await fetch('/api/import/batches/' + selectedBatchId + '/rows', { headers: authHeaders() });
  batchRows = res.ok ? await res.json() : [];
  renderBatchReview();
}
function collectReviewRows(selectedOnly) {
  return Array.from(document.querySelectorAll('#reviewRows tr[data-row-id]')).map(tr => {
    const id = Number(tr.dataset.rowId);
    const original = batchRows.find(row => Number(row.id) === id) || {};
    const draft = rowDraft(original);
    const checkbox = tr.querySelector('.review-check');
    if (selectedOnly && (!checkbox || !checkbox.checked || checkbox.disabled)) return null;
    const accountId = tr.querySelector('.review-account').value;
    const categoryId = tr.querySelector('.review-category').value;
    return {
      id,
      rowStatus: tr.querySelector('.review-row-status').value,
      normalizedData: {
        ...draft,
        transactionDate: tr.querySelector('.review-date').value,
        accountId: accountId ? Number(accountId) : null,
        categoryId: categoryId ? Number(categoryId) : null,
        transactionType: tr.querySelector('.review-type').value,
        amount: tr.querySelector('.review-amount').value === '' ? null : Number(tr.querySelector('.review-amount').value),
        description: tr.querySelector('.review-description').value,
        merchant: tr.querySelector('.review-merchant').value,
        normalizedMerchant: tr.querySelector('.review-merchant').value.trim().toLowerCase(),
        status: document.getElementById('reviewDefaultStatus').value || 'draft'
      }
    };
  }).filter(Boolean);
}
async function saveReview() {
  if (!selectedBatchId) return;
  const rows = collectReviewRows(false);
  const res = await fetch('/api/import/batches/' + selectedBatchId + '/rows', {
    method: 'PUT',
    headers: authHeaders(true),
    body: JSON.stringify({ rows })
  });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) return reviewMessage(data.error || data.message || 'Unable to save reviewed rows.', 'danger');
  reviewMessage(data.updated + ' row(s) saved for review.', 'success');
  await openBatch(selectedBatchId);
  await loadBatches();
}
async function postSelectedRows() {
  if (!selectedBatchId) return;
  const rows = collectReviewRows(true);
  if (!rows.length) return reviewMessage('Select at least one postable row.', 'warning');
  const res = await fetch('/api/import/batches/' + selectedBatchId + '/post', {
    method: 'POST',
    headers: authHeaders(true),
    body: JSON.stringify({
      rows,
      accountId: document.getElementById('reviewDefaultAccount').value || null,
      categoryId: document.getElementById('reviewDefaultCategory').value || null,
      transactionStatus: document.getElementById('reviewDefaultStatus').value || 'draft'
    })
  });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) {
    reviewMessage(data.error || data.message || 'Unable to post selected rows.', 'danger');
    if (data.existingBatchId) openBatch(data.existingBatchId);
    return;
  }
  reviewMessage(data.message + (data.duplicates ? ' Duplicates skipped: ' + data.duplicates + '.' : '') + (data.errors && data.errors.length ? ' Rows needing fixes: ' + data.errors.length + '.' : ''), data.errors && data.errors.length ? 'warning' : 'success');
  await openBatch(selectedBatchId);
  await loadBatches();
}
function applyReviewDefaults() {
  const defaultAccount = document.getElementById('reviewDefaultAccount').value;
  const defaultCategory = document.getElementById('reviewDefaultCategory').value;
  document.querySelectorAll('#reviewRows tr[data-row-id]').forEach(tr => {
    const checkbox = tr.querySelector('.review-check');
    if (!checkbox || checkbox.disabled) return;
    if (defaultAccount) tr.querySelector('.review-account').value = defaultAccount;
    if (defaultCategory) tr.querySelector('.review-category').value = defaultCategory;
    const status = tr.querySelector('.review-row-status');
    if (status.value === 'staged' || status.value === 'error') status.value = 'ready';
  });
}
function selectPostableRows() {
  document.querySelectorAll('#reviewRows tr[data-row-id]').forEach(tr => {
    const checkbox = tr.querySelector('.review-check');
    if (checkbox && !checkbox.disabled) checkbox.checked = true;
  });
}
async function stageFile() {
  if (!selectedFile) return;
  const form = new FormData();
  form.append('file', selectedFile);
  const res = await fetch('/api/import/' + selectedDataset, { method: 'POST', headers: authHeaders(), body: form });
  const data = await res.json().catch(() => ({}));
  const result = document.getElementById('result');
  result.classList.remove('d-none', 'alert-success', 'alert-danger');
  result.classList.add(res.ok ? 'alert-success' : 'alert-danger');
  result.innerHTML = res.ok
    ? '<strong>Batch #' + data.batchId + ' staged.</strong><br>' + esc(data.message) + '<br>Rows received: ' + esc(data.rowCount)
    : esc(data.error || data.message || 'Unable to stage file.');
  if (res.ok) loadBatches();
}
async function loadBatches() {
  const res = await fetch('/api/import/batches', { headers: authHeaders() });
  const rows = res.ok ? await res.json() : [];
  document.getElementById('historyRows').innerHTML = rows.length ? rows.map(row =>
    '<tr>' +
      '<td>#' + esc(row.id) + '</td>' +
      '<td>' + esc(row.importType) + '</td>' +
      '<td>' + esc(row.fileName || '') + '</td>' +
      '<td>' + esc(row.rowCount) + '<div class="small text-muted">' + esc(row.acceptedCount || 0) + ' posted / ' + esc(row.rejectedCount || 0) + ' blocked</div></td>' +
      '<td><span class="badge bg-secondary">' + esc(row.status) + '</span></td>' +
      '<td>' + esc(row.createdAt ? String(row.createdAt).slice(0, 19).replace('T', ' ') : '') + '</td>' +
      '<td>' + esc(row.createdBy || '') + '</td>' +
      '<td class="text-end"><button class="btn btn-outline-primary btn-sm" onclick="openBatch(' + Number(row.id) + ')"><i class="fas fa-clipboard-check me-1"></i>Open</button></td>' +
    '</tr>'
  ).join('') : '<tr><td colspan="8" class="text-muted">No staged batches yet.</td></tr>';
}
document.getElementById('dropZone').addEventListener('click', () => document.getElementById('file').click());
document.getElementById('dropZone').addEventListener('dragover', e => { e.preventDefault(); e.currentTarget.classList.add('dragging'); });
document.getElementById('dropZone').addEventListener('dragleave', e => e.currentTarget.classList.remove('dragging'));
document.getElementById('dropZone').addEventListener('drop', e => {
  e.preventDefault();
  e.currentTarget.classList.remove('dragging');
  handleFile(e.dataTransfer.files[0]);
});
document.getElementById('file').addEventListener('change', e => handleFile(e.target.files[0]));
document.getElementById('stageBtn').addEventListener('click', stageFile);
document.getElementById('statementStageBtn').addEventListener('click', stageStatementFile);
document.getElementById('refreshHistoryBtn').addEventListener('click', loadBatches);
document.getElementById('applyDefaultsBtn').addEventListener('click', applyReviewDefaults);
document.getElementById('selectPostableBtn').addEventListener('click', selectPostableRows);
document.getElementById('saveReviewBtn').addEventListener('click', saveReview);
document.getElementById('postRowsBtn').addEventListener('click', postSelectedRows);
document.getElementById('reloadReviewBtn').addEventListener('click', () => openBatch(selectedBatchId));
document.getElementById('selectAllReview').addEventListener('change', event => {
  document.querySelectorAll('.review-check').forEach(input => { if (!input.disabled) input.checked = event.target.checked; });
});
document.addEventListener('DOMContentLoaded', function() { renderSelected(); loadStatementSetup(); loadBatches(); });
</script>
</body>
</html>

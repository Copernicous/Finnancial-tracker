  if (!file) {
    const result = document.getElementById('statementResult');
    result.className = 'alert alert-warning mt-3';
    result.textContent = 'Select a statement PDF first.';
    return;
  }
  const btn = document.getElementById('statementStageBtn');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Parsing';
  try {
    const form = new FormData();
    form.append('profile', document.getElementById('statementProfile').value || 'advantage_citi_pdf');
    form.append('accountId', document.getElementById('statementAccount').value || '');
    form.append('file', file);
    const res = await fetch('/api/import/bank-statement', { method: 'POST', headers: authHeaders(), body: form });
    const data = await res.json().catch(() => ({}));
    renderStatementPreview(Object.assign({ ok: res.ok }, data));
    if (res.ok) {
      await loadBatches();
      openBatch(data.batchId);
    } else if (data.existingBatchId) {
      await loadBatches();
      openBatch(data.existingBatchId);
    }
  } catch (err) {
    renderStatementPreview({ ok: false, error: err.message || 'Unable to parse statement.' });
  } finally {

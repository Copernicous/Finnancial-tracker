<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Curated Data Import - Home Accounting</title>
  <link href="/assets/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/inter.css" rel="stylesheet">
  <link rel="stylesheet" href="/assets/fontawesome.all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="wrapper">
  <%- include('partials/sidebar') %>
  <div id="content">
    <nav class="navbar navbar-expand-lg px-4 mb-4">
      <button type="button" id="sidebarCollapse" class="btn btn-primary btn-sm"><i class="fas fa-bars"></i></button>
      <span class="ms-3 fw-bold fs-5">Curated Data Import</span>
      <div class="ms-auto d-flex align-items-center gap-3">
        <span id="userGreeting" class="text-muted small"></span>
        <button id="logoutBtn" class="btn btn-danger btn-sm"><i class="fas fa-sign-out-alt me-1"></i>Logout</button>
      </div>
    </nav>

    <div class="container-fluid px-4">
      <div class="row g-4">
        <div class="col-lg-5">
          <div class="glass-card p-4 h-100">
            <h5 class="mb-3"><i class="fas fa-file-csv me-2 text-primary"></i>Templates</h5>
            <p class="text-muted small">These templates define the future curated import format. Uploads are staged as import batches only; they do not post ledger entries automatically.</p>
            <div class="list-group" id="templateList"></div>
          </div>
        </div>
        <div class="col-lg-7">
          <div class="glass-card p-4">
            <h5 class="mb-3"><i class="fas fa-upload me-2 text-primary"></i>Stage Curated CSV</h5>
            <form id="importForm">
              <div class="mb-3">
                <label class="form-label">Dataset</label>
                <select class="form-select" id="dataset">
                  <option value="accounts">Accounts</option>
                  <option value="transactions">Transactions</option>
                  <option value="categories">Categories</option>
                  <option value="proofs">Proofs</option>
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label">CSV File</label>
                <input class="form-control" id="file" type="file" accept=".csv" required>
              </div>
              <button class="btn btn-primary" type="submit"><i class="fas fa-inbox me-1"></i>Stage File</button>
            </form>
            <div class="alert alert-info mt-4 d-none" id="result"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100"></div>
<script src="/assets/bootstrap.bundle.min.js"></script>
<a id="xa-base" href="/login" style="display:none"></a>
<script src="/js/base.js"></script>
<script src="/js/main.js"></script>
<script>
const datasets = [
  ['accounts', 'Accounts', 'Chart of accounts with institution references and opening balances.'],
  ['transactions', 'Transactions', '2026 ledger activity after curation.'],
  ['categories', 'Categories', 'Income, expense, transfer, and adjustment categories.'],
  ['proofs', 'Proofs', 'Document references connected to accounting records.']
];
function authHeaders() {
  const token = localStorage.getItem('haToken') || localStorage.getItem('token') || '';
  return token ? { Authorization: 'Bearer ' + token } : {};
}
function esc(value) {
  return String(value == null ? '' : value).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
}
document.getElementById('templateList').innerHTML = datasets.map(item =>
  '<a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="/api/import/template/' + item[0] + '">' +
  '<span><strong>' + esc(item[1]) + '</strong><br><small class="text-muted">' + esc(item[2]) + '</small></span><i class="fas fa-download text-primary"></i></a>'
).join('');
document.getElementById('importForm').addEventListener('submit', async function(event) {
  event.preventDefault();
  const dataset = document.getElementById('dataset').value;
  const file = document.getElementById('file').files[0];
  const form = new FormData();
  form.append('file', file);
  const res = await fetch('/api/import/' + dataset, { method: 'POST', headers: authHeaders(), body: form });
  const data = await res.json().catch(() => ({}));
  const result = document.getElementById('result');
  result.classList.remove('d-none', 'alert-info', 'alert-danger');
  result.classList.add(res.ok ? 'alert-info' : 'alert-danger');
  result.innerHTML = res.ok
    ? '<strong>Batch #' + data.batchId + ' staged.</strong><br>' + esc(data.message) + '<br>Rows received: ' + esc(data.rowCount)
    : esc(data.error || data.message || 'Unable to stage file.');
});
</script>
</body>
</html>

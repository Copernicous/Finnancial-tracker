function rowMatchesReviewFilters(tr) {
  const search = plain(document.getElementById('reviewSearchFilter').value);
  const status = document.getElementById('reviewStatusFilter').value;
  const categoryFilter = document.getElementById('reviewCategoryFilter').value;
  const type = document.getElementById('reviewTypeFilter').value;
  const rowStatus = tr.querySelector('.review-row-status') ? tr.querySelector('.review-row-status').value : '';
  const rowCategory = tr.querySelector('.review-category') ? tr.querySelector('.review-category').value : '';
  const rowType = tr.querySelector('.review-type') ? tr.querySelector('.review-type').value : '';
  const haystack = plain([
    tr.dataset.rowNumber,
    rowStatus,
    rowType,
    tr.querySelector('.review-date') ? tr.querySelector('.review-date').value : '',
    selectedOptionText(tr.querySelector('.review-account')),
    selectedOptionText(tr.querySelector('.review-category')),
    tr.querySelector('.review-description') ? tr.querySelector('.review-description').value : '',
    tr.querySelector('.review-merchant') ? tr.querySelector('.review-merchant').value : '',
    tr.querySelector('.review-note') ? tr.querySelector('.review-note').innerText : ''
  ].join(' '));
  if (search && !haystack.includes(search)) return false;
  if (status && rowStatus !== status) return false;
  if (type && rowType !== type) return false;
  if (categoryFilter === 'missing' && rowCategory) return false;
  if (categoryFilter === 'present' && !rowCategory) return false;
  return true;
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Backoffice - Home Accounting</title>
  <link href="/assets/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/inter.css" rel="stylesheet">
  <link rel="stylesheet" href="/assets/fontawesome.all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="wrapper">
  <%- include('partials/sidebar') %>
  <div id="content">
    <nav class="navbar navbar-expand-lg px-4 mb-4">
      <button type="button" id="sidebarCollapse" class="btn btn-primary btn-sm"><i class="fas fa-bars"></i></button>
      <span class="ms-3 fw-bold fs-5">Backoffice</span>
      <div class="ms-auto"><button id="logoutBtn" class="btn btn-danger btn-sm">Logout</button></div>
    </nav>
    <div class="container-fluid px-4">
      <div class="glass-card p-4">
        <h5>Data Control Center</h5>
        <p class="text-muted">Administrative accounting controls for simulation data, curated imports, backups, users, roles, and audit review.</p>
        <div class="d-flex gap-2 flex-wrap">
          <button class="btn btn-outline-primary" onclick="seedSimulation()">Create 2026 Simulation Data</button>
          <button class="btn btn-outline-danger" onclick="clearSimulation()">Clear Simulation Data</button>
          <a class="btn btn-outline-secondary" href="/audit-log">Audit Log</a>
          <a class="btn btn-outline-secondary" href="/backups">Backups</a>
        </div>
        <div id="result" class="mt-3 text-muted"></div>
      </div>
    </div>
  </div>
</div>
<script src="/assets/bootstrap.bundle.min.js"></script>
<script src="/js/base.js"></script>
<script src="/js/main.js"></script>
<script>
function headers(){ const t=localStorage.getItem('haToken')||localStorage.getItem('token')||''; return { 'Content-Type':'application/json', ...(t?{Authorization:'Bearer '+t}:{}) }; }
async function seedSimulation(){ const r=await fetch('/api/simulation/seed',{method:'POST',headers:headers()}); document.getElementById('result').textContent=await r.text(); }
async function clearSimulation(){ const r=await fetch('/api/simulation',{method:'DELETE',headers:headers()}); document.getElementById('result').textContent=await r.text(); }
</script>
</body>
</html>

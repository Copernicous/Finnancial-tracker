  },
  'balance-snapshots': {
    columns: ['accountId', 'snapshotDate', 'balance', 'currency', 'source'],
    fields: [
      { key: 'accountId', label: 'Account', type: 'lookup', source: 'accounts', required: true },
      { key: 'snapshotDate', label: 'Snapshot Date', type: 'date', required: true },
      { key: 'balance', label: 'Balance', type: 'number', step: '0.01', required: true },
      { key: 'currency', label: 'Currency', type: 'select', options: ['USD', 'COP', 'EUR'] },
      { key: 'source', label: 'Source', type: 'select', options: ['manual', 'statement', 'bank', 'simulation'] },

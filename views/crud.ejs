<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Home Accounting</title>
  <link href="/assets/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/inter.css" rel="stylesheet">
  <link rel="stylesheet" href="/assets/fontawesome.all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: .5rem .65rem; align-items: end; }
    .form-grid .form-label { margin-bottom: .18rem; font-size: .72rem; color: var(--text-muted, #64748b); }
    .form-grid .form-control,
    .form-grid .form-select { min-height: 36px; padding-top: .32rem; padding-bottom: .32rem; }
    .form-grid textarea.form-control { min-height: 36px; resize: vertical; }
    .table td, .table th { vertical-align: middle; }
    .muted-cell { color: var(--text-muted, #64748b); font-size: 0.86rem; }
    .crud-toolbar { display: grid; grid-template-columns: minmax(180px, auto) minmax(260px, 1fr) auto; gap: .75rem; align-items: end; }
    .crud-toolbar-title { min-width: 0; }
    .crud-toolbar-actions { display: flex; gap: .5rem; justify-content: flex-end; align-items: center; flex-wrap: wrap; }
    .crud-search .input-group { min-width: 260px; }
    .crud-count { color: var(--text-muted, #64748b); font-size: .85rem; }
    .crud-bulk-group { display: none; align-items: center; gap: .5rem; flex-wrap: wrap; }
    .crud-bulk-group .input-group { width: 320px; }
    .crud-selected-badge { min-width: 86px; text-align: center; }
    .bulk-select-cell { width: 42px; text-align: center; }
    .row-actions { display: inline-flex; gap: .35rem; justify-content: flex-end; }
    .crud-form-actions { display: flex; gap: .5rem; align-items: center; flex-wrap: wrap; }
    .crud-sort-btn { border: 0; background: transparent; color: inherit; font: inherit; font-weight: 700; padding: 0; display: inline-flex; align-items: center; gap: .25rem; }
    .crud-sort-btn:hover { color: var(--primary, #0d6efd); }
    .crud-sort-indicator { color: var(--text-muted, #64748b); font-size: .72rem; min-width: .8rem; }
    .statement-reconcile-table { max-height: 300px; overflow: auto; }
    .statement-reconcile-table .badge { min-width: 68px; }
    @media (max-width: 992px) {
      .crud-toolbar { grid-template-columns: 1fr; align-items: stretch; }
      .crud-toolbar-actions { justify-content: flex-start; }
      .crud-search .input-group { min-width: 0; }
      .crud-bulk-group .input-group { width: min(100%, 360px); }
    }
  </style>
</head>
<body>
<div class="wrapper">
  <%- include('partials/sidebar') %>
  <div id="content">
    <nav class="navbar navbar-expand-lg px-4 mb-4">
      <button type="button" id="sidebarCollapse" class="btn btn-primary btn-sm"><i class="fas fa-bars"></i></button>
      <span class="ms-3 fw-bold fs-5"><%= title %></span>
      <div class="ms-auto d-flex align-items-center gap-3">
        <span id="userGreeting" class="text-muted small"></span>
        <button id="logoutBtn" class="btn btn-danger btn-sm"><i class="fas fa-sign-out-alt me-1"></i>Logout</button>
      </div>
    </nav>

    <div class="container-fluid px-4">
      <div class="glass-card p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
          <div>
            <h5 class="mb-1" id="formTitle">Add Record</h5>
            <div class="text-muted small">Use New or edit a row to open the form.</div>
          </div>
          <div class="crud-form-actions">
            <button class="btn btn-outline-secondary btn-sm" id="recordFormToggle" type="button" data-bs-toggle="collapse" data-bs-target="#recordFormCollapse" aria-expanded="false" aria-controls="recordFormCollapse">
              <i class="fas fa-chevron-down me-1"></i>Form
            </button>
            <button class="btn btn-outline-primary btn-sm" type="button" onclick="startNewRecord()"><i class="fas fa-plus me-1"></i>New</button>
          </div>
        </div>
        <div class="collapse" id="recordFormCollapse">
          <form id="recordForm">
            <input type="hidden" id="recordId">
            <div class="form-grid" id="formFields"></div>
            <div class="d-flex gap-2 mt-3">
              <button class="btn btn-primary" type="submit"><i class="fas fa-save me-1"></i>Save</button>
              <button class="btn btn-outline-secondary" type="button" onclick="cancelRecordForm()">Cancel</button>
            </div>
          </form>
        </div>
      </div>

      <% if (module === 'reconciliations') { %>
      <div class="glass-card p-3 mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
          <div>
            <h5 class="mb-1">Statement Cutoff Suggestions</h5>
            <div class="text-muted small">Uses actual PDF statement cutoff dates instead of calendar month ends.</div>
          </div>
          <button class="btn btn-outline-primary btn-sm" id="loadStatementReconcileBtn" type="button"><i class="fas fa-scale-balanced me-1"></i>Load Cutoffs</button>
        </div>
        <div class="statement-reconcile-table table-responsive">
          <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>Status</th><th>Account</th><th>Period</th><th class="text-end">Statement</th><th class="text-end">Book</th><th class="text-end">Diff</th><th>Source</th><th class="text-end">Action</th></tr></thead>
            <tbody id="statementReconcileRows"><tr><td colspan="8" class="text-muted">Load statement cutoffs to review reconciliation periods.</td></tr></tbody>
          </table>
        </div>
        <div class="mt-3 d-none" id="statementReconcileDetail"></div>
      </div>
      <% } %>

      <div class="glass-card p-4">
        <div class="crud-toolbar mb-3">
          <div class="crud-toolbar-title">
            <h5 class="mb-1"><%= title %></h5>
            <div class="crud-count" id="recordCount">Loading records...</div>
          </div>
          <div class="crud-search">
            <label class="form-label small fw-semibold mb-1" for="recordSearch">Search</label>
            <div class="input-group input-group-sm">
              <span class="input-group-text"><i class="fas fa-search"></i></span>
              <input class="form-control" id="recordSearch" type="search" placeholder="Search records">
              <button class="btn btn-outline-secondary" id="clearSearchBtn" type="button">Clear</button>
            </div>
          </div>
          <div class="crud-toolbar-actions">
            <div class="crud-bulk-group" id="merchantBulkGroupControls">
              <span class="badge text-bg-secondary crud-selected-badge" id="bulkSelectedBadge">0 selected</span>
              <button class="btn btn-outline-secondary btn-sm" id="selectFilteredBtn" type="button">Select results</button>
              <button class="btn btn-outline-secondary btn-sm" id="clearSelectionBtn" type="button">Clear selected</button>
              <div class="input-group input-group-sm">
                <span class="input-group-text">Group</span>
                <input class="form-control" id="bulkMerchantGroupName" type="text" placeholder="Display group name">
                <button class="btn btn-primary" id="applyBulkGroupBtn" type="button">Apply</button>
              </div>
            </div>
            <button class="btn btn-outline-secondary btn-sm" type="button" onclick="startNewRecord()"><i class="fas fa-plus me-1"></i>New</button>
            <button class="btn btn-outline-primary btn-sm" type="button" onclick="loadRows()"><i class="fas fa-sync-alt me-1"></i>Refresh</button>
          </div>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead id="tableHead"></thead>
            <tbody id="tableBody"><tr><td class="text-muted">Loading...</td></tr></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100"></div>

<script src="/assets/bootstrap.bundle.min.js"></script>
<a id="xa-base" href="/login" style="display:none"></a>
<script src="/js/base.js"></script>
<script src="/js/main.js"></script>
<script>
const MODULE = '<%= module %>';
const API_ENDPOINT = '<%= apiEndpoint %>';
const PAGE_TITLE = <%- JSON.stringify(title) %>;
let rows = [];
let selectedRowIds = new Set();
let lookups = { accounts: [], categories: [], institutions: [], merchants: [] };
let recordFormCollapse = null;
let statementReconcileRows = [];
let crudSort = { key: '', dir: 'asc' };


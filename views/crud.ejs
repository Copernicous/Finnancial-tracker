    columns: ['officialName', 'merchantGroupName', 'merchantType', 'defaultCategoryId', 'defaultTransactionType', 'isActive'],
    fields: [
      { key: 'officialName', label: 'Official Merchant Name', required: true },
      { key: 'normalizedName', label: 'Normalized Key' },

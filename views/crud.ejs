function authHeaders(json) {
  const token = localStorage.getItem('haToken') || localStorage.getItem('token') || '';
  const h = token ? { Authorization: 'Bearer ' + token } : {};
  if (json) h['Content-Type'] = 'application/json';
  return h;
}
function esc(value) {
  return String(value == null ? '' : value).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
}
function toast(message, type) {
  if (typeof showToast === 'function') showToast(message, type || 'success');
}
function selectionEnabled() {
  return MODULE === 'merchants';
}
function lookupLabel(source, id) {
  if (!id) return '';
  const row = (lookups[source] || []).find(item => Number(item.id) === Number(id));
  return row ? row.name : id;
}
function columnLabel(key) {
  const field = (CONFIG[MODULE].fields || []).find(item => item.key === key);
  if (field && field.label) return field.label;
  return String(key || '').replace(/([a-z0-9])([A-Z])/g, '$1 $2').replace(/^./, ch => ch.toUpperCase());
}
function displayValue(key, value) {
  if (key === 'financialInstitutionId') return lookupLabel('institutions', value);
  if (key === 'accountId' || key === 'relatedAccountId') return lookupLabel('accounts', value);
  if (key === 'categoryId' || key === 'parentId') return lookupLabel('categories', value);
  if (key === 'defaultCategoryId') return lookupLabel('categories', value);
  if (key === 'merchantId') return lookupLabel('merchants', value);
  if (typeof value === 'boolean') return value ? 'Yes' : 'No';
  if (value && typeof value === 'object') return value.name || JSON.stringify(value);
  return value == null || value === '' ? '<span class="muted-cell">--</span>' : esc(value);
}
function searchValue(key, value) {
  const displayed = displayValue(key, value).replace(/<[^>]+>/g, ' ');
  return String(value == null ? '' : value) + ' ' + displayed;
}
function searchText(row) {
  const columns = CONFIG[MODULE].columns || [];
  const fields = CONFIG[MODULE].fields || [];
  const keys = Array.from(new Set(['id'].concat(columns, fields.map(field => field.key))));
  return keys.map(key => searchValue(key, row[key])).join(' ').toLowerCase();
}
function filteredRows() {
  const input = document.getElementById('recordSearch');
  const q = input ? input.value.trim().toLowerCase() : '';
  if (!q) return rows;
  return rows.filter(row => searchText(row).includes(q));
}
function pruneSelection() {
  const validIds = new Set(rows.map(row => String(row.id)));
  selectedRowIds = new Set(Array.from(selectedRowIds).filter(id => validIds.has(String(id))));
}
function updateRecordCount(visibleCount) {
  const count = document.getElementById('recordCount');
  if (!count) return;
  const total = rows.length;
  const selectionText = selectionEnabled() && selectedRowIds.size ? ` | ${selectedRowIds.size} selected` : '';
  count.textContent = (visibleCount === total ? `${total} records` : `${visibleCount} of ${total} records`) + selectionText;
}
function updateSelectionControls(visibleRows) {
  const enabled = selectionEnabled();
  const controls = document.getElementById('merchantBulkGroupControls');
  if (controls) controls.style.display = enabled ? 'flex' : 'none';
  if (!enabled) return;

  const selectedCount = selectedRowIds.size;
  const badge = document.getElementById('bulkSelectedBadge');
  const applyBtn = document.getElementById('applyBulkGroupBtn');
  const clearBtn = document.getElementById('clearSelectionBtn');
  const selectBtn = document.getElementById('selectFilteredBtn');
  const visible = visibleRows || filteredRows();
  const visibleSelected = visible.filter(row => selectedRowIds.has(String(row.id))).length;
  const selectVisible = document.getElementById('selectVisibleRows');

  if (badge) badge.textContent = `${selectedCount} selected`;
  if (applyBtn) applyBtn.disabled = selectedCount === 0;
  if (clearBtn) clearBtn.disabled = selectedCount === 0;
  if (selectBtn) selectBtn.disabled = visible.length === 0;
  if (selectVisible) {
    selectVisible.checked = visible.length > 0 && visibleSelected === visible.length;
    selectVisible.indeterminate = visibleSelected > 0 && visibleSelected < visible.length;
  }
  updateRecordCount(visible.length);
}
function toggleRowSelection(id, selected) {
  const key = String(id);
  if (selected) selectedRowIds.add(key);
  else selectedRowIds.delete(key);
  renderRows();
}
function toggleVisibleSelection(selected) {
  filteredRows().forEach(row => {
    const key = String(row.id);
    if (selected) selectedRowIds.add(key);
    else selectedRowIds.delete(key);
  });
  renderRows();
}
function selectFilteredRows() {
  toggleVisibleSelection(true);
}
function clearSelection() {
  selectedRowIds.clear();
  renderRows();
}
async function applyBulkMerchantGroup() {
  if (!selectionEnabled()) return;
  const ids = Array.from(selectedRowIds);
  if (!ids.length) return toast('Select at least one merchant first.', 'warning');

  const input = document.getElementById('bulkMerchantGroupName');
  const groupName = input.value.trim();
  if (!groupName) return toast('Type the display group name to assign.', 'warning');
  if (!confirm(`Assign "${groupName}" to ${ids.length} selected merchant(s)?`)) return;

  const button = document.getElementById('applyBulkGroupBtn');
  const originalText = button.textContent;
  button.disabled = true;
  button.textContent = 'Applying...';

  let updated = 0;
  let failed = 0;
  for (const id of ids) {
    const response = await fetch(API_ENDPOINT + '/' + id, {
      method: 'PUT',
      headers: authHeaders(true),
      body: JSON.stringify({ merchantGroupName: groupName })
    });
    if (response.status === 401) {
      window.location.href = '/login';
      return;
    }
    if (response.ok) updated += 1;
    else failed += 1;
  }

  button.textContent = originalText;
  selectedRowIds.clear();
  await loadLookups();
  await loadRows();
  toast(failed ? `Updated ${updated}; ${failed} failed.` : `Assigned "${groupName}" to ${updated} merchant(s).`, failed ? 'warning' : 'success');
}
async function loadLookups() {
  const [accounts, categories, institutions, merchants] = await Promise.all([
    fetch('/api/accounts', { headers: authHeaders() }).then(r => r.ok ? r.json() : []),
    fetch('/api/categories', { headers: authHeaders() }).then(r => r.ok ? r.json() : []),
    fetch('/api/financial-institutions', { headers: authHeaders() }).then(r => r.ok ? r.json() : []),
    fetch('/api/merchants', { headers: authHeaders() }).then(r => r.ok ? r.json() : [])
  ]);
  lookups = {
    accounts,
    categories,
    institutions,
    merchants: merchants.map(item => ({ ...item, name: item.officialName || item.name }))
  };
}
function fieldHtml(field) {
  const label = `<label class="form-label small fw-semibold" for="f_${field.key}">${esc(field.label)}</label>`;
  if (field.type === 'textarea') {
    return `<div><div>${label}<textarea class="form-control" id="f_${field.key}" rows="2"></textarea></div></div>`;
  }
  if (field.type === 'checkbox') {
    return `<div class="d-flex align-items-end"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="f_${field.key}" ${field.checked === false ? '' : 'checked'}><label class="form-check-label" for="f_${field.key}">${esc(field.label)}</label></div></div>`;
  }
  if (field.type === 'select') {
    return `<div>${label}<select class="form-select" id="f_${field.key}">${field.options.map(opt => `<option value="${esc(opt)}">${esc(opt)}</option>`).join('')}</select></div>`;
  }
  if (field.type === 'lookup') {
    const options = field.optional ? '<option value="">-- None --</option>' : '';
    return `<div>${label}<select class="form-select" id="f_${field.key}" ${field.required ? 'required' : ''}>${options}</select></div>`;
  }
  return `<div>${label}<input class="form-control" id="f_${field.key}" type="${field.type || 'text'}" ${field.step ? `step="${field.step}"` : ''} ${field.required ? 'required' : ''}></div>`;
}
function fillLookupOptions() {
  CONFIG[MODULE].fields.filter(f => f.type === 'lookup').forEach(field => {
    const el = document.getElementById('f_' + field.key);
    if (!el) return;
    const selected = el.value;
    const first = field.optional ? '<option value="">-- None --</option>' : '<option value="">Select...</option>';
    el.innerHTML = first + (lookups[field.source] || []).map(item => `<option value="${item.id}">${esc(item.name)}</option>`).join('');
    el.value = selected;
  });
}
function buildForm() {
  document.getElementById('formFields').innerHTML = CONFIG[MODULE].fields.map(fieldHtml).join('');
  fillLookupOptions();
}
function readForm() {
  const payload = {};
  CONFIG[MODULE].fields.forEach(field => {
    const el = document.getElementById('f_' + field.key);
    if (!el) return;
    if (field.type === 'checkbox') payload[field.key] = el.checked;
    else if (['number', 'lookup'].includes(field.type)) payload[field.key] = el.value === '' ? null : Number(el.value);
    else payload[field.key] = el.value;
  });
  if (MODULE === 'transactions') payload.sourceType = 'manual';
  return payload;
}
function resetForm() {
  document.getElementById('recordId').value = '';
  document.getElementById('formTitle').textContent = 'Add Record';
  document.getElementById('recordForm').reset();
  CONFIG[MODULE].fields.forEach(field => {
    if (field.type === 'checkbox') {
      const el = document.getElementById('f_' + field.key);
      if (el) el.checked = field.checked === false ? false : field.key !== 'isDeleted';
    }
  });
}
function startNewRecord() {
  resetForm();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}
function editRow(id) {
  const row = rows.find(item => Number(item.id) === Number(id));
  if (!row) return;
  document.getElementById('recordId').value = row.id;
  document.getElementById('formTitle').textContent = 'Edit Record #' + row.id;
  CONFIG[MODULE].fields.forEach(field => {
    const el = document.getElementById('f_' + field.key);
    if (!el) return;
    if (field.type === 'checkbox') el.checked = !!row[field.key];
    else el.value = row[field.key] == null ? '' : row[field.key];
  });
  window.scrollTo({ top: 0, behavior: 'smooth' });
}
async function disableRow(id) {
  const cfg = CONFIG[MODULE];
  if (!cfg.disable) return removeRow(id);
  if (!confirm('Disable this record?')) return;
  const response = await fetch(API_ENDPOINT + '/' + id, {
    method: 'PUT',
    headers: authHeaders(true),
    body: JSON.stringify({ [cfg.disable.field]: cfg.disable.value })
  });
  if (!response.ok) return toast('Unable to disable record.', 'danger');
  toast('Record disabled.');
  loadRows();
}
async function removeRow(id) {
  if (!confirm('Delete this record?')) return;
  const response = await fetch(API_ENDPOINT + '/' + id, { method: 'DELETE', headers: authHeaders() });
  if (!response.ok) return toast('Unable to delete record. It may be referenced by other accounting data.', 'danger');
  toast('Record deleted.');
  loadRows();
}
async function loadRows() {
  const body = document.getElementById('tableBody');
  body.innerHTML = '<tr><td class="text-muted">Loading...</td></tr>';
  document.getElementById('recordCount').textContent = 'Loading records...';
  const response = await fetch(API_ENDPOINT, { headers: authHeaders() });
  if (response.status === 401) return window.location.href = '/login';
  if (!response.ok) {
    body.innerHTML = '<tr><td class="text-danger">Unable to load records.</td></tr>';
    return;
  }
  rows = await response.json();
  pruneSelection();
  renderRows();
}
function renderRows() {
  const body = document.getElementById('tableBody');
  const head = document.getElementById('tableHead');
  const columns = CONFIG[MODULE].columns;
  const visibleRows = filteredRows();
  const selectEnabled = selectionEnabled();
  const selectHead = selectEnabled
    ? '<th class="bulk-select-cell"><input class="form-check-input" id="selectVisibleRows" type="checkbox" aria-label="Select visible records" onchange="toggleVisibleSelection(this.checked)"></th>'
    : '';
  head.innerHTML = '<tr>' + selectHead + columns.map(col => '<th>' + esc(columnLabel(col)) + '</th>').join('') + '<th class="text-end">Actions</th></tr>';
  updateRecordCount(visibleRows.length);
  updateSelectionControls(visibleRows);
  const colspan = columns.length + 1 + (selectEnabled ? 1 : 0);
  if (!rows.length) {
    body.innerHTML = '<tr><td colspan="' + colspan + '" class="text-muted">No records yet.</td></tr>';
    return;
  }
  if (!visibleRows.length) {
    body.innerHTML = '<tr><td colspan="' + colspan + '" class="text-muted">No records match the search.</td></tr>';
    return;
  }
  body.innerHTML = visibleRows.map(row => {
    const selected = selectedRowIds.has(String(row.id));
    const selectCell = selectEnabled
      ? '<td class="bulk-select-cell"><input class="form-check-input row-select-checkbox" type="checkbox" data-id="' + row.id + '" aria-label="Select record ' + row.id + '" ' + (selected ? 'checked' : '') + '></td>'
      : '';
    const cells = columns.map(col => '<td>' + displayValue(col, row[col]) + '</td>').join('');
    const action = `<td class="text-end">
      <span class="row-actions">
        <button class="btn btn-sm btn-outline-primary" type="button" onclick="editRow(${row.id})"><i class="fas fa-edit"></i></button>
        <button class="btn btn-sm btn-outline-danger" type="button" onclick="${CONFIG[MODULE].disable ? 'disableRow' : 'removeRow'}(${row.id})"><i class="fas fa-${CONFIG[MODULE].disable ? 'ban' : 'trash'}"></i></button>
      </span>
    </td>`;
    return '<tr class="' + (selected ? 'table-active' : '') + '">' + selectCell + cells + action + '</tr>';
  }).join('');
  updateSelectionControls(visibleRows);
}
document.getElementById('recordSearch').placeholder = 'Search ' + PAGE_TITLE.toLowerCase();
document.getElementById('recordSearch').addEventListener('input', renderRows);
document.getElementById('clearSearchBtn').addEventListener('click', function() {
  document.getElementById('recordSearch').value = '';
  renderRows();
  document.getElementById('recordSearch').focus();
});
document.getElementById('tableBody').addEventListener('change', function(event) {
  const checkbox = event.target.closest('.row-select-checkbox');
  if (!checkbox) return;
  toggleRowSelection(checkbox.dataset.id, checkbox.checked);
});
document.getElementById('selectFilteredBtn').addEventListener('click', selectFilteredRows);
document.getElementById('clearSelectionBtn').addEventListener('click', clearSelection);
document.getElementById('applyBulkGroupBtn').addEventListener('click', applyBulkMerchantGroup);
document.getElementById('bulkMerchantGroupName').addEventListener('keydown', function(event) {
  if (event.key === 'Enter') {
    event.preventDefault();
    applyBulkMerchantGroup();
  }
});
document.getElementById('recordForm').addEventListener('submit', async function(event) {
  event.preventDefault();
  const id = document.getElementById('recordId').value;
  const response = await fetch(id ? API_ENDPOINT + '/' + id : API_ENDPOINT, {
    method: id ? 'PUT' : 'POST',
    headers: authHeaders(true),
    body: JSON.stringify(readForm())
  });
  if (!response.ok) {
    const error = await response.json().catch(() => ({}));
    return toast(error.error || error.message || 'Unable to save record.', 'danger');
  }
  toast('Record saved.');
  await loadLookups();
  fillLookupOptions();
  resetForm();
  loadRows();
});
document.addEventListener('DOMContentLoaded', async function() {
  await loadLookups();
  buildForm();
  resetForm();
  loadRows();
});
</script>
</body>
</html>

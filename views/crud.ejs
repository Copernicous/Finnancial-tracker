    fields: [
      { key: 'merchantId', label: 'Official Merchant', type: 'lookup', source: 'merchants', required: true },
      { key: 'aliasText', label: 'Receipt / Statement Alias', required: true },
      { key: 'normalizedAlias', label: 'Normalized Alias' },
      { key: 'matchType', label: 'Match Type', type: 'select', options: ['contains', 'exact', 'starts_with', 'regex'] },
      { key: 'priority', label: 'Priority', type: 'number' },

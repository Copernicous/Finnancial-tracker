function renderRows() {
  const body = document.getElementById('tableBody');
  const head = document.getElementById('tableHead');
  const columns = CONFIG[MODULE].columns;
  const visibleRows = filteredRows();
  const selectEnabled = selectionEnabled();
  const selectHead = selectEnabled
    ? '<th class="bulk-select-cell"><input class="form-check-input" id="selectVisibleRows" type="checkbox" aria-label="Select visible records" onchange="toggleVisibleSelection(this.checked)"></th>'
    : '';
  head.innerHTML = '<tr>' + selectHead + columns.map(col => {
    const active = crudSort.key === col;
    const icon = active ? (crudSort.dir === 'asc' ? 'asc' : 'desc') : 'sort';
    return '<th><button class="crud-sort-btn" type="button" data-sort-column="' + esc(col) + '">' + esc(columnLabel(col)) + '<span class="crud-sort-indicator">' + icon + '</span></button></th>';
  }).join('') + '<th class="text-end">Actions</th></tr>';
  updateRecordCount(visibleRows.length);
  updateSelectionControls(visibleRows);
  const colspan = columns.length + 1 + (selectEnabled ? 1 : 0);
  if (!rows.length) {
    body.innerHTML = '<tr><td colspan="' + colspan + '" class="text-muted">No records yet.</td></tr>';
    return;
  }
  if (!visibleRows.length) {
    body.innerHTML = '<tr><td colspan="' + colspan + '" class="text-muted">No records match the search.</td></tr>';
    return;
  }
  body.innerHTML = visibleRows.map(row => {
    const selected = selectedRowIds.has(String(row.id));
    const selectCell = selectEnabled
      ? '<td class="bulk-select-cell"><input class="form-check-input row-select-checkbox" type="checkbox" data-id="' + row.id + '" aria-label="Select record ' + row.id + '" ' + (selected ? 'checked' : '') + '></td>'
      : '';
    const cells = columns.map(col => '<td>' + displayValue(col, row[col]) + '</td>').join('');
    const action = `<td class="text-end">
      <span class="row-actions">
        <button class="btn btn-sm btn-outline-primary" type="button" onclick="editRow(${row.id})"><i class="fas fa-edit"></i></button>
        <button class="btn btn-sm btn-outline-danger" type="button" onclick="${CONFIG[MODULE].disable ? 'disableRow' : 'removeRow'}(${row.id})"><i class="fas fa-${CONFIG[MODULE].disable ? 'ban' : 'trash'}"></i></button>
      </span>
    </td>`;
    return '<tr class="' + (selected ? 'table-active' : '') + '">' + selectCell + cells + action + '</tr>';
  }).join('');
  updateSelectionControls(visibleRows);
}
function sortByColumn(key) {
  if (crudSort.key === key) {
    crudSort.dir = crudSort.dir === 'asc' ? 'desc' : 'asc';
  } else {
    crudSort = { key, dir: 'asc' };
  }
  renderRows();
}
document.getElementById('recordSearch').placeholder = 'Search ' + PAGE_TITLE.toLowerCase();
document.getElementById('recordSearch').addEventListener('input', renderRows);
document.getElementById('clearSearchBtn').addEventListener('click', function() {
  document.getElementById('recordSearch').value = '';
  renderRows();
  document.getElementById('recordSearch').focus();
});
document.getElementById('tableBody').addEventListener('change', function(event) {
  const checkbox = event.target.closest('.row-select-checkbox');
  if (!checkbox) return;
  toggleRowSelection(checkbox.dataset.id, checkbox.checked);
});
document.getElementById('tableHead').addEventListener('click', function(event) {
  const btn = event.target.closest('[data-sort-column]');
  if (!btn) return;
  sortByColumn(btn.dataset.sortColumn);
});
document.getElementById('selectFilteredBtn').addEventListener('click', selectFilteredRows);
document.getElementById('clearSelectionBtn').addEventListener('click', clearSelection);
document.getElementById('applyBulkGroupBtn').addEventListener('click', applyBulkMerchantGroup);
document.getElementById('bulkMerchantGroupName').addEventListener('keydown', function(event) {
  if (event.key === 'Enter') {
    event.preventDefault();
    applyBulkMerchantGroup();
  }
});
document.getElementById('recordForm').addEventListener('submit', async function(event) {
  event.preventDefault();
  const id = document.getElementById('recordId').value;
  const response = await fetch(id ? API_ENDPOINT + '/' + id : API_ENDPOINT, {
    method: id ? 'PUT' : 'POST',
    headers: authHeaders(true),
    body: JSON.stringify(readForm())
  });
  if (!response.ok) {
    const error = await response.json().catch(() => ({}));
    return toast(error.error || error.message || 'Unable to save record.', 'danger');
  }
  toast('Record saved.');
  await loadLookups();
  fillLookupOptions();
  resetForm();
  hideRecordForm();
  loadRows();
});
document.addEventListener('DOMContentLoaded', async function() {
  document.getElementById('recordFormCollapse').addEventListener('shown.bs.collapse', () => setRecordFormToggle(true));
  document.getElementById('recordFormCollapse').addEventListener('hidden.bs.collapse', () => setRecordFormToggle(false));
  recordFormController();
  const reconcileBtn = document.getElementById('loadStatementReconcileBtn');
  if (reconcileBtn) reconcileBtn.addEventListener('click', loadStatementReconcileSuggestions);
  await loadLookups();
  buildForm();
  resetForm();
  loadRows();
});
</script>
</body>
</html>

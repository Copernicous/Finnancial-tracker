<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Home Accounting</title>
  <link href="/assets/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/inter.css" rel="stylesheet">
  <link rel="stylesheet" href="/assets/fontawesome.all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 0.9rem; }
    .table td, .table th { vertical-align: middle; }
    .muted-cell { color: var(--text-muted, #64748b); font-size: 0.86rem; }
  </style>
</head>
<body>
<div class="wrapper">
  <%- include('partials/sidebar') %>
  <div id="content">
    <nav class="navbar navbar-expand-lg px-4 mb-4">
      <button type="button" id="sidebarCollapse" class="btn btn-primary btn-sm"><i class="fas fa-bars"></i></button>
      <span class="ms-3 fw-bold fs-5"><%= title %></span>
      <div class="ms-auto d-flex align-items-center gap-3">
        <span id="userGreeting" class="text-muted small"></span>
        <button id="logoutBtn" class="btn btn-danger btn-sm"><i class="fas fa-sign-out-alt me-1"></i>Logout</button>
      </div>
    </nav>

    <div class="container-fluid px-4">
      <div class="glass-card p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
          <div>
            <h5 class="mb-1" id="formTitle">Add Record</h5>
            <div class="text-muted small">Manual 2026 accounting structure and operating data.</div>
          </div>
          <button class="btn btn-outline-secondary btn-sm" type="button" onclick="resetForm()"><i class="fas fa-plus me-1"></i>New</button>
        </div>
        <form id="recordForm">
          <input type="hidden" id="recordId">
          <div class="form-grid" id="formFields"></div>
          <div class="d-flex gap-2 mt-3">
            <button class="btn btn-primary" type="submit"><i class="fas fa-save me-1"></i>Save</button>
            <button class="btn btn-outline-secondary" type="button" onclick="resetForm()">Cancel</button>
          </div>
        </form>
      </div>

      <div class="glass-card p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="mb-0"><%= title %></h5>
          <button class="btn btn-outline-primary btn-sm" onclick="loadRows()"><i class="fas fa-sync-alt me-1"></i>Refresh</button>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead id="tableHead"></thead>
            <tbody id="tableBody"><tr><td class="text-muted">Loading...</td></tr></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100"></div>

<script src="/assets/bootstrap.bundle.min.js"></script>
<a id="xa-base" href="/login" style="display:none"></a>
<script src="/js/base.js"></script>
<script src="/js/main.js"></script>
<script>
const MODULE = '<%= module %>';
const API_ENDPOINT = '<%= apiEndpoint %>';
let rows = [];
let lookups = { accounts: [], categories: [], institutions: [] };

const CONFIG = {
  'financial-institutions': {
    columns: ['name', 'institutionType', 'website', 'isActive'],
    fields: [
      { key: 'name', label: 'Name', required: true },
      { key: 'institutionType', label: 'Type', type: 'select', options: ['bank', 'brokerage', 'credit_card', 'retirement', 'investment', 'other'] },
      { key: 'website', label: 'Website' },
      { key: 'contactInfo', label: 'Contact Info', type: 'textarea' },
      { key: 'notes', label: 'Notes', type: 'textarea' },
      { key: 'isActive', label: 'Active', type: 'checkbox' }
    ],
    disable: { field: 'isActive', value: false }
  },
  accounts: {
    columns: ['name', 'accountCode', 'accountType', 'currency', 'financialInstitutionId', 'openingBalance', 'status'],
    fields: [
      { key: 'name', label: 'Account Name', required: true },
      { key: 'accountCode', label: 'Account Code' },
      { key: 'accountType', label: 'Account Type', type: 'select', options: ['asset', 'liability', 'equity', 'income', 'expense'] },
      { key: 'currency', label: 'Currency', type: 'select', options: ['USD', 'COP', 'EUR'] },
      { key: 'financialInstitutionId', label: 'Financial Institution', type: 'lookup', source: 'institutions' },
      { key: 'openingBalance', label: 'Opening Balance', type: 'number', step: '0.01' },
      { key: 'openingBalanceDate', label: 'Opening Date', type: 'date' },
      { key: 'status', label: 'Status', type: 'select', options: ['active', 'inactive', 'closed'] },
      { key: 'notes', label: 'Notes', type: 'textarea' }
    ],
    disable: { field: 'status', value: 'inactive' }
  },
  categories: {
    columns: ['name', 'categoryType', 'parentId', 'taxRelevant', 'isActive'],
    fields: [
      { key: 'name', label: 'Category Name', required: true },
      { key: 'categoryType', label: 'Type', type: 'select', options: ['income', 'expense', 'transfer', 'adjustment'] },
      { key: 'parentId', label: 'Parent Category', type: 'lookup', source: 'categories', optional: true },
      { key: 'taxRelevant', label: 'Tax Relevant', type: 'checkbox' },
      { key: 'isActive', label: 'Active', type: 'checkbox' }
    ],
    disable: { field: 'isActive', value: false }
  },
  transactions: {
    columns: ['transactionDate', 'accountId', 'categoryId', 'description', 'transactionType', 'amount', 'status', 'sourceType'],
    fields: [
      { key: 'transactionDate', label: 'Date', type: 'date', required: true },
      { key: 'accountId', label: 'Account', type: 'lookup', source: 'accounts', required: true },
      { key: 'categoryId', label: 'Category', type: 'lookup', source: 'categories', optional: true },
      { key: 'relatedAccountId', label: 'Related Account', type: 'lookup', source: 'accounts', optional: true },
      { key: 'description', label: 'Description', required: true },
      { key: 'transactionType', label: 'Type', type: 'select', options: ['income', 'expense', 'transfer', 'adjustment'] },
      { key: 'amount', label: 'Amount', type: 'number', step: '0.01', required: true },
      { key: 'currency', label: 'Currency', type: 'select', options: ['USD', 'COP', 'EUR'] },
      { key: 'status', label: 'Status', type: 'select', options: ['draft', 'reviewed', 'reconciled', 'void'] },
      { key: 'referenceNumber', label: 'Reference' },
      { key: 'memo', label: 'Memo', type: 'textarea' }
    ],
    remove: true
  },
  reconciliations: {
    columns: ['accountId', 'periodStart', 'periodEnd', 'statementBalance', 'bookBalance', 'difference', 'status'],
    fields: [
      { key: 'accountId', label: 'Account', type: 'lookup', source: 'accounts', required: true },
      { key: 'periodStart', label: 'Period Start', type: 'date', required: true },
      { key: 'periodEnd', label: 'Period End', type: 'date', required: true },
      { key: 'statementBalance', label: 'Statement Balance', type: 'number', step: '0.01' },
      { key: 'bookBalance', label: 'Book Balance', type: 'number', step: '0.01' },
      { key: 'difference', label: 'Difference', type: 'number', step: '0.01' },
      { key: 'status', label: 'Status', type: 'select', options: ['open', 'reviewed', 'closed'] },
      { key: 'notes', label: 'Notes', type: 'textarea' }
    ],
    remove: true
  },
  'proof-documents': {
    columns: ['ownerType', 'ownerId', 'originalName', 'provider', 'isDeleted'],
    fields: [
      { key: 'ownerType', label: 'Owner Type', type: 'select', options: ['transaction', 'account', 'reconciliation', 'institution'] },
      { key: 'ownerId', label: 'Owner ID', type: 'number' },
      { key: 'originalName', label: 'Document Name', required: true },
      { key: 'storedName', label: 'Stored Name', required: true },
      { key: 'mimeType', label: 'MIME Type' },
      { key: 'sizeBytes', label: 'Size Bytes', type: 'number' },
      { key: 'provider', label: 'Provider', type: 'select', options: ['local', 'google_drive', 'manual_reference'] },
      { key: 'driveWebViewLink', label: 'Document Link' },
      { key: 'localPath', label: 'Local Path' },
      { key: 'isDeleted', label: 'Disabled', type: 'checkbox' }
    ],
    disable: { field: 'isDeleted', value: true }
  }
};

function authHeaders(json) {
  const token = localStorage.getItem('haToken') || localStorage.getItem('token') || '';
  const h = token ? { Authorization: 'Bearer ' + token } : {};
  if (json) h['Content-Type'] = 'application/json';
  return h;
}
function esc(value) {
  return String(value == null ? '' : value).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
}
function toast(message, type) {
  if (typeof showToast === 'function') showToast(message, type || 'success');
}
function lookupLabel(source, id) {
  if (!id) return '';
  const row = (lookups[source] || []).find(item => Number(item.id) === Number(id));
  return row ? row.name : id;
}
function displayValue(key, value) {
  if (key === 'financialInstitutionId') return lookupLabel('institutions', value);
  if (key === 'accountId' || key === 'relatedAccountId') return lookupLabel('accounts', value);
  if (key === 'categoryId' || key === 'parentId') return lookupLabel('categories', value);
  if (typeof value === 'boolean') return value ? 'Yes' : 'No';
  if (value && typeof value === 'object') return value.name || JSON.stringify(value);
  return value == null || value === '' ? '<span class="muted-cell">--</span>' : esc(value);
}
async function loadLookups() {
  const [accounts, categories, institutions] = await Promise.all([
    fetch('/api/accounts', { headers: authHeaders() }).then(r => r.ok ? r.json() : []),
    fetch('/api/categories', { headers: authHeaders() }).then(r => r.ok ? r.json() : []),
    fetch('/api/financial-institutions', { headers: authHeaders() }).then(r => r.ok ? r.json() : [])
  ]);
  lookups = { accounts, categories, institutions };
}
function fieldHtml(field) {
  const label = `<label class="form-label small fw-semibold" for="f_${field.key}">${esc(field.label)}</label>`;
  if (field.type === 'textarea') {
    return `<div><div>${label}<textarea class="form-control" id="f_${field.key}" rows="2"></textarea></div></div>`;
  }
  if (field.type === 'checkbox') {
    return `<div class="d-flex align-items-end"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="f_${field.key}" checked><label class="form-check-label" for="f_${field.key}">${esc(field.label)}</label></div></div>`;
  }
  if (field.type === 'select') {
    return `<div>${label}<select class="form-select" id="f_${field.key}">${field.options.map(opt => `<option value="${esc(opt)}">${esc(opt)}</option>`).join('')}</select></div>`;
  }
  if (field.type === 'lookup') {
    const options = field.optional ? '<option value="">-- None --</option>' : '';
    return `<div>${label}<select class="form-select" id="f_${field.key}" ${field.required ? 'required' : ''}>${options}</select></div>`;
  }
  return `<div>${label}<input class="form-control" id="f_${field.key}" type="${field.type || 'text'}" ${field.step ? `step="${field.step}"` : ''} ${field.required ? 'required' : ''}></div>`;
}
function fillLookupOptions() {
  CONFIG[MODULE].fields.filter(f => f.type === 'lookup').forEach(field => {
    const el = document.getElementById('f_' + field.key);
    if (!el) return;
    const selected = el.value;
    const first = field.optional ? '<option value="">-- None --</option>' : '<option value="">Select...</option>';
    el.innerHTML = first + (lookups[field.source] || []).map(item => `<option value="${item.id}">${esc(item.name)}</option>`).join('');
    el.value = selected;
  });
}
function buildForm() {
  document.getElementById('formFields').innerHTML = CONFIG[MODULE].fields.map(fieldHtml).join('');
  fillLookupOptions();
}
function readForm() {
  const payload = {};
  CONFIG[MODULE].fields.forEach(field => {
    const el = document.getElementById('f_' + field.key);
    if (!el) return;
    if (field.type === 'checkbox') payload[field.key] = el.checked;
    else if (['number', 'lookup'].includes(field.type)) payload[field.key] = el.value === '' ? null : Number(el.value);
    else payload[field.key] = el.value;
  });
  if (MODULE === 'transactions') payload.sourceType = 'manual';
  return payload;
}
function resetForm() {
  document.getElementById('recordId').value = '';
  document.getElementById('formTitle').textContent = 'Add Record';
  document.getElementById('recordForm').reset();
  CONFIG[MODULE].fields.forEach(field => {
    if (field.type === 'checkbox') {
      const el = document.getElementById('f_' + field.key);
      if (el) el.checked = field.key !== 'isDeleted';
    }
  });
}
function editRow(id) {
  const row = rows.find(item => Number(item.id) === Number(id));
  if (!row) return;
  document.getElementById('recordId').value = row.id;
  document.getElementById('formTitle').textContent = 'Edit Record #' + row.id;
  CONFIG[MODULE].fields.forEach(field => {
    const el = document.getElementById('f_' + field.key);
    if (!el) return;
    if (field.type === 'checkbox') el.checked = !!row[field.key];
    else el.value = row[field.key] == null ? '' : row[field.key];
  });
  window.scrollTo({ top: 0, behavior: 'smooth' });
}
async function disableRow(id) {
  const cfg = CONFIG[MODULE];
  if (!cfg.disable) return removeRow(id);
  if (!confirm('Disable this record?')) return;
  const response = await fetch(API_ENDPOINT + '/' + id, {
    method: 'PUT',
    headers: authHeaders(true),
    body: JSON.stringify({ [cfg.disable.field]: cfg.disable.value })
  });
  if (!response.ok) return toast('Unable to disable record.', 'danger');
  toast('Record disabled.');
  loadRows();
}
async function removeRow(id) {
  if (!confirm('Delete this record?')) return;
  const response = await fetch(API_ENDPOINT + '/' + id, { method: 'DELETE', headers: authHeaders() });
  if (!response.ok) return toast('Unable to delete record. It may be referenced by other accounting data.', 'danger');
  toast('Record deleted.');
  loadRows();
}
async function loadRows() {
  const body = document.getElementById('tableBody');
  const head = document.getElementById('tableHead');
  body.innerHTML = '<tr><td class="text-muted">Loading...</td></tr>';
  const response = await fetch(API_ENDPOINT, { headers: authHeaders() });
  if (response.status === 401) return window.location.href = '/login';
  if (!response.ok) {
    body.innerHTML = '<tr><td class="text-danger">Unable to load records.</td></tr>';
    return;
  }
  rows = await response.json();
  const columns = CONFIG[MODULE].columns;
  head.innerHTML = '<tr>' + columns.map(col => '<th>' + esc(col) + '</th>').join('') + '<th class="text-end">Actions</th></tr>';
  if (!rows.length) {
    body.innerHTML = '<tr><td colspan="' + (columns.length + 1) + '" class="text-muted">No records yet.</td></tr>';
    return;
  }
  body.innerHTML = rows.map(row => {
    const cells = columns.map(col => '<td>' + displayValue(col, row[col]) + '</td>').join('');
    const action = `<td class="text-end">
      <button class="btn btn-sm btn-outline-primary me-1" onclick="editRow(${row.id})"><i class="fas fa-edit"></i></button>
      <button class="btn btn-sm btn-outline-danger" onclick="${CONFIG[MODULE].disable ? 'disableRow' : 'removeRow'}(${row.id})"><i class="fas fa-${CONFIG[MODULE].disable ? 'ban' : 'trash'}"></i></button>
    </td>`;
    return '<tr>' + cells + action + '</tr>';
  }).join('');
}
document.getElementById('recordForm').addEventListener('submit', async function(event) {
  event.preventDefault();
  const id = document.getElementById('recordId').value;
  const response = await fetch(id ? API_ENDPOINT + '/' + id : API_ENDPOINT, {
    method: id ? 'PUT' : 'POST',
    headers: authHeaders(true),
    body: JSON.stringify(readForm())
  });
  if (!response.ok) {
    const error = await response.json().catch(() => ({}));
    return toast(error.error || error.message || 'Unable to save record.', 'danger');
  }
  toast('Record saved.');
  await loadLookups();
  fillLookupOptions();
  resetForm();
  loadRows();
});
document.addEventListener('DOMContentLoaded', async function() {
  await loadLookups();
  buildForm();
  resetForm();
  loadRows();
});
</script>
</body>
</html>

  },
  recurring: {
    columns: ['name', 'accountId', 'categoryId', 'transactionType', 'amount', 'currency', 'frequency', 'nextDate', 'isActive'],
    fields: [
      { key: 'name', label: 'Name', required: true },
      { key: 'accountId', label: 'Account', type: 'lookup', source: 'accounts', required: true },
      { key: 'categoryId', label: 'Category', type: 'lookup', source: 'categories', optional: true },
      { key: 'transactionType', label: 'Type', type: 'select', options: ['income', 'expense', 'transfer', 'adjustment'] },
      { key: 'amount', label: 'Amount', type: 'number', step: '0.01', required: true },
      { key: 'currency', label: 'Currency', type: 'select', options: ['USD', 'COP', 'EUR'] },
      { key: 'frequency', label: 'Frequency', type: 'select', options: ['weekly', 'biweekly', 'monthly', 'quarterly', 'annual'] },
      { key: 'nextDate', label: 'Next Date', type: 'date', required: true },
      { key: 'endDate', label: 'End Date', type: 'date' },
      { key: 'merchant', label: 'Merchant / Payee' },
      { key: 'isActive', label: 'Active', type: 'checkbox' },
      { key: 'notes', label: 'Notes', type: 'textarea' }
    ],
    disable: { field: 'isActive', value: false }
  },

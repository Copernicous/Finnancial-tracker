    fields: [
      { key: 'transactionDate', label: 'Date', type: 'date', required: true },
      { key: 'accountId', label: 'Account', type: 'lookup', source: 'accounts', required: true },
      { key: 'categoryId', label: 'Category', type: 'lookup', source: 'categories', optional: true },
      { key: 'relatedAccountId', label: 'Related Account', type: 'lookup', source: 'accounts', optional: true },
      { key: 'description', label: 'Description', required: true },
      { key: 'merchant', label: 'Merchant / Payee' },
      { key: 'transactionType', label: 'Type', type: 'select', options: ['income', 'expense', 'transfer', 'adjustment'] },
      { key: 'amount', label: 'Amount', type: 'number', step: '0.01', required: true },
      { key: 'currency', label: 'Currency', type: 'select', options: ['USD', 'COP', 'EUR'] },
      { key: 'originalAmount', label: 'Original Amount', type: 'number', step: '0.01' },
      { key: 'originalCurrency', label: 'Original Currency', type: 'select', options: ['USD', 'COP', 'EUR'] },
      { key: 'exchangeRate', label: 'Exchange Rate', type: 'number', step: '0.000001' },
      { key: 'status', label: 'Status', type: 'select', options: ['draft', 'reviewed', 'reconciled', 'void'] },
      { key: 'referenceNumber', label: 'Reference' },
      { key: 'tags', label: 'Tags' },
      { key: 'clearedDate', label: 'Cleared Date', type: 'date' },
      { key: 'isRecurring', label: 'Recurring', type: 'checkbox', checked: false },

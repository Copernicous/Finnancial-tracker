    ],
    disable: { field: 'isActive', value: false }
  },
  recurring: {
    columns: ['name', 'accountId', 'categoryId', 'transactionType', 'amount', 'currency', 'frequency', 'nextDate', 'isActive'],
    fields: [
      { key: 'name', label: 'Name', required: true },
      { key: 'accountId', label: 'Account', type: 'lookup', source: 'accounts', required: true },
      { key: 'categoryId', label: 'Category', type: 'lookup', source: 'categories', optional: true },
      { key: 'transactionType', label: 'Type', type: 'select', options: ['income', 'expense', 'transfer', 'adjustment'] },
      { key: 'amount', label: 'Amount', type: 'number', step: '0.01', required: true },
      { key: 'currency', label: 'Currency', type: 'select', options: ['USD', 'COP', 'EUR'] },
      { key: 'frequency', label: 'Frequency', type: 'select', options: ['weekly', 'biweekly', 'monthly', 'quarterly', 'annual'] },
      { key: 'nextDate', label: 'Next Date', type: 'date', required: true },
      { key: 'endDate', label: 'End Date', type: 'date' },
      { key: 'merchant', label: 'Merchant / Payee' },
      { key: 'isActive', label: 'Active', type: 'checkbox' },
      { key: 'notes', label: 'Notes', type: 'textarea' }
    ],
    disable: { field: 'isActive', value: false }
  },
  'financial-goals': {
    columns: ['name', 'goalType', 'accountId', 'targetAmount', 'currentAmount', 'currency', 'targetDate', 'priority', 'status'],
    fields: [
      { key: 'name', label: 'Goal Name', required: true },
      { key: 'goalType', label: 'Goal Type', type: 'select', options: ['savings', 'debt_payoff', 'sinking_fund', 'investment', 'other'] },
      { key: 'accountId', label: 'Linked Account', type: 'lookup', source: 'accounts', optional: true },
      { key: 'targetAmount', label: 'Target Amount', type: 'number', step: '0.01', required: true },
      { key: 'currentAmount', label: 'Current Amount', type: 'number', step: '0.01' },
      { key: 'currency', label: 'Currency', type: 'select', options: ['USD', 'COP', 'EUR'] },
      { key: 'targetDate', label: 'Target Date', type: 'date' },
      { key: 'priority', label: 'Priority', type: 'number' },
      { key: 'status', label: 'Status', type: 'select', options: ['active', 'paused', 'complete', 'archived'] },
      { key: 'notes', label: 'Notes', type: 'textarea' }
    ],
    disable: { field: 'status', value: 'archived' }
  },
  'investment-holdings': {
    columns: ['accountId', 'symbol', 'name', 'assetClass', 'quantity', 'costBasis', 'marketValue', 'currency', 'priceDate'],
    fields: [
      { key: 'accountId', label: 'Investment Account', type: 'lookup', source: 'accounts', required: true },
      { key: 'symbol', label: 'Symbol', required: true },
      { key: 'name', label: 'Holding Name' },
      { key: 'assetClass', label: 'Asset Class', type: 'select', options: ['cash', 'equity', 'fixed_income', 'fund', 'retirement', 'crypto', 'other'] },
      { key: 'quantity', label: 'Quantity', type: 'number', step: '0.000001' },
      { key: 'costBasis', label: 'Cost Basis', type: 'number', step: '0.01' },
      { key: 'marketValue', label: 'Market Value', type: 'number', step: '0.01' },
      { key: 'currency', label: 'Currency', type: 'select', options: ['USD', 'COP', 'EUR'] },
      { key: 'priceDate', label: 'Price Date', type: 'date' },
      { key: 'notes', label: 'Notes', type: 'textarea' }
    ],
    remove: true
  },
  'currency-rates': {
    columns: ['rateDate', 'fromCurrency', 'toCurrency', 'rate', 'source'],
    fields: [
      { key: 'rateDate', label: 'Rate Date', type: 'date', required: true },
      { key: 'fromCurrency', label: 'From Currency', type: 'select', options: ['USD', 'COP', 'EUR'] },
      { key: 'toCurrency', label: 'To Currency', type: 'select', options: ['USD', 'COP', 'EUR'] },
      { key: 'rate', label: 'Rate', type: 'number', step: '0.000001', required: true },
      { key: 'source', label: 'Source', type: 'select', options: ['manual', 'bank', 'statement', 'simulation'] },
      { key: 'notes', label: 'Notes', type: 'textarea' }
    ],
    remove: true
  },
  'balance-snapshots': {
    columns: ['accountId', 'snapshotDate', 'balance', 'currency', 'source'],
    fields: [
      { key: 'accountId', label: 'Account', type: 'lookup', source: 'accounts', required: true },
      { key: 'snapshotDate', label: 'Snapshot Date', type: 'date', required: true },
      { key: 'balance', label: 'Balance', type: 'number', step: '0.01', required: true },
      { key: 'currency', label: 'Currency', type: 'select', options: ['USD', 'COP', 'EUR'] },
      { key: 'source', label: 'Source', type: 'select', options: ['manual', 'statement', 'bank', 'simulation'] },
      { key: 'notes', label: 'Notes', type: 'textarea' }

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <script>!function(){var t=localStorage.getItem("rxTheme");if(t)document.documentElement.setAttribute("data-theme",t)}();</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Patient Timeline - Home Accounting</title>
    <meta name="description" content="Complete RX record timeline for a patient showing all prescriptions and workflow progress">
    <link href="/assets/bootstrap.min.css" rel="stylesheet">
    <link href="/assets/inter.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/fontawesome.all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* ── Timeline-specific styles ── */
        .tl-hero {
            background: linear-gradient(135deg, #1a3a5c 0%, #2d6a9f 60%, #4a90e2 100%);
            color: #fff;
            border-radius: 18px;
            padding: 2rem 2.5rem;
            margin-bottom: 1.5rem;
            position: relative;
            overflow: hidden;
        }
        .tl-hero::before {
            content: '';
            position: absolute;
            top: -40px; right: -40px;
            width: 220px; height: 220px;
            border-radius: 50%;
            background: rgba(255,255,255,.06);
        }
        .tl-hero::after {
            content: '';
            position: absolute;
            bottom: -60px; right: 80px;
            width: 160px; height: 160px;
            border-radius: 50%;
            background: rgba(255,255,255,.04);
        }
        .tl-avatar {
            width: 72px; height: 72px;
            border-radius: 50%;
            background: rgba(255,255,255,.15);
            display: flex; align-items: center; justify-content: center;
            font-size: 2rem;
            border: 3px solid rgba(255,255,255,.3);
            flex-shrink: 0;
        }
        .tl-stat-pill {
            background: rgba(255,255,255,.12);
            border: 1px solid rgba(255,255,255,.2);
            border-radius: 12px;
            padding: .6rem 1.2rem;
            text-align: center;
            backdrop-filter: blur(4px);
            min-width: 100px;
        }
        .tl-stat-pill .num { font-size: 1.7rem; font-weight: 700; line-height: 1; }
        .tl-stat-pill .lbl { font-size: .72rem; opacity: .8; margin-top: 2px; }

        /* ── Vertical timeline ── */
        .timeline-wrap {
            position: relative;
            padding-left: 40px;
        }
        .timeline-wrap::before {
            content: '';
            position: absolute;
            left: 17px; top: 0; bottom: 0;
            width: 3px;
            background: linear-gradient(to bottom, #4a90e2, rgba(74,144,226,.1));
            border-radius: 3px;
        }
        .tl-entry {
            position: relative;
            margin-bottom: 1.5rem;
        }
        .tl-dot {
            position: absolute;
            left: -31px;
            top: 18px;
            width: 20px; height: 20px;
            border-radius: 50%;
            border: 3px solid #fff;
            box-shadow: 0 0 0 3px #4a90e2;
            background: #4a90e2;
            z-index: 1;
            display: flex; align-items: center; justify-content: center;
            font-size: .55rem; color: #fff;
            transition: transform .2s;
        }
        .tl-dot.complete  { background: #28a745; box-shadow: 0 0 0 3px #28a745; }
        .tl-dot.partial   { background: #fd7e14; box-shadow: 0 0 0 3px #fd7e14; }
        .tl-dot.not-start { background: #6c757d; box-shadow: 0 0 0 3px #6c757d; }
        .tl-entry:hover .tl-dot { transform: scale(1.25); }

        .tl-card {
            border-radius: 14px;
            border: 1px solid var(--border-color, #dee2e6);
            background: var(--card-bg, #fff);
            box-shadow: 0 2px 12px rgba(0,0,0,.05);
            transition: box-shadow .2s, transform .15s;
            overflow: hidden;
        }
        .tl-card:hover { box-shadow: 0 6px 24px rgba(74,144,226,.15); transform: translateY(-1px); }

        .tl-card-header {
            padding: 1rem 1.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            cursor: pointer;
            border-bottom: 1px solid transparent;
            transition: border-color .2s;
            gap: .75rem;
        }
        .tl-card-header.open { border-bottom-color: var(--border-color, #dee2e6); }

        .tl-date-badge {
            background: linear-gradient(135deg, #4a90e2, #1a3a5c);
            color: #fff;
            border-radius: 10px;
            padding: .4rem .9rem;
            font-size: .78rem;
            font-weight: 600;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .tl-progress-mini {
            display: flex; gap: 4px; align-items: center; flex-wrap: wrap;
        }
        .tl-step-dot {
            width: 10px; height: 10px;
            border-radius: 50%;
            background: #dee2e6;
            transition: background .2s, transform .15s;
            cursor: pointer;
            position: relative;
        }
        .tl-step-dot.done { background: #28a745; }
        .tl-step-dot.done:hover { transform: scale(1.5); }
        .tl-step-dot[title]:hover::after {
            content: attr(title);
            position: absolute;
            bottom: 14px; left: 50%;
            transform: translateX(-50%);
            background: #333; color: #fff;
            font-size: .65rem; padding: 2px 6px;
            border-radius: 4px; white-space: nowrap;
            pointer-events: none; z-index: 10;
        }

        /* ── Workflow step list in expanded card ── */
        .wf-step {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            padding: .55rem 0;
            border-bottom: 1px solid var(--border-color, #f0f0f0);
        }
        .wf-step:last-child { border-bottom: none; }
        .wf-step-icon {
            width: 30px; height: 30px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: .7rem;
            flex-shrink: 0;
            margin-top: 2px;
        }
        .wf-step-icon.done    { background: rgba(40,167,69,.12); color: #28a745; border: 2px solid rgba(40,167,69,.3); }
        .wf-step-icon.pending { background: rgba(108,117,125,.08); color: #6c757d; border: 2px solid rgba(108,117,125,.2); }

        /* ── Medication chips ── */
        .med-chip {
            display: inline-flex; align-items: center; gap: 5px;
            background: rgba(74,144,226,.08);
            border: 1px solid rgba(74,144,226,.2);
            border-radius: 20px;
            padding: 2px 10px;
            font-size: .75rem;
            color: #4a90e2;
            font-weight: 500;
        }

        /* ── Empty state ── */
        .tl-empty {
            text-align: center;
            padding: 4rem 2rem;
            color: var(--text-muted, #6c757d);
        }
        .tl-empty i { font-size: 3.5rem; opacity: .25; margin-bottom: 1rem; display: block; }

        /* Collapse animation */
        .tl-body { display: none; }
        .tl-body.open { display: block; }

        .svc-history-row {
            display: grid;
            grid-template-columns: minmax(140px, 180px) 1fr minmax(120px, 180px);
            gap: .75rem;
            padding: .75rem 0;
            border-bottom: 1px solid var(--border-color, #dee2e6);
            align-items: center;
        }
        .svc-history-row:last-child { border-bottom: none; }
        .svc-history-change {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: .45rem;
            font-size: .88rem;
            font-weight: 700;
        }
        .svc-history-date-pill {
            display: inline-flex;
            align-items: center;
            min-height: 26px;
            padding: 2px 9px;
            border-radius: 6px;
            background: rgba(74,144,226,.09);
            color: #1a3a5c;
            border: 1px solid rgba(74,144,226,.18);
        }
        .svc-cycle-btn {
            min-height: 34px;
            border-radius: 6px;
            font-size: .78rem;
        }
        .svc-cycle-btn .count {
            font-size: .7rem;
            opacity: .75;
        }
        .svc-cycle-btn.active-filter {
            background: #1a3a5c;
            color: #fff;
            border-color: #1a3a5c;
        }
        .svc-cycle-context {
            border: 1px solid var(--border-color, #dee2e6);
            border-radius: 8px;
            background: rgba(26,58,92,.035);
            padding: .75rem;
        }
        .svc-context-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(130px, 1fr));
            gap: .65rem;
        }
        .svc-context-item {
            border: 1px solid rgba(74,144,226,.16);
            border-radius: 6px;
            padding: .55rem .65rem;
            background: var(--card-bg, #fff);
            min-width: 0;
        }
        .svc-context-label {
            color: var(--text-muted, #6c757d);
            font-size: .66rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .04em;
        }
        .svc-context-value {
            font-size: .82rem;
            font-weight: 700;
            overflow-wrap: anywhere;
        }
        @media (max-width: 768px) {
            .svc-history-row { grid-template-columns: 1fr; }
            .svc-context-grid { grid-template-columns: 1fr; }
        }

        [data-theme="dark"] .tl-card  { background: #1e2533; border-color: #2e3a4e; }
        [data-theme="dark"] .tl-card-header.open { border-bottom-color: #2e3a4e; }
        [data-theme="dark"] .wf-step  { border-bottom-color: #2e3a4e; }
        [data-theme="dark"] .svc-history-date-pill { color: #cfe5ff; }
    </style>
</head>
<body>
<div class="wrapper">
    <!-- Sidebar -->
    <%- include('partials/sidebar') %>
    <div id="content">
        <!-- Navbar -->
        <nav class="navbar navbar-expand-lg px-4 mb-4">
            <button type="button" id="sidebarCollapse" class="btn btn-primary btn-sm"><i class="fas fa-bars"></i></button>
            <span class="ms-3 fw-bold"><i class="fas fa-history me-2 text-primary"></i>Patient Timeline</span>
            <div class="ms-auto d-flex align-items-center gap-3">
                <a id="backToPatients" href="/patients" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Back to Patients</a>
                <button id="themeToggle" class="btn btn-outline-secondary btn-sm"><i class="fas fa-moon"></i></button>
                <span id="userGreeting" class="text-muted small"></span>
                <button id="logoutBtn" class="btn btn-danger btn-sm"><i class="fas fa-sign-out-alt me-1"></i>Logout</button>
            </div>
        </nav>

        <div class="container-fluid px-4">


            <!-- ── Soft-lock viewer banner (hidden until another user is viewing) ── -->
            <div id="viewerBanner" class="d-none mb-3" style="
                background: linear-gradient(135deg,rgba(234,179,8,.10) 0%,rgba(234,179,8,.05) 100%);
                border: 1px solid rgba(234,179,8,.35);
                border-radius: 14px;
                padding: .75rem 1.25rem;
                display: flex; align-items: center; gap: .75rem;
                animation: fadeIn .3s ease;">
                <span style="font-size:1.3rem; flex-shrink:0;">👁️</span>
                <div class="flex-grow-1">
                    <span class="fw-semibold small" id="viewerNames"></span>
                    <span class="text-muted small ms-1" id="viewerSubtext"></span>
                </div>
                <span id="viewerCount" class="badge" style="background:rgba(234,179,8,.2);color:#92400e;border:1px solid rgba(234,179,8,.3);"></span>
            </div>

            <!-- Loading State -->
            <div id="tlLoading" class="text-center py-5">
                <i class="fas fa-spinner fa-spin fa-2x text-primary mb-3 d-block"></i>
                <span class="text-muted">Loading patient timeline...</span>
            </div>

            <!-- Hero card (filled by JS) -->
            <div id="tlHero" style="display:none">
                <div class="tl-hero">
                    <div class="d-flex align-items-center gap-4 flex-wrap">
                        <div class="tl-avatar"><i class="fas fa-user"></i></div>
                        <div class="flex-grow-1">
                            <h2 class="mb-0 fw-bold" id="tlPatientName">&mdash;</h2>
                            <div class="d-flex gap-3 mt-1 flex-wrap" style="opacity:.85;font-size:.88rem">
                                <span><i class="fas fa-id-badge me-1"></i><span id="tlPatientCode">&mdash;</span></span>
                                <span><i class="fas fa-birthday-cake me-1"></i><span id="tlPatientDob">&mdash;</span></span>
                                <span><i class="fas fa-phone me-1"></i><span id="tlPatientPhone">&mdash;</span></span>
                                <span id="tlClinicWrap" style="display:none"><i class="fas fa-hospital me-1"></i><span id="tlClinic">&mdash;</span></span>
                            </div>
                            <div class="d-flex gap-2 mt-2 flex-wrap" id="tlTransportWrap"></div>
                        </div>
                        <div class="d-flex gap-3 flex-wrap" id="tlStatPills">
                            <!-- Stat pills added by JS -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- Timeline container -->
            <div id="tlServiceDateHistory" style="display:none">
                <div class="glass-card p-3 mb-4">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                        <h5 class="mb-0 fw-bold"><i class="fas fa-calendar-alt me-2 text-primary"></i>Patient Service Date History</h5>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="printServiceHistoryBtn" title="Print the full service date history section"><i class="fas fa-print me-1"></i>Print Full History</button>
                            <button type="button" class="btn btn-sm btn-outline-success" id="exportServiceHistoryBtn" title="Export the full service date history CSV"><i class="fas fa-file-csv me-1"></i>Export History CSV</button>
                            <small class="text-muted" id="tlServiceDateHistoryCount"></small>
                        </div>
                    </div>
                    <div id="tlServiceDateHistoryList"></div>
                </div>
            </div>

            <div id="tlServiceDateCycles" style="display:none">
                <div class="glass-card p-3 mb-4">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                        <h5 class="mb-0 fw-bold"><i class="fas fa-layer-group me-2 text-primary"></i>Service Date RX Records</h5>
                        <small class="text-muted" id="tlServiceDateCycleCount"></small>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap" id="tlServiceDateCycleButtons"></div>
                    <div id="tlServiceDateCycleContext" class="mt-3"></div>
                </div>
            </div>

            <div id="tlContainer" style="display:none">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-history me-2 text-primary"></i><span id="tlRxHistoryTitle">RX Record History</span></h5>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-primary" id="printTimelineBtn"><i class="fas fa-print me-1"></i>Print Timeline</button>
                        <button class="btn btn-sm btn-outline-success" id="exportTimelineCsvBtn"><i class="fas fa-file-csv me-1"></i>Export CSV</button>
                        <button class="btn btn-sm btn-outline-secondary" id="expandAllBtn"><i class="fas fa-expand-alt me-1"></i>Expand All</button>
                        <button class="btn btn-sm btn-outline-secondary" id="collapseAllBtn"><i class="fas fa-compress-alt me-1"></i>Collapse All</button>
                        <a id="viewRxBtn" class="btn btn-sm btn-primary" href="#"><i class="fas fa-prescription me-1"></i>View in RX Records</a>
                    </div>
                </div>
                <div class="timeline-wrap" id="tlList"></div>
            </div>

            <!-- Empty state -->
            <div id="tlEmpty" style="display:none">
                <div class="glass-card p-4 tl-empty">
                    <i class="fas fa-prescription-bottle-alt"></i>
                    <h5>No RX Records Found</h5>
                    <p class="text-muted">This patient has no RX records yet.</p>
                    <a href="/rx-records" class="btn btn-primary btn-sm mt-2" id="addFirstRxBtn"><i class="fas fa-plus me-1"></i>Add First RX Record</a>
                </div>
            </div>

        </div><!-- /container -->
    </div><!-- /content -->
</div>

<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100"></div>

<script src="/assets/bootstrap.bundle.min.js"></script>
<a id="xa-base" href="/login" style="display:none"></a>
<script src="/js/base.js"></script>
<script src="/js/app.js"></script>
<script src="/js/help.js"></script>
<script>
'use strict';

// Grab patient ID from URL: /patients/123/timeline
const _ptId = (function() {
    const m = location.pathname.match(/\/patients\/(\d+)\/timeline/);
    return m ? m[1] : null;
})();
let _ptName = '';
let _timelineData = null;
let _serviceDateHistoryRows = [];
let _serviceDateCycles = [];
let _selectedCycleId = 'all';

function tlEscapeHtml(value) {
    if (typeof escHtml === 'function') return escHtml(value);
    return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#x27;');
}

function serviceDateHistoryActor(row) {
    var user = row && row.ChangedBy ? row.ChangedBy : null;
    if (!user) return 'System';
    return (user.firstName || user.lastName)
        ? ((user.firstName || '') + ' ' + (user.lastName || '')).trim()
        : (user.username || 'User');
}

function serviceDateHistoryTimestamp(row) {
    if (!row || !row.createdAt) return '';
    try {
        return new Date(row.createdAt).toLocaleString('en-US', {
            month: 'short',
            day: 'numeric',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
        });
    } catch(e) {
        return String(row.createdAt || '');
    }
}

function serviceDateHistoryChange(row) {
    var from = formatDate(row.previousServiceDate) || 'None';
    var to = formatDate(row.newServiceDate) || 'None';
    if (!row.previousServiceDate && row.newServiceDate) {
        return '<span class="svc-history-date-pill">' + tlEscapeHtml(to) + '</span>';
    }
    if (row.previousServiceDate && !row.newServiceDate) {
        return '<span class="svc-history-date-pill">' + tlEscapeHtml(from) + '</span><span class="text-muted">removed</span>';
    }
    return '<span class="svc-history-date-pill">' + tlEscapeHtml(from) + '</span><i class="fas fa-arrow-right text-muted"></i><span class="svc-history-date-pill">' + tlEscapeHtml(to) + '</span>';
}

function serviceDateHistoryRxBadge(rx) {
    var detail = [];
    if (rx.serviceDate) detail.push('Svc ' + (formatDate(rx.serviceDate) || rx.serviceDate));
    if (rx.pharmacyName) detail.push(rx.pharmacyName);
    if (rx.workflowStepCount) detail.push(rx.workflowStepCount + ' step' + (rx.workflowStepCount === 1 ? '' : 's'));
    return '<span class="badge bg-light text-dark border me-1 mb-1" title="' + tlEscapeHtml(detail.join(' | ')) + '">RX #' + tlEscapeHtml(rx.id) + '</span>';
}

function serviceDateHistoryRxGroup(label, records, count) {
    records = Array.isArray(records) ? records : [];
    count = Number(count || records.length || 0);
    if (!count) return '';
    var shown = records.slice(0, 6).map(serviceDateHistoryRxBadge).join('');
    if (count > records.length || count > 6) {
        shown += '<span class="badge bg-light text-muted border me-1 mb-1">+' + tlEscapeHtml(count - Math.min(records.length, 6)) + ' more</span>';
    }
    return '<div class="mt-1"><span class="text-muted me-1">' + tlEscapeHtml(label) + ':</span> ' + shown + '</div>';
}

function renderServiceDateRelatedRx(row) {
    var related = row && row.relatedRxRecords ? row.relatedRxRecords : null;
    if (!related || !related.totalRxCount) return '';
    var html = '';
    html += serviceDateHistoryRxGroup('Previous service RX', related.previousRxRecords, related.previousRxCount);
    html += serviceDateHistoryRxGroup('New service RX', related.newRxRecords, related.newRxCount);
    if (!html) return '';
    return '<div class="text-muted mt-2 small">' +
        '<i class="fas fa-prescription-bottle-alt me-1"></i>Related RX service records' +
        html +
    '</div>';
}

function tlContextSnapshot(rowOrCycle) {
    var metadata = rowOrCycle && rowOrCycle.metadata ? rowOrCycle.metadata : {};
    if (metadata.patientContext) return metadata.patientContext;
    if (metadata.patientContextChange && metadata.patientContextChange.next) return metadata.patientContextChange.next;
    return null;
}

function tlContextEntityLabel(entity) {
    if (!entity) return 'Not captured';
    return entity.label || entity.name || entity.companyName || entity.contactPerson || ('ID ' + entity.id);
}

function tlContextSummaryText(context) {
    if (!context) return 'Not captured';
    return [
        'Clinic: ' + tlContextEntityLabel(context.clinic),
        'Default Pharmacy: ' + tlContextEntityLabel(context.defaultPharmacy),
        'Patient Transport: ' + tlContextEntityLabel(context.patientTransport),
        'Pharmacy Transport: ' + tlContextEntityLabel(context.pharmacyTransport)
    ].join(' | ');
}

function tlContextGridHtml(context) {
    if (!context) {
        return '<div class="text-muted small"><i class="fas fa-info-circle me-1"></i>No clinic/pharmacy/transport snapshot captured for this cycle yet.</div>';
    }
    var items = [
        ['Clinic', context.clinic],
        ['Default Pharmacy', context.defaultPharmacy],
        ['Patient Transport', context.patientTransport],
        ['Pharmacy Transport', context.pharmacyTransport]
    ];
    return '<div class="svc-context-grid">' + items.map(function(item) {
        return '<div class="svc-context-item">' +
            '<div class="svc-context-label">' + tlEscapeHtml(item[0]) + '</div>' +
            '<div class="svc-context-value">' + tlEscapeHtml(tlContextEntityLabel(item[1])) + '</div>' +
        '</div>';
    }).join('') + '</div>' +
    (context.capturedAt ? '<div class="text-muted mt-2" style="font-size:.72rem"><i class="fas fa-clock me-1"></i>Captured ' + tlEscapeHtml(serviceDateHistoryTimestamp({ createdAt: context.capturedAt })) + '</div>' : '');
}

function serviceDateContextChange(row) {
    var change = row && row.metadata && row.metadata.patientContextChange ? row.metadata.patientContextChange : null;
    if (!change) return '';
    var fields = Array.isArray(change.changedFields) ? change.changedFields : [];
    if (!fields.length) return '';
    var labels = {
        clinic: 'Clinic',
        defaultPharmacy: 'Default Pharmacy',
        patientTransport: 'Patient Transport',
        pharmacyTransport: 'Pharmacy Transport'
    };
    return '<div class="text-muted mt-2 small">' +
        '<i class="fas fa-clipboard-list me-1"></i>Cycle defaults changed: ' +
        fields.map(function(field) { return tlEscapeHtml(labels[field] || field); }).join(', ') +
    '</div>';
}

function tlAssetUrl(path) {
    return typeof window.rxUrl === 'function' ? window.rxUrl(path) : path;
}

function tlFilePart(value) {
    return String(value || 'patient')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')
        .slice(0, 60) || 'patient';
}

function tlPatientLabel() {
    var patient = _timelineData && _timelineData.patient ? _timelineData.patient : {};
    return ((patient.firstName || '') + ' ' + (patient.lastName || '')).trim() || ('Patient #' + (_ptId || ''));
}

function tlRxById(id) {
    var list = _timelineData && Array.isArray(_timelineData.rxRecords) ? _timelineData.rxRecords : [];
    id = Number(id);
    for (var i = 0; i < list.length; i++) {
        if (Number(list[i].id) === id) return list[i];
    }
    return null;
}

function tlRxPharmacy(rx) {
    return (rx && rx.Pharmacy && rx.Pharmacy.name) || (rx && rx.pharmacyName) || 'None';
}

function tlRxMedicationText(rx) {
    var meds = rx && Array.isArray(rx.Medications) ? rx.Medications : [];
    if (!meds.length) return 'None recorded';
    return meds.map(function(m) {
        return m.name || 'Medication';
    }).join(', ');
}

function tlRxStatus(rx) {
    var actions = _timelineData && Array.isArray(_timelineData.workflowActions) ? _timelineData.workflowActions : [];
    var trackings = rx && Array.isArray(rx.RXWorkflowTrackings) ? rx.RXWorkflowTrackings : [];
    var total = actions.length || Number(rx && rx.workflowStepCount) || 0;
    var done = trackings.length || Number(rx && rx.workflowStepCount) || 0;
    var pct = total > 0 ? Math.round((done / total) * 100) : 0;
    var label = total > 0 && done >= total ? 'Complete' : done > 0 ? 'In Progress' : 'Not Started';
    return { done: done, total: total, pct: pct, label: label };
}

function tlCycleById(id) {
    id = Number(id);
    for (var i = 0; i < _serviceDateCycles.length; i++) {
        if (Number(_serviceDateCycles[i].id) === id) return _serviceDateCycles[i];
    }
    return null;
}

function tlRxMatchesCycle(rx, cycle) {
    if (!rx || !cycle) return false;
    if (Number(rx.patientServiceDateCycleId || 0) === Number(cycle.id)) return true;
    if (rx.PatientServiceDateCycle && Number(rx.PatientServiceDateCycle.id || 0) === Number(cycle.id)) return true;
    return String(rx.serviceDate || '').slice(0, 10) === String(cycle.serviceDate || '').slice(0, 10);
}

function tlVisibleRxRecords() {
    var records = _timelineData && Array.isArray(_timelineData.rxRecords) ? _timelineData.rxRecords : [];
    if (_selectedCycleId === 'all') return records;
    var cycle = tlCycleById(_selectedCycleId);
    if (!cycle) return records;
    return records.filter(function(rx) { return tlRxMatchesCycle(rx, cycle); });
}

function tlSelectedCycleLabel() {
    if (_selectedCycleId === 'all') return 'RX Record History';
    var cycle = tlCycleById(_selectedCycleId);
    if (!cycle) return 'RX Record History';
    var label = formatDate(cycle.serviceDate) || cycle.serviceDate || 'Service Date';
    return 'RX Record History - ' + label;
}

function renderServiceDateCycles(cycles) {
    cycles = Array.isArray(cycles) ? cycles : [];
    _serviceDateCycles = cycles;
    var wrap = document.getElementById('tlServiceDateCycles');
    var list = document.getElementById('tlServiceDateCycleButtons');
    var count = document.getElementById('tlServiceDateCycleCount');
    if (!wrap || !list) return;
    if (!cycles.length) {
        wrap.style.display = 'none';
        return;
    }
    if (_selectedCycleId !== 'all' && !tlCycleById(_selectedCycleId)) {
        _selectedCycleId = 'all';
    }
    wrap.style.display = '';
    if (count) count.textContent = cycles.length + ' cycle' + (cycles.length === 1 ? '' : 's');
    var totalRx = _timelineData && Array.isArray(_timelineData.rxRecords) ? _timelineData.rxRecords.length : 0;
    var html = '<button type="button" class="btn btn-sm btn-outline-secondary svc-cycle-btn ' +
        (_selectedCycleId === 'all' ? 'active-filter' : '') +
        '" data-cycle-filter="all"><i class="fas fa-list me-1"></i>All service dates <span class="count ms-1">' + totalRx + ' RX</span></button>';
    cycles.forEach(function(cycle) {
        var isActive = String(cycle.status || '').toLowerCase() === 'active';
        var isSelected = String(_selectedCycleId) === String(cycle.id);
        var statusClass = isActive ? 'bg-primary' : 'bg-secondary';
        html += '<button type="button" class="btn btn-sm btn-outline-secondary svc-cycle-btn ' +
            (isSelected ? 'active-filter' : '') +
            '" data-cycle-filter="' + tlEscapeHtml(cycle.id) + '">' +
            '<i class="fas fa-calendar-day me-1"></i>' + tlEscapeHtml(formatDate(cycle.serviceDate) || cycle.serviceDate || 'No date') +
            ' <span class="badge ' + statusClass + ' ms-1">' + tlEscapeHtml(isActive ? 'Active' : 'History') + '</span>' +
            ' <span class="count ms-1">' + tlEscapeHtml(cycle.rxCount || 0) + ' RX</span>' +
        '</button>';
    });
    list.innerHTML = html;
    renderServiceDateCycleContext(cycles);
}

function renderServiceDateCycleContext(cycles) {
    var target = document.getElementById('tlServiceDateCycleContext');
    if (!target) return;
    cycles = Array.isArray(cycles) ? cycles : [];
    var selectedCycles = _selectedCycleId === 'all'
        ? cycles
        : cycles.filter(function(cycle) { return String(cycle.id) === String(_selectedCycleId); });
    if (!selectedCycles.length) {
        target.innerHTML = '';
        return;
    }

    var html = selectedCycles.map(function(cycle) {
        var context = tlContextSnapshot(cycle);
        var title = formatDate(cycle.serviceDate) || cycle.serviceDate || 'Service Date';
        var status = String(cycle.status || '').toLowerCase() === 'active' ? 'Active' : 'History';
        return '<div class="svc-cycle-context mb-2">' +
            '<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">' +
                '<div class="fw-bold small"><i class="fas fa-clipboard-check me-1 text-primary"></i>' + tlEscapeHtml(title) + ' captured defaults</div>' +
                '<span class="badge ' + (status === 'Active' ? 'bg-primary' : 'bg-secondary') + '">' + status + '</span>' +
            '</div>' +
            tlContextGridHtml(context) +
        '</div>';
    }).join('');
    target.innerHTML = html;
}

function tlResolveRelated(records) {
    var seen = {};
    return (Array.isArray(records) ? records : []).map(function(row) {
        var full = tlRxById(row.id) || row;
        return full;
    }).filter(function(rx) {
        if (!rx || seen[rx.id]) return false;
        seen[rx.id] = true;
        return true;
    });
}

function tlRelatedGroups(row) {
    var related = row && row.relatedRxRecords ? row.relatedRxRecords : {};
    var groups = [];
    var previous = tlResolveRelated(related.previousRxRecords);
    var next = tlResolveRelated(related.newRxRecords);
    if (previous.length) groups.push({ label: 'Previous service RX', records: previous });
    if (next.length) groups.push({ label: 'New service RX', records: next });
    return groups;
}

function tlWorkflowTable(rx) {
    var actions = _timelineData && Array.isArray(_timelineData.workflowActions) ? _timelineData.workflowActions : [];
    var trackings = {};
    (rx.RXWorkflowTrackings || []).forEach(function(t) { trackings[t.workflowActionId] = t; });
    if (!actions.length) {
        var status = tlRxStatus(rx);
        return '<div style="color:#667085;font-size:.85rem">Workflow steps recorded: ' + tlEscapeHtml(status.done) + '</div>';
    }
    var rows = actions.map(function(action, index) {
        var tracking = trackings[action.id];
        var done = !!tracking;
        var date = done && tracking.completionDate ? formatDate(tracking.completionDate) : 'Pending';
        var by = done && tracking.User ? (' by ' + ((tracking.User.firstName || '') + ' ' + (tracking.User.lastName || '')).trim()) : '';
        return '<tr>' +
            '<td style="padding:6px 8px;border-bottom:1px solid #e5e7eb">' + (index + 1) + '. ' + tlEscapeHtml(action.name || 'Step') + '</td>' +
            '<td style="padding:6px 8px;border-bottom:1px solid #e5e7eb">' + tlEscapeHtml(date) + tlEscapeHtml(by) + '</td>' +
            '<td style="padding:6px 8px;border-bottom:1px solid #e5e7eb;color:' + (done ? '#198754' : '#667085') + ';font-weight:700">' + (done ? 'Done' : 'Pending') + '</td>' +
        '</tr>';
    }).join('');
    return '<table style="width:100%;border-collapse:collapse;font-size:.84rem;margin-top:8px">' +
        '<thead><tr style="background:#1a2234;color:#fff"><th style="padding:7px 8px;text-align:left">Step</th><th style="padding:7px 8px;text-align:left">Date / User</th><th style="padding:7px 8px;text-align:left">Status</th></tr></thead>' +
        '<tbody>' + rows + '</tbody></table>';
}

function tlRxPrintCard(rx, groupLabel) {
    var status = tlRxStatus(rx);
    var statusColor = status.label === 'Complete' ? '#198754' : status.done > 0 ? '#fd7e14' : '#6c757d';
    return '<div style="border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;margin:14px 0;background:#fff">' +
        '<div style="background:#1a2234;color:#fff;padding:10px 14px;display:flex;justify-content:space-between;gap:10px;align-items:center">' +
            '<div><strong>' + tlEscapeHtml(groupLabel || 'RX Record') + ' #' + tlEscapeHtml(rx.id) + '</strong></div>' +
            '<span style="background:' + statusColor + ';color:#fff;padding:3px 10px;border-radius:12px;font-size:.76rem;font-weight:700">' + tlEscapeHtml(status.label) + '</span>' +
        '</div>' +
        '<div style="padding:12px 14px">' +
            '<div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;font-size:.86rem">' +
                '<div><div style="color:#667085;font-size:.68rem;text-transform:uppercase;font-weight:700">Service Date</div><strong>' + tlEscapeHtml(rx.serviceDate ? formatDate(rx.serviceDate) : 'None') + '</strong></div>' +
                '<div><div style="color:#667085;font-size:.68rem;text-transform:uppercase;font-weight:700">Arrival Date</div><strong>' + tlEscapeHtml(rx.arrivalDate ? formatDate(rx.arrivalDate) : 'None') + '</strong></div>' +
                '<div><div style="color:#667085;font-size:.68rem;text-transform:uppercase;font-weight:700">Pharmacy</div><strong>' + tlEscapeHtml(tlRxPharmacy(rx)) + '</strong></div>' +
                '<div><div style="color:#667085;font-size:.68rem;text-transform:uppercase;font-weight:700">Workflow</div><strong>' + status.done + '/' + status.total + ' (' + status.pct + '%)</strong></div>' +
            '</div>' +
            '<div style="margin-top:10px;font-size:.84rem"><span style="color:#667085;font-weight:700">Medications:</span> ' + tlEscapeHtml(tlRxMedicationText(rx)) + '</div>' +
            tlWorkflowTable(rx) +
        '</div>' +
    '</div>';
}

function tlOpenPrint(title, subtitle, bodyHtml) {
    var cssUrl = tlAssetUrl('/assets/inter.css').replace(/"/g, '%22');
    var win = window.open('', '_blank', 'width=980,height=760');
    if (!win) {
        if (typeof showToast === 'function') showToast('Popup blocked. Allow popups to print.', 'warning');
        return;
    }
    win.document.write('<!DOCTYPE html><html><head><meta charset="UTF-8">' +
        '<title>' + tlEscapeHtml(title) + '</title>' +
        '<style>@import url("' + cssUrl + '");*{box-sizing:border-box}body{font-family:Inter,Arial,sans-serif;color:#1a2234;background:#f4f6f8;padding:28px}.sheet{max-width:960px;margin:0 auto;background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 8px 30px rgba(0,0,0,.08)}.head{background:linear-gradient(135deg,#1a2234,#2c3e6b);color:#fff;padding:20px 26px}.content{padding:22px 26px}@media print{@page{margin:15mm;size:A4 portrait}body{background:#fff;padding:0}.sheet{box-shadow:none;border-radius:0}.head{-webkit-print-color-adjust:exact;print-color-adjust:exact}}</style>' +
        '</head><body><div class="sheet"><div class="head"><h2 style="margin:0">' + tlEscapeHtml(title) + '</h2><div style="opacity:.8;margin-top:4px">' + tlEscapeHtml(subtitle || '') + '</div></div><div class="content">' + bodyHtml + '</div></div>' +
        '<script>window.onload=function(){setTimeout(function(){window.print();},100);};<\/script></body></html>');
    win.document.close();
    win.focus();
}

function tlPrintRxGroups(title, groups, historyRow, includeHistory) {
    var patient = _timelineData && _timelineData.patient ? _timelineData.patient : {};
    var total = groups.reduce(function(sum, group) { return sum + group.records.length; }, 0);
    if (!total) {
        if (typeof showToast === 'function') showToast('No related RX records to print.', 'warning');
        return;
    }
    var body = '<div style="display:flex;justify-content:space-between;gap:12px;margin-bottom:16px;font-size:.9rem">' +
        '<div><strong>Patient:</strong> ' + tlEscapeHtml(tlPatientLabel()) + '</div>' +
        '<div><strong>Patient ID:</strong> ' + tlEscapeHtml(patient.patientCode || patient.id || _ptId || '') + '</div>' +
        '<div><strong>Generated:</strong> ' + tlEscapeHtml(new Date().toLocaleString()) + '</div>' +
    '</div>';

    if (historyRow) {
        body += '<div style="border-left:4px solid #4a90e2;background:#f3f8ff;padding:10px 12px;border-radius:8px;margin-bottom:14px;font-size:.88rem">' +
            '<div><strong>Service date change:</strong> ' + serviceDateHistoryChange(historyRow).replace(/<[^>]*>/g, ' ') + '</div>' +
            '<div><strong>Source:</strong> ' + tlEscapeHtml(historyRow.changeSource || '') + ' &nbsp; <strong>Changed by:</strong> ' + tlEscapeHtml(serviceDateHistoryActor(historyRow)) + '</div>' +
            (historyRow.reason ? '<div><strong>Reason:</strong> ' + tlEscapeHtml(historyRow.reason) + '</div>' : '') +
        '</div>';
    }

    if (includeHistory) {
        body += tlServiceHistoryPrintBlock(_serviceDateHistoryRows);
    }

    groups.forEach(function(group) {
        body += '<h4 style="margin:18px 0 8px">' + tlEscapeHtml(group.label) + ' (' + group.records.length + ')</h4>';
        group.records.forEach(function(rx) {
            body += tlRxPrintCard(rx, 'RX');
        });
    });

    tlOpenPrint(title, 'Home Accounting - ' + tlPatientLabel(), body);
}

function tlExportRxGroups(filename, groups, historyRow) {
    var total = groups.reduce(function(sum, group) { return sum + group.records.length; }, 0);
    if (!total) {
        if (typeof showToast === 'function') showToast('No related RX records to export.', 'warning');
        return;
    }
    var headers = ['Group', 'RX ID', 'Service Date', 'Arrival Date', 'Pharmacy', 'Workflow', 'Status', 'Medications', 'History Source', 'History Change'];
    var historyChange = historyRow ? (formatDate(historyRow.previousServiceDate) + ' -> ' + formatDate(historyRow.newServiceDate)) : '';
    var rows = [];
    groups.forEach(function(group) {
        group.records.forEach(function(rx) {
            var status = tlRxStatus(rx);
            rows.push([
                group.label,
                rx.id,
                rx.serviceDate || '',
                rx.arrivalDate || '',
                tlRxPharmacy(rx),
                status.done + '/' + status.total + ' (' + status.pct + '%)',
                status.label,
                tlRxMedicationText(rx),
                historyRow ? (historyRow.changeSource || '') : '',
                historyChange
            ]);
        });
    });
    exportToCsv(filename, headers, rows);
}

function tlServiceHistoryPrintBlock(history) {
    history = Array.isArray(history) ? history : [];
    if (!history.length) return '';
    var rows = history.map(function(row) {
        var related = row.relatedRxRecords || {};
        var context = row && row.metadata && row.metadata.patientContextChange
            ? row.metadata.patientContextChange.next
            : tlContextSnapshot(row);
        return '<tr>' +
            '<td style="padding:6px 8px;border-bottom:1px solid #e5e7eb">' + tlEscapeHtml(row.changeSource || '') + '</td>' +
            '<td style="padding:6px 8px;border-bottom:1px solid #e5e7eb">' + tlEscapeHtml(formatDate(row.previousServiceDate) || 'None') + '</td>' +
            '<td style="padding:6px 8px;border-bottom:1px solid #e5e7eb">' + tlEscapeHtml(formatDate(row.newServiceDate) || 'None') + '</td>' +
            '<td style="padding:6px 8px;border-bottom:1px solid #e5e7eb">' + tlEscapeHtml(serviceDateHistoryActor(row)) + '</td>' +
            '<td style="padding:6px 8px;border-bottom:1px solid #e5e7eb">' + tlEscapeHtml(serviceDateHistoryTimestamp(row)) + '</td>' +
            '<td style="padding:6px 8px;border-bottom:1px solid #e5e7eb">' + tlEscapeHtml(tlContextSummaryText(context)) + '</td>' +
            '<td style="padding:6px 8px;border-bottom:1px solid #e5e7eb;text-align:center">' + tlEscapeHtml(related.totalRxCount || 0) + '</td>' +
        '</tr>';
    }).join('');
    return '<h4 style="margin:6px 0 8px">Patient Service Date History</h4>' +
        '<table style="width:100%;border-collapse:collapse;font-size:.84rem;margin-bottom:16px">' +
        '<thead><tr style="background:#1a2234;color:#fff"><th style="padding:7px 8px;text-align:left">Source</th><th style="padding:7px 8px;text-align:left">Previous</th><th style="padding:7px 8px;text-align:left">New</th><th style="padding:7px 8px;text-align:left">Changed By</th><th style="padding:7px 8px;text-align:left">When</th><th style="padding:7px 8px;text-align:left">Captured Defaults</th><th style="padding:7px 8px;text-align:center">RX</th></tr></thead>' +
        '<tbody>' + rows + '</tbody></table>';
}

function printServiceHistoryEntry(index) {
    var row = _serviceDateHistoryRows[index];
    if (!row) return;
    tlPrintRxGroups('Service Date Related RX Records', tlRelatedGroups(row), row, false);
}

function exportServiceHistoryEntry(index) {
    var row = _serviceDateHistoryRows[index];
    if (!row) return;
    var name = tlFilePart(tlPatientLabel());
    var date = (row.newServiceDate || row.previousServiceDate || new Date().toISOString().slice(0, 10));
    tlExportRxGroups('service-date-rx-' + name + '-' + date + '.csv', tlRelatedGroups(row), row);
}

function printFullServiceDateHistory() {
    var groups = [];
    _serviceDateHistoryRows.forEach(function(row) {
        tlRelatedGroups(row).forEach(function(group) {
            groups.push({
                label: (row.newServiceDate || row.previousServiceDate || 'Service Date') + ' - ' + group.label,
                records: group.records
            });
        });
    });
    if (!groups.length) {
        tlOpenPrint('Patient Service Date History', 'Home Accounting - ' + tlPatientLabel(), tlServiceHistoryPrintBlock(_serviceDateHistoryRows));
        return;
    }
    tlPrintRxGroups('Patient Service Date History', groups, null, true);
}

function exportFullServiceDateHistory() {
    if (!_serviceDateHistoryRows.length) {
        if (typeof showToast === 'function') showToast('No service date history to export.', 'warning');
        return;
    }
    var headers = ['Source', 'Previous Service Date', 'New Service Date', 'Changed By', 'Changed At', 'Reason', 'Captured Defaults', 'Related RX Count'];
    var rows = _serviceDateHistoryRows.map(function(row) {
        var related = row.relatedRxRecords || {};
        var context = row && row.metadata && row.metadata.patientContextChange
            ? row.metadata.patientContextChange.next
            : tlContextSnapshot(row);
        return [
            row.changeSource || '',
            row.previousServiceDate || '',
            row.newServiceDate || '',
            serviceDateHistoryActor(row),
            serviceDateHistoryTimestamp(row),
            row.reason || '',
            tlContextSummaryText(context),
            related.totalRxCount || 0
        ];
    });
    exportToCsv('patient-service-date-history-' + tlFilePart(tlPatientLabel()) + '.csv', headers, rows);
}

function printPatientTimeline() {
    var records = tlVisibleRxRecords();
    tlPrintRxGroups('Patient Timeline', [{ label: tlSelectedCycleLabel(), records: records }], null, true);
}

function exportPatientTimelineCsv() {
    if (!_timelineData) return;
    var headers = ['Section', 'Item', 'RX ID', 'Service Date', 'Arrival Date', 'Pharmacy', 'Workflow', 'Status', 'Source', 'Changed By', 'Changed At', 'Reason', 'Captured Defaults'];
    var rows = [];
    _serviceDateHistoryRows.forEach(function(row) {
        var related = row.relatedRxRecords || {};
        var context = row && row.metadata && row.metadata.patientContextChange
            ? row.metadata.patientContextChange.next
            : tlContextSnapshot(row);
        rows.push([
            'Service Date History',
            formatDate(row.previousServiceDate) + ' -> ' + formatDate(row.newServiceDate),
            '',
            row.newServiceDate || '',
            '',
            '',
            related.totalRxCount ? related.totalRxCount + ' related RX' : '0 related RX',
            '',
            row.changeSource || '',
            serviceDateHistoryActor(row),
            serviceDateHistoryTimestamp(row),
            row.reason || '',
            tlContextSummaryText(context)
        ]);
    });

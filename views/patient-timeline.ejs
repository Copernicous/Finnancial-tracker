            'RX Record History',
            'RX #' + rx.id,
            rx.id,
            rx.serviceDate || '',
            rx.arrivalDate || '',
            tlRxPharmacy(rx),
            status.done + '/' + status.total + ' (' + status.pct + '%)',
            status.label,
            '',
            '',
            '',
            tlRxMedicationText(rx),
            ''
        ]);
    });
    exportToCsv('patient-timeline-' + tlFilePart(tlPatientLabel()) + '.csv', headers, rows);
}

function renderServiceDateHistory(history) {
    history = Array.isArray(history) ? history : [];
    _serviceDateHistoryRows = history;
    const wrap = document.getElementById('tlServiceDateHistory');
    const list = document.getElementById('tlServiceDateHistoryList');
    const count = document.getElementById('tlServiceDateHistoryCount');
    if (!wrap || !list) return;

    wrap.style.display = '';
    if (count) count.textContent = history.length + ' entr' + (history.length === 1 ? 'y' : 'ies');

    if (!history.length) {
        list.innerHTML =
            '<div class="text-muted small py-2">' +
                '<i class="fas fa-info-circle me-1"></i>No patient service date history recorded yet.' +
            '</div>';
        return;
    }

    var html = '';
    history.forEach(function(row, index) {
        var source = tlEscapeHtml(row.changeSource || 'Patient Update');
        var reason = tlEscapeHtml(row.reason || '');
        var actor = tlEscapeHtml(serviceDateHistoryActor(row));
        var when = tlEscapeHtml(serviceDateHistoryTimestamp(row));
        var relatedRx = renderServiceDateRelatedRx(row);
        var contextChange = serviceDateContextChange(row);
        var related = row.relatedRxRecords || {};
        var actions = related.totalRxCount
            ? '<div class="mt-2">' +
                '<div class="text-muted text-uppercase fw-bold mb-1" style="font-size:.62rem;letter-spacing:.06em">Related RX</div>' +
                '<div class="d-flex gap-1 flex-wrap">' +
                    '<button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" data-svc-history-print="' + index + '" title="Print related RX for this service date"><i class="fas fa-print me-1"></i>Print RX</button>' +
                    '<button type="button" class="btn btn-sm btn-outline-success py-0 px-2" data-svc-history-export="' + index + '" title="Export related RX CSV for this service date"><i class="fas fa-file-csv me-1"></i>CSV RX</button>' +
                '</div>' +
            '</div>'
            : '';
        html +=
            '<div class="svc-history-row">' +
                '<div>' +
                    '<span class="badge bg-secondary">' + source + '</span>' +
                    '<div class="text-muted mt-1" style="font-size:.75rem">' + when + '</div>' +
                '</div>' +
                '<div>' +
                    '<div class="svc-history-change">' + serviceDateHistoryChange(row) + '</div>' +
                    (reason ? '<div class="text-muted mt-1 small"><i class="fas fa-comment-alt me-1"></i>' + reason + '</div>' : '') +
                    contextChange +
                    relatedRx +
                '</div>' +
                '<div class="text-muted small">' +
                    '<div class="d-flex align-items-center gap-1 flex-wrap"><i class="fas fa-user me-1"></i><span>Changed by ' + actor + '</span></div>' +
                    actions +
                '</div>' +
            '</div>';
    });
    list.innerHTML = html;
}

document.addEventListener('DOMContentLoaded', async () => {
    initApp();

    if (!_ptId) {
        document.getElementById('tlLoading').innerHTML = '<div class="alert alert-danger">Invalid patient ID.</div>';
        return;
    }

    const rxBtn = document.getElementById('viewRxBtn');
    const addFirstRxBtn = document.getElementById('addFirstRxBtn');
    if (rxBtn) rxBtn.href = '/rx-records?patient=' + _ptId;
    if (addFirstRxBtn) addFirstRxBtn.href = '/rx-records?patient=' + _ptId;
    document.getElementById('backToPatients').href = '/patients';
    var printTimelineBtn = document.getElementById('printTimelineBtn');
    var exportTimelineBtn = document.getElementById('exportTimelineCsvBtn');
    var printSvcHistoryBtn = document.getElementById('printServiceHistoryBtn');
    var exportSvcHistoryBtn = document.getElementById('exportServiceHistoryBtn');
    if (printTimelineBtn) printTimelineBtn.addEventListener('click', printPatientTimeline);
    if (exportTimelineBtn) exportTimelineBtn.addEventListener('click', exportPatientTimelineCsv);
    if (printSvcHistoryBtn) printSvcHistoryBtn.addEventListener('click', printFullServiceDateHistory);
    if (exportSvcHistoryBtn) exportSvcHistoryBtn.addEventListener('click', exportFullServiceDateHistory);

    try {
        const res = await fetchWithAuth(window.rxUrl('/api/patients/') + _ptId + '/timeline');
        if (!res || !res.ok) throw new Error('Failed to load');
        const data = await res.json();
        if (data && data.patient && data.patient.id) {
            _ptName = ((data.patient.firstName || '') + ' ' + (data.patient.lastName || '')).trim();
            const rxHref = '/rx-records?patient=' + data.patient.id + '&name=' + encodeURIComponent(_ptName);
            if (rxBtn) rxBtn.href = rxHref;
            if (addFirstRxBtn) addFirstRxBtn.href = rxHref;
        } else {
            const fallback = '/rx-records?patient=' + _ptId;
            if (rxBtn) rxBtn.href = fallback;
            if (addFirstRxBtn) addFirstRxBtn.href = fallback;
        }
        renderTimeline(data);
    } catch(e) {
        document.getElementById('tlLoading').innerHTML =
            '<div class="alert alert-danger"><i class="fas fa-exclamation-triangle me-2"></i>Could not load patient timeline. ' + e.message + '</div>';
    }
});

function renderTimeline({ patient, rxRecords, workflowActions, serviceDateHistory, serviceDateCycles }) {
    document.getElementById('tlLoading').style.display = 'none';
    rxRecords = Array.isArray(rxRecords) ? rxRecords : [];
    rxRecords.forEach(function(rx) { if (!Array.isArray(rx.completedSteps)) rx.completedSteps = []; });
    workflowActions = Array.isArray(workflowActions) ? workflowActions : [];
    const serviceHistory = Array.isArray(serviceDateHistory) ? serviceDateHistory : [];
    const serviceCycles = Array.isArray(serviceDateCycles) ? serviceDateCycles : [];
    _timelineData = { patient: patient || {}, rxRecords: rxRecords, workflowActions: workflowActions, serviceDateHistory: serviceHistory, serviceDateCycles: serviceCycles };
    renderServiceDateCycles(serviceCycles);
    const visibleRxRecords = tlVisibleRxRecords();
    document.getElementById('tlEmpty').style.display = 'none';
    document.getElementById('tlContainer').style.display = 'none';

    // ── Hero card ──────────────────────────────────────────────────────────
    document.getElementById('tlPatientName').textContent =
        (patient.firstName || '') + ' ' + (patient.lastName || '');
    document.getElementById('tlPatientCode').textContent  = patient.patientCode || '—';
    document.getElementById('tlPatientDob').textContent   = patient.dob ? formatDate(patient.dob) : '—';
    document.getElementById('tlPatientPhone').textContent = patient.phone || '—';

    if (patient.Clinic) {
        document.getElementById('tlClinicWrap').style.display = '';
        document.getElementById('tlClinic').textContent = patient.Clinic.name;
    }

    const twrap = document.getElementById('tlTransportWrap');
    twrap.innerHTML = '';
    if (patient.PatientTransportCompany) {
        twrap.innerHTML += '<span class="badge rounded-pill" style="background:rgba(255,255,255,.15);font-size:.73rem"><i class="fas fa-ambulance me-1"></i>' +
            (patient.PatientTransportCompany.companyName || patient.PatientTransportCompany.contactPerson) + '</span>';
    }
    if (patient.PharmacyTransportCompany) {
        twrap.innerHTML += '<span class="badge rounded-pill" style="background:rgba(255,255,255,.15);font-size:.73rem"><i class="fas fa-truck me-1"></i>' +
            (patient.PharmacyTransportCompany.companyName || patient.PharmacyTransportCompany.contactPerson) + '</span>';
    }

    // Stats
    const total     = visibleRxRecords.length;
    const completed = visibleRxRecords.filter(r => r.completedSteps.length === workflowActions.length && workflowActions.length > 0).length;
    const inProg    = visibleRxRecords.filter(r => r.completedSteps.length > 0 && r.completedSteps.length < workflowActions.length).length;
    const notStart  = visibleRxRecords.filter(r => r.completedSteps.length === 0).length;

    document.getElementById('tlStatPills').innerHTML =
        '<div class="tl-stat-pill"><div class="num">' + total + '</div><div class="lbl">Total RX</div></div>' +
        '<div class="tl-stat-pill"><div class="num" style="color:#a8d5b5">' + completed + '</div><div class="lbl">Complete</div></div>' +
        '<div class="tl-stat-pill"><div class="num" style="color:#ffc878">' + inProg + '</div><div class="lbl">In Progress</div></div>' +
        '<div class="tl-stat-pill"><div class="num" style="color:#b0b8c8">' + notStart + '</div><div class="lbl">Not Started</div></div>' +
        '<div class="tl-stat-pill"><div class="num" style="color:#ffd38a">' + serviceCycles.length + '</div><div class="lbl">Svc Dates</div></div>';
    document.getElementById('tlHero').style.display = '';
    renderServiceDateHistory(serviceHistory);
    var titleEl = document.getElementById('tlRxHistoryTitle');
    if (titleEl) titleEl.textContent = tlSelectedCycleLabel();

    if (!visibleRxRecords.length) {
        document.getElementById('tlEmpty').style.display = '';
        return;
    }

    // ── Timeline entries ───────────────────────────────────────────────────
    const list = document.getElementById('tlList');
    list.innerHTML = '';

    visibleRxRecords.forEach((rx, idx) => {
        const completedCount = rx.completedSteps.length;
        const totalSteps     = workflowActions.length;
        const isComplete     = totalSteps > 0 && completedCount === totalSteps;
        const isPartial      = completedCount > 0 && !isComplete;
        const dotClass       = isComplete ? 'complete' : isPartial ? 'partial' : 'not-start';
        const dotIcon        = isComplete ? '<i class="fas fa-check"></i>' : isPartial ? '<i class="fas fa-spinner"></i>' : '<i class="fas fa-clock"></i>';

        // Build workflow tracking lookup
        const trackingMap = {};
        (rx.RXWorkflowTrackings || []).forEach(t => { trackingMap[t.workflowActionId] = t; });

        // Mini step dots
        var miniDots = '';
        workflowActions.forEach(function(a) {
            const t = trackingMap[a.id];
            const doneClass = t ? 'done' : '';
            const tip = t
                ? a.name + ' - done ' + formatDate(t.completionDate) + ' ' + (t.User ? 'by ' + t.User.firstName + ' ' + t.User.lastName : '')
                : a.name + ' - Pending';
            miniDots += '<div class="tl-step-dot ' + doneClass + '" title="' + tip + '"></div>';
        });

        // Pharmacy
        const pharmacy = rx.Pharmacy ? rx.Pharmacy.name : '—';
        // Transport
        const ptrans   = rx.PatientTransportCompany ? (rx.PatientTransportCompany.companyName || rx.PatientTransportCompany.contactPerson) : null;
        const rxtrans  = rx.PharmacyTransportCompany ? (rx.PharmacyTransportCompany.companyName || rx.PharmacyTransportCompany.contactPerson) : null;

        // Status badge
        const pct = totalSteps > 0 ? Math.round((completedCount / totalSteps) * 100) : 0;
        const statusBadge = isComplete
            ? '<span class="badge bg-success"><i class="fas fa-check me-1"></i>Complete</span>'
            : completedCount > 0
                ? '<span class="badge" style="background:#fd7e14"><i class="fas fa-spinner me-1"></i>' + pct + '%</span>'
                : '<span class="badge bg-secondary"><i class="fas fa-clock me-1"></i>Not Started</span>';

        // Medications
        const meds = (rx.Medications || []);
        var medChips = '';
        if (meds.length) {
            meds.forEach(function(m) {
                medChips += '<span class="med-chip"><i class="fas fa-pills"></i>' + (m.name || 'Medication') + '</span> ';
            });
        } else {
            medChips = '<span class="text-muted small">No medications recorded</span>';
        }

        // Workflow step rows
        var wfRows = '';
        workflowActions.forEach(function(a, si) {
            const t = trackingMap[a.id];
            const done = !!t;
            wfRows += '<div class="wf-step">' +
                '<div class="wf-step-icon ' + (done ? 'done' : 'pending') + '">' +
                    (done ? '<i class="fas fa-check"></i>' : '<i class="fas fa-circle" style="font-size:.35rem"></i>') +
                '</div>' +
                '<div class="flex-grow-1">' +
                    '<div class="d-flex justify-content-between align-items-start gap-2">' +
                        '<span class="small fw-semibold" style="' + (done ? '' : 'color:var(--text-muted,#6c757d)') + '">' + (si + 1) + '. ' + a.name + '</span>' +
                        (done
                            ? '<span class="text-success small" style="white-space:nowrap"><i class="fas fa-calendar-check me-1"></i>' + formatDate(t.completionDate) + '</span>'
                            : '<span class="text-muted small">Pending</span>') +
                    '</div>' +
                    (done && t.User ? '<div class="text-muted" style="font-size:.72rem"><i class="fas fa-user me-1"></i>Completed by ' + t.User.firstName + ' ' + t.User.lastName + '</div>' : '') +
                '</div>' +
            '</div>';
        });

        const entryId = 'tlEntry_' + rx.id;
        const bodyId  = 'tlBody_'  + rx.id;

        var ptransRow = ptrans ? '<tr><td class="text-muted pe-3 py-1">Patient Transport</td><td class="fw-semibold">' + ptrans + '</td></tr>' : '';
        var rxtransRow = rxtrans ? '<tr><td class="text-muted pe-3 py-1">RX Transport</td><td class="fw-semibold">' + rxtrans + '</td></tr>' : '';
        var progressClass = isComplete ? 'bg-success' : 'bg-primary';
        var html = '<div class="tl-entry" id="' + entryId + '">' +
            '<div class="tl-dot ' + dotClass + '">' + dotIcon + '</div>' +
            '<div class="tl-card">' +
                '<div class="tl-card-header" data-tl-toggle="' + bodyId + '">' +
                    '<div class="d-flex align-items-center gap-3 flex-grow-1 flex-wrap">' +
                        '<div class="tl-date-badge"><i class="fas fa-calendar-alt me-1"></i>' + (rx.serviceDate ? formatDate(rx.serviceDate) : 'No service date') + '</div>' +
                        '<div>' +
                            '<div class="fw-semibold small" style="font-size:.85rem">RX #' + rx.id + ' &nbsp;&middot;&nbsp; <i class="fas fa-clinic-medical me-1 text-primary"></i>' + pharmacy + '</div>' +
                            '<div class="d-flex gap-1 mt-1">' + miniDots + '</div>' +
                        '</div>' +
                    '</div>' +
                    '<div class="d-flex align-items-center gap-2 flex-shrink-0">' +
                        statusBadge +
                        '<span class="text-muted small">' + completedCount + '/' + totalSteps + ' steps</span>' +
                        '<i class="fas fa-chevron-down text-muted tl-chevron" style="transition:transform .2s;font-size:.8rem"></i>' +
                    '</div>' +
                '</div>' +
                '<div class="tl-body" id="' + bodyId + '">' +
                    '<div class="row g-0">' +
                        '<div class="col-md-5 p-3" style="border-right:1px solid var(--border-color,#dee2e6)">' +
                            '<div class="fw-bold small text-muted text-uppercase mb-2" style="letter-spacing:.05em"><i class="fas fa-info-circle me-1"></i>Record Details</div>' +
                            '<table class="w-100" style="font-size:.82rem">' +
                                '<tr><td class="text-muted pe-3 py-1" style="white-space:nowrap">Arrival Date</td><td class="fw-semibold">' + (rx.arrivalDate ? formatDate(rx.arrivalDate) : '&mdash;') + '</td></tr>' +
                                '<tr><td class="text-muted pe-3 py-1">Service Date</td><td class="fw-semibold">' + (rx.serviceDate ? formatDate(rx.serviceDate) : '&mdash;') + '</td></tr>' +
                                '<tr><td class="text-muted pe-3 py-1">Pharmacy</td><td class="fw-semibold">' + pharmacy + '</td></tr>' +
                                ptransRow +
                                rxtransRow +
                            '</table>' +
                            '<div class="mt-3">' +
                                '<div class="fw-bold small text-muted text-uppercase mb-2" style="letter-spacing:.05em"><i class="fas fa-pills me-1"></i>Medications</div>' +
                                '<div class="d-flex flex-wrap gap-1">' + medChips + '</div>' +
                            '</div>' +
                            '<div class="mt-3 d-flex gap-2">' +
                                '<a href="/rx-records?rx=' + rx.id + '" class="btn btn-outline-primary btn-sm" style="font-size:.75rem"><i class="fas fa-external-link-alt me-1"></i>Open in RX Records</a>' +
                            '</div>' +
                        '</div>' +
                        '<div class="col-md-7 p-3">' +
                            '<div class="fw-bold small text-muted text-uppercase mb-2" style="letter-spacing:.05em"><i class="fas fa-tasks me-1"></i>Workflow Progress</div>' +
                            '<div class="mb-3">' +
                                '<div class="d-flex justify-content-between small mb-1">' +
                                    '<span class="text-muted">' + completedCount + ' of ' + totalSteps + ' steps complete</span>' +
                                    '<span class="fw-semibold">' + pct + '%</span>' +
                                '</div>' +
                                '<div class="progress" style="height:6px;border-radius:4px">' +
                                    '<div class="progress-bar ' + progressClass + '" style="width:' + pct + '%;transition:width .6s"></div>' +
                                '</div>' +
                            '</div>' +
                            '<div>' + wfRows + '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
            '</div>' +
        '</div>';
        list.insertAdjacentHTML('beforeend', html);
    });

    document.getElementById('tlContainer').style.display = '';

    // Expand / Collapse All
    document.getElementById('expandAllBtn').onclick = () => {
        document.querySelectorAll('.tl-body').forEach(b => {
            b.classList.add('open');
            const h = b.previousElementSibling;
            if (h) { h.classList.add('open'); const ch = h.querySelector('.tl-chevron'); if(ch) ch.style.transform='rotate(180deg)'; }
        });
    };
    document.getElementById('collapseAllBtn').onclick = () => {
        document.querySelectorAll('.tl-body').forEach(b => {
            b.classList.remove('open');
            const h = b.previousElementSibling;
            if (h) { h.classList.remove('open'); const ch = h.querySelector('.tl-chevron'); if(ch) ch.style.transform=''; }
        });
    };
}

function toggleTlCard(bodyId, headerEl) {
    const body   = document.getElementById(bodyId);
    const chevron = headerEl.querySelector('.tl-chevron');
    const open   = body.classList.toggle('open');
    headerEl.classList.toggle('open', open);
    if (chevron) chevron.style.transform = open ? 'rotate(180deg)' : '';
}

function formatDate(d) {
    if (!d) return '—';
    try {
        const dt = new Date(d.includes('T') ? d : d + 'T00:00:00');
        return dt.toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' });
    } catch(e) { return d; }
}

// ── Soft-lock: viewer awareness ────────────────────────────────────────────────
(function() {
    let _heartbeatTimer = null;
    const HEARTBEAT_MS  = 60 * 1000;   // renew lock every 60s

    async function acquireLock() {
        if (!_ptId) return;
        try {
            const res = await fetchWithAuth(window.rxUrl('/api/patient-locks/') + _ptId + '/acquire', { method: 'POST' });
            if (res && res.ok) {
                const { others } = await res.json();
                updateViewerBanner(others);
            }
        } catch(e) { /* silent */ }
    }

    async function heartbeat() {
        if (!_ptId) return;
        try {
            const res = await fetchWithAuth(window.rxUrl('/api/patient-locks/') + _ptId + '/heartbeat', { method: 'POST' });
            if (res && res.ok) {
                const { others } = await res.json();
                updateViewerBanner(others);
            }
        } catch(e) { /* silent */ }
    }

    async function releaseLock() {
        if (!_ptId) return;
        try {
            // Use sendBeacon for reliability on tab close
            navigator.sendBeacon('/api/patient-locks/' + _ptId + '/release');
        } catch(e) { /* silent */ }
    }

    function updateViewerBanner(others) {
        const banner  = document.getElementById('viewerBanner');
        const names   = document.getElementById('viewerNames');
        const subtext = document.getElementById('viewerSubtext');
        const count   = document.getElementById('viewerCount');
        if (!banner || !others) return;

        if (!others.length) {
            banner.classList.add('d-none');
            return;
        }

        banner.classList.remove('d-none');
        if (others.length === 1) {
            const v = others[0];
            const ago = v.minutesAgo <= 0 ? 'just now' : v.minutesAgo + ' min ago';
            names.textContent   = v.name + ' is also viewing this patient';
            subtext.textContent = '(opened ' + ago + ')';
            count.textContent   = '1 viewer';
        } else {
            const nameList = others.slice(0, 2).map(v => v.name).join(', ');
            const extra    = others.length > 2 ? ' and ' + (others.length - 2) + ' more' : '';
            names.textContent   = nameList + extra + ' are also viewing';
            subtext.textContent = '';
            count.textContent   = others.length + ' viewers';
        }
    }

    // Start lock lifecycle when DOM is ready
    document.addEventListener('DOMContentLoaded', () => {
        acquireLock();
        _heartbeatTimer = setInterval(heartbeat, HEARTBEAT_MS);
    });

    // Release on tab/browser close
    window.addEventListener('beforeunload', () => {
        if (_heartbeatTimer) clearInterval(_heartbeatTimer);
        releaseLock();
    });

    // Release when navigating away within the SPA
    window.addEventListener('pagehide', releaseLock);
})();


    // Event delegation for patient-timeline
    document.addEventListener('click', function(e) {
        var cycleBtn = e.target.closest('[data-cycle-filter]');
        if (cycleBtn) {
            e.preventDefault();
            _selectedCycleId = cycleBtn.dataset.cycleFilter || 'all';
            if (_timelineData) renderTimeline(_timelineData);
            return;
        }
        var printSvc = e.target.closest('[data-svc-history-print]');
        if (printSvc) {
            e.preventDefault();
            printServiceHistoryEntry(parseInt(printSvc.dataset.svcHistoryPrint, 10));
            return;
        }
        var exportSvc = e.target.closest('[data-svc-history-export]');
        if (exportSvc) {
            e.preventDefault();
            exportServiceHistoryEntry(parseInt(exportSvc.dataset.svcHistoryExport, 10));
            return;
        }
        var el = e.target.closest('[data-tl-toggle]');
        if (el) toggleTlCard(el.dataset.tlToggle, el);
    });

</script>
</body>

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Home Accounting</title>
  <link href="/assets/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/inter.css" rel="stylesheet">
  <link rel="stylesheet" href="/assets/fontawesome.all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="wrapper">
  <%- include('partials/sidebar') %>
  <div id="content">
    <nav class="navbar navbar-expand-lg px-4 mb-4">
      <button type="button" id="sidebarCollapse" class="btn btn-primary btn-sm"><i class="fas fa-bars"></i></button>
      <span class="ms-3 fw-bold fs-5">Home Accounting Dashboard</span>
      <div class="ms-auto d-flex align-items-center gap-3">
        <span id="userGreeting" class="text-muted small"></span>
        <button id="logoutBtn" class="btn btn-danger btn-sm"><i class="fas fa-sign-out-alt me-1"></i>Logout</button>
      </div>
    </nav>
    <div class="container-fluid px-4">
      <div class="row g-3" id="cards"></div>

      <div class="row g-4 mt-1">
        <div class="col-lg-8">
          <div class="glass-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h5 class="mb-0">Recent Transactions</h5>
              <a href="/entry" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i>New Entry</a>
            </div>
            <div class="table-responsive"><table class="table table-hover"><tbody id="recentRows"><tr><td class="text-muted">Loading...</td></tr></tbody></table></div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="glass-card p-4 h-100">
            <h5 class="mb-3">2026 Sample Simulation</h5>
            <p class="text-muted small">Load sample income and expenses to test reports and graphs. Clearing simulation removes only records marked as simulation.</p>
            <div class="d-grid gap-2">
              <button class="btn btn-outline-primary" onclick="seedSimulation()"><i class="fas fa-chart-line me-1"></i>Load Sample Data</button>
              <button class="btn btn-outline-danger" onclick="clearSimulation()"><i class="fas fa-trash-alt me-1"></i>Clear Simulation</button>
            </div>
            <div class="small text-muted mt-3" id="simulationResult"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100"></div>
<script src="/assets/bootstrap.bundle.min.js"></script>
<a id="xa-base" href="/login" style="display:none"></a>
<script src="/js/base.js"></script>
<script src="/js/main.js"></script>
<script>
function authHeaders(json){ const t=localStorage.getItem('haToken')||localStorage.getItem('token')||''; const h=t?{Authorization:'Bearer '+t}:{}; if(json)h['Content-Type']='application/json'; return h; }
function money(value){ return Number(value || 0).toLocaleString(undefined,{style:'currency',currency:'USD'}); }
function esc(value){ return String(value == null ? '' : value).replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch])); }
function toast(message,type){ if(typeof showToast==='function') showToast(message,type||'success'); }
async function count(endpoint){ const r=await fetch(endpoint,{headers:authHeaders()}); if(!r.ok)return 0; const d=await r.json(); return Array.isArray(d)?d.length:0; }
async function loadDashboard(){
  const items=[
    ['Accounts','/api/accounts','fa-wallet'],
    ['Transactions','/api/transactions','fa-receipt'],
    ['Categories','/api/categories','fa-tags'],
    ['Proofs','/api/proof-documents','fa-paperclip']
  ];
  const values=await Promise.all(items.map(i=>count(i[1])));
  document.getElementById('cards').innerHTML=items.map((i,idx)=>`<div class="col-md-3"><div class="glass-card p-4"><div class="text-muted small">${i[0]}</div><div class="display-6 fw-bold"><i class="fas ${i[2]} me-2"></i>${values[idx]}</div></div></div>`).join('');
  const tx=await fetch('/api/transactions',{headers:authHeaders()}).then(r=>r.ok?r.json():[]);
  document.getElementById('recentRows').innerHTML=tx.slice(0,10).map(row=>`<tr><td>${esc(row.transactionDate||'')}</td><td>${esc(row.description||'')}</td><td class="text-end">${money(row.amount)}</td><td>${esc(row.status||'')}</td></tr>`).join('') || '<tr><td class="text-muted">No transactions yet.</td></tr>';
}
async function seedSimulation(){
  const res=await fetch('/api/simulation/seed',{method:'POST',headers:authHeaders(true)});
  const data=await res.json().catch(()=>({}));
  if(!res.ok) return toast(data.message || data.error || 'Unable to load simulation.', 'danger');
  document.getElementById('simulationResult').textContent='Created ' + data.created + ' sample transactions.';
  toast('Simulation loaded.');
  loadDashboard();
}
async function clearSimulation(){
  if(!confirm('Clear all simulation transactions and simulation accounts?')) return;
  const res=await fetch('/api/simulation',{method:'DELETE',headers:authHeaders()});
  const data=await res.json().catch(()=>({}));
  if(!res.ok) return toast(data.message || data.error || 'Unable to clear simulation.', 'danger');
  document.getElementById('simulationResult').textContent='Removed ' + data.deletedTransactions + ' transactions and ' + data.deletedAccounts + ' accounts.';
  toast('Simulation cleared.');
  loadDashboard();
}
document.addEventListener('DOMContentLoaded', loadDashboard);
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Backup Management - Home Accounting</title>
  <link href="/assets/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/inter.css" rel="stylesheet">
  <link rel="stylesheet" href="/assets/fontawesome.all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="wrapper">
  <%- include('partials/sidebar') %>
  <div id="content">
    <nav class="navbar navbar-expand-lg px-4 mb-4">
      <button type="button" id="sidebarCollapse" class="btn btn-primary btn-sm"><i class="fas fa-bars"></i></button>
      <span class="ms-3 fw-bold fs-5">Backup Management</span>
      <div class="ms-auto d-flex align-items-center gap-3">
        <span id="userGreeting" class="text-muted small"></span>
        <button id="logoutBtn" class="btn btn-danger btn-sm"><i class="fas fa-sign-out-alt me-1"></i>Logout</button>
      </div>
    </nav>

    <div class="container-fluid px-4">
      <div class="row g-4">
        <div class="col-lg-4">
          <div class="glass-card p-4 h-100">
            <h5 class="mb-3"><i class="fas fa-database me-2 text-primary"></i>Database Backup</h5>
            <p class="text-muted small">Creates a PostgreSQL backup of the Home Accounting database: users, roles, accounting setup, transactions, audit logs, and settings.</p>
            <button class="btn btn-primary w-100" id="runBackupBtn" onclick="runBackup()">
              <span class="spinner-border spinner-border-sm me-2 d-none" id="runSpinner"></span>
              <i class="fas fa-play me-1" id="runIcon"></i>Run Backup Now
            </button>
          </div>
        </div>
        <div class="col-lg-8">
          <div class="glass-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h5 class="mb-0">Backup Status</h5>
              <button class="btn btn-outline-primary btn-sm" onclick="loadStatus()"><i class="fas fa-sync-alt me-1"></i>Refresh</button>
            </div>
            <div id="statusBox" class="text-muted">Loading...</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100"></div>
<script src="/assets/bootstrap.bundle.min.js"></script>
<a id="xa-base" href="/login" style="display:none"></a>
<script src="/js/base.js"></script>
<script src="/js/main.js"></script>
<script>
function authHeaders(json){ const t=localStorage.getItem('haToken')||localStorage.getItem('token')||''; const h=t?{Authorization:'Bearer '+t}:{}; if(json)h['Content-Type']='application/json'; return h; }
function esc(v){ return String(v == null ? '' : v).replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch])); }
function toast(message,type){ if(typeof showToast==='function') showToast(message,type||'success'); }
async function loadStatus(){
  const res = await fetch('/api/backups/status', { headers: authHeaders() });
  const box = document.getElementById('statusBox');
  if (!res.ok) { box.innerHTML = '<div class="text-danger">Unable to load backup status.</div>'; return; }
  const data = await res.json();
  box.innerHTML =
    '<div class="row g-3">' +
      '<div class="col-md-4"><div class="p-3 rounded border"><div class="text-muted small">Scheduler</div><strong>' + esc(data.enabled ? 'Enabled' : 'Disabled') + '</strong></div></div>' +
      '<div class="col-md-4"><div class="p-3 rounded border"><div class="text-muted small">Running</div><strong>' + esc(data.running ? 'Yes' : 'No') + '</strong></div></div>' +
      '<div class="col-md-4"><div class="p-3 rounded border"><div class="text-muted small">Last Backup</div><strong>' + esc(data.lastRunAt || 'Not recorded') + '</strong></div></div>' +
    '</div>' +
    '<pre class="mt-3 p-3 rounded bg-light small mb-0">' + esc(JSON.stringify(data, null, 2)) + '</pre>';
}
async function runBackup(){
  const btn = document.getElementById('runBackupBtn');
  btn.disabled = true;
  document.getElementById('runSpinner').classList.remove('d-none');
  document.getElementById('runIcon').classList.add('d-none');
  const res = await fetch('/api/backups/run', { method: 'POST', headers: authHeaders(true) });
  const data = await res.json().catch(() => ({}));
  btn.disabled = false;
  document.getElementById('runSpinner').classList.add('d-none');
  document.getElementById('runIcon').classList.remove('d-none');
  if (!res.ok || data.status === 'failed') return toast(data.error || data.message || 'Backup failed.', 'danger');
  toast('Backup completed.');
  loadStatus();
}
document.addEventListener('DOMContentLoaded', loadStatus);
</script>
</body>
</html>

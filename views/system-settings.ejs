<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>System Settings - Home Accounting</title>
  <link href="/assets/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/inter.css" rel="stylesheet">
  <link rel="stylesheet" href="/assets/fontawesome.all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="wrapper">
  <%- include('partials/sidebar') %>
  <div id="content">
    <nav class="navbar navbar-expand-lg px-4 mb-4">
      <button type="button" id="sidebarCollapse" class="btn btn-primary btn-sm"><i class="fas fa-bars"></i></button>
      <span class="ms-3 fw-bold fs-5">System Settings</span>
      <div class="ms-auto"><button id="logoutBtn" class="btn btn-danger btn-sm">Logout</button></div>
    </nav>
    <div class="container-fluid px-4">
      <div class="glass-card p-4">
        <h5>Application Settings</h5>
        <p class="text-muted">Operational settings for Home Accounting. Accounting data remains separate from users, roles, audit, and deployment configuration.</p>
        <pre id="settingsBox" class="bg-light p-3 rounded small">Loading...</pre>
      </div>
    </div>
  </div>
</div>
<script src="/assets/bootstrap.bundle.min.js"></script>
<script src="/js/base.js"></script>
<script src="/js/main.js"></script>
<script>
function headers(){ const t=localStorage.getItem('haToken')||localStorage.getItem('token')||''; return t?{Authorization:'Bearer '+t}:{}; }
fetch('/api/settings',{headers:headers()}).then(r=>r.ok?r.json():{}).then(d=>{ document.getElementById('settingsBox').textContent=JSON.stringify(d,null,2); });
</script>
</body>
</html>

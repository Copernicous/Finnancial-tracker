<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Changelog - Home Accounting</title>
  <link href="/assets/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/inter.css" rel="stylesheet">
  <link rel="stylesheet" href="/assets/fontawesome.all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/assets/marked.min.js"></script>
</head>
<body>
<div class="wrapper">
  <%- include('partials/sidebar') %>
  <div id="content">
    <nav class="navbar navbar-expand-lg px-4 mb-4">
      <button type="button" id="sidebarCollapse" class="btn btn-primary btn-sm"><i class="fas fa-bars"></i></button>
      <span class="ms-3 fw-bold fs-5">Changelog</span>
      <div class="ms-auto d-flex align-items-center gap-3">
        <span id="userGreeting" class="text-muted small"></span>
        <button id="logoutBtn" class="btn btn-danger btn-sm"><i class="fas fa-sign-out-alt me-1"></i>Logout</button>
      </div>
    </nav>
    <div class="container-fluid px-4">
      <div class="glass-card p-4">
        <div id="changelogContent" class="small text-muted">Loading...</div>
      </div>
    </div>
  </div>
</div>
<script src="/assets/bootstrap.bundle.min.js"></script>
<a id="xa-base" href="/login" style="display:none"></a>
<script src="/js/base.js"></script>
<script src="/js/main.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  const raw = <%- JSON.stringify(markdown || '') %>;
  document.getElementById('changelogContent').innerHTML = raw.trim()
    ? marked.parse(raw)
    : '<p>No changelog has been written yet.</p>';
});
</script>
</body>
</html>

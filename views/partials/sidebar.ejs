<%#
  Shared sidebar partial — server-side permission-aware.
  Uses res.locals.userPerms set by middleware/webAuth.js from the haToken cookie.
  If userPerms is null (no cookie yet), all items are shown and client JS handles auth redirect.
%>
<%
  // Build a visible-set from userPerms
  const UP      = locals.userPerms || null;
  const isAdmin = locals.isAdmin || (locals.currentUser && locals.currentUser.role === 'Administrator');
  const isMaster = locals.isMaster || (locals.currentUser && locals.currentUser.isMaster === true);

  // Returns true if visible:
  //   • No UP (no token)     → permissive (JS redirect handles auth)
  //   • Administrator role   → always visible (bypasses permission checks)
  //   • Otherwise            → check the module's visible flag
  function sv(key) {
    if (!UP) return true;
    if (isAdmin) return true;
    const p = UP[key];
    return !!(p && p.visible);
  }

  const ap = locals.activePage || '';
  const refActive   = ['financial-institutions','categories','reconciliations','proofs'].includes(ap);
  const planningActive = ['finance','budgets','recurring','financial-goals','investments','currency-rates','balance-snapshots'].includes(ap);
  const rptActive   = ['reports','audit-log'].includes(ap);
  const adminActive = ['roles','users','system-settings','backups','import','active-users','backoffice'].includes(ap);

  const refVisible   = sv('financial_institutions') || sv('categories') || sv('reconciliations') || sv('proofs');
  const planningVisible = sv('reports') || sv('budgets') || sv('recurring') || sv('goals') || sv('investments') || sv('currency_rates') || sv('balance_snapshots');
  const rptVisible   = sv('reports') || sv('audit_log');
  const adminVisible = sv('users') || sv('backups') || sv('system_settings') || sv('import') || sv('active_users') || isMaster;
%>
<!-- xa-base: FortiGate rewrites <a href> — used by base.js to compute proxy path prefix -->
<a id="xa-base" href="/login" style="display:none" aria-hidden="true"></a>
<script>
    !function(){
        var theme = null;
        try { theme = localStorage.getItem('haTheme'); } catch (e) {}
        if (theme !== 'dark' && theme !== 'light') {
            try {
                theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            } catch (e) {
                theme = 'light';
            }
        }
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.style.colorScheme = theme;
    }();
</script>
<% if (locals.isStaging) { %>
<script>
    document.documentElement.classList.add('ha-staging-env');
    if (document.body) document.body.classList.add('ha-staging-env');
</script>
<% } %>
<nav id="sidebar" class="<%= locals.isStaging ? 'ha-staging-sidebar' : '' %>">
    <div class="sidebar-header">
        <span><i class="fas fa-calculator me-2"></i>Home Accounting</span>
        <button type="button" class="ha-theme-toggle" data-theme-toggle aria-label="Toggle theme" title="Toggle theme">
            <i class="fas fa-moon"></i>
        </button>
        <% if (locals.isStaging) { %>
            <span class="ha-staging-sidebar-badge">STAGING</span>
        <% } %>
    </div>
    <ul class="list-unstyled components">

        <li class="<%= ap === 'dashboard' ? 'active' : '' %>">
            <a href="/dashboard"><i class="fas fa-tachometer-alt me-2"></i>Dashboard</a>
        </li>

        <% if (!UP || sv('accounts')) { %>
        <li class="<%= ap === 'accounts' ? 'active' : '' %>">
            <a href="/accounts"><i class="fas fa-wallet me-2"></i>Accounts</a>
        </li>
        <% } %>

        <% if (!UP || sv('transactions')) { %>
        <li class="<%= ap === 'entry' ? 'active' : '' %>">
            <a href="/entry"><i class="fas fa-edit me-2"></i>New Entry</a>
        </li>
        <li class="<%= ap === 'transactions' ? 'active' : '' %>">
            <a href="/transactions"><i class="fas fa-receipt me-2"></i>Transactions</a>
        </li>
        <% } %>

        <% if (!UP || planningVisible) { %>
        <li>
            <a href="#planningSubmenu" data-bs-toggle="collapse"
               aria-expanded="<%= planningActive ? 'true' : 'false' %>"
               class="dropdown-toggle">
                <i class="fas fa-chart-line me-2"></i>Financial Planning
            </a>
            <ul class="collapse <%= planningActive ? 'show' : '' %> list-unstyled ps-3" id="planningSubmenu">
                <% if (!UP || sv('reports')) { %>
                <li class="<%= ap === 'finance' ? 'active' : '' %>">
                    <a href="/finance"><i class="fas fa-gauge-high me-2"></i>Financial Workspace</a>
                </li>
                <% } %>
                <% if (!UP || sv('budgets')) { %>
                <li class="<%= ap === 'budgets' ? 'active' : '' %>">
                    <a href="/budgets"><i class="fas fa-scale-balanced me-2"></i>Budgets</a>
                </li>
                <% } %>
                <% if (!UP || sv('recurring')) { %>
                <li class="<%= ap === 'recurring' ? 'active' : '' %>">
                    <a href="/recurring"><i class="fas fa-calendar-check me-2"></i>Recurring</a>
                </li>
                <% } %>
                <% if (!UP || sv('goals')) { %>
                <li class="<%= ap === 'financial-goals' ? 'active' : '' %>">
                    <a href="/financial-goals"><i class="fas fa-bullseye me-2"></i>Goals</a>
                </li>
                <% } %>
                <% if (!UP || sv('investments')) { %>
                <li class="<%= ap === 'investments' ? 'active' : '' %>">
                    <a href="/investments"><i class="fas fa-chart-area me-2"></i>Investments</a>
                </li>
                <% } %>
                <% if (!UP || sv('currency_rates')) { %>
                <li class="<%= ap === 'currency-rates' ? 'active' : '' %>">
                    <a href="/currency-rates"><i class="fas fa-coins me-2"></i>Currency Rates</a>
                </li>
                <% } %>
                <% if (!UP || sv('balance_snapshots')) { %>
                <li class="<%= ap === 'balance-snapshots' ? 'active' : '' %>">
                    <a href="/balance-snapshots"><i class="fas fa-camera-retro me-2"></i>Balance Snapshots</a>
                </li>
                <% } %>
            </ul>
        </li>
        <% } %>

        <% if (!UP || refVisible) { %>
        <li>
            <a href="#refDataSubmenu" data-bs-toggle="collapse"
               aria-expanded="<%= refActive ? 'true' : 'false' %>"
               class="dropdown-toggle">
                <i class="fas fa-book-open me-2"></i>Accounting Setup
            </a>
            <ul class="collapse <%= refActive ? 'show' : '' %> list-unstyled ps-3" id="refDataSubmenu">
                <% if (!UP || sv('financial_institutions')) { %>
                <li class="<%= ap === 'financial-institutions' ? 'active' : '' %>">
                    <a href="/financial-institutions"><i class="fas fa-university me-2"></i>Financial Institutions</a>
                </li>
                <% } %>
                <% if (!UP || sv('categories')) { %>
                <li class="<%= ap === 'categories' ? 'active' : '' %>">
                    <a href="/categories"><i class="fas fa-tags me-2"></i>Categories</a>
                </li>
                <% } %>
                <% if (!UP || sv('reconciliations')) { %>
                <li class="<%= ap === 'reconciliations' ? 'active' : '' %>">
                    <a href="/reconciliations"><i class="fas fa-balance-scale me-2"></i>Reconciliations</a>
                </li>
                <% } %>
                <% if (!UP || sv('proofs')) { %>
                <li class="<%= ap === 'proofs' ? 'active' : '' %>">
                    <a href="/proofs"><i class="fas fa-paperclip me-2"></i>Proofs</a>
                </li>
                <% } %>
            </ul>
        </li>
        <% } %>

        <% if (!UP || rptVisible) { %>
        <li>
            <a href="#reportsSubmenu" data-bs-toggle="collapse"
               aria-expanded="<%= rptActive ? 'true' : 'false' %>"
               class="dropdown-toggle">
                <i class="fas fa-chart-bar me-2"></i>Reports
            </a>
            <ul class="collapse <%= rptActive ? 'show' : '' %> list-unstyled ps-3" id="reportsSubmenu">
                <% if (!UP || sv('reports')) { %>
                <li class="<%= ap === 'reports' ? 'active' : '' %>">
                    <a href="/reports"><i class="fas fa-chart-pie me-2"></i>Analytics &amp; Export</a>
                </li>
                <% } %>
                <% if (!UP || sv('audit_log')) { %>
                <li class="<%= ap === 'audit-log' ? 'active' : '' %>">
                    <a href="/audit-log"><i class="fas fa-history me-2"></i>Audit Log</a>
                </li>
                <% } %>
            </ul>
        </li>
        <% } %>

        <% if (!UP || adminVisible) { %>
        <li>
            <a href="#adminSubmenu" data-bs-toggle="collapse"
               aria-expanded="<%= adminActive ? 'true' : 'false' %>"
               class="dropdown-toggle">
                <i class="fas fa-cogs me-2"></i>Administration
            </a>
            <ul class="collapse <%= adminActive ? 'show' : '' %> list-unstyled ps-3" id="adminSubmenu">

                <% if (!UP || sv('users')) { %>
                <li class="<%= ap === 'roles' ? 'active' : '' %>">
                    <a href="/roles"><i class="fas fa-shield-alt me-2"></i>Roles</a>
                </li>
                <li class="<%= ap === 'users' ? 'active' : '' %>">
                    <a href="/users"><i class="fas fa-users-cog me-2"></i>User Management</a>
                </li>
                <% } %>
                <% if (!UP || sv('system_settings')) { %>
                <li class="<%= ap === 'system-settings' ? 'active' : '' %>">
                    <a href="/system-settings"><i class="fas fa-sliders-h me-2"></i>System Settings</a>
                </li>
                <% } %>
                <% if (!UP || sv('backups')) { %>
                <li class="<%= ap === 'backups' ? 'active' : '' %>">
                    <a href="/backups"><i class="fas fa-database me-2"></i>Backups</a>
                </li>
                <% } %>
                <% if (!UP || sv('import')) { %>
                <li class="<%= ap === 'import' ? 'active' : '' %>">
                    <a href="/import"><i class="fas fa-file-import me-2"></i>Data Import</a>
                </li>
                <% } %>
                <% if (!UP || sv('active_users')) { %>
                <li class="<%= ap === 'active-users' ? 'active' : '' %>">
                    <a href="/active-users">
                        <i class="fas fa-users me-2"></i>Who's Online
                        <span id="sidebarOnlineBadge" style="display:none;margin-left:auto;background:#22c55e;color:#fff;border-radius:20px;padding:1px 7px;font-size:.65rem;font-weight:700;line-height:1.6">0</span>
                    </a>
                </li>
                <% } %>
                <% if (isMaster) { %>
                <li class="<%= ap === 'backoffice' ? 'active' : '' %>">
                    <a href="/backoffice"><i class="fas fa-toolbox me-2"></i>Backoffice</a>
                </li>
                <% } %>
            </ul>
        </li>
        <% } %>

    </ul>

    <!-- Version badge -->
    <div id="sidebarVersion" style="
        position: absolute; bottom: 0; left: 0; right: 0;
        padding: 10px 16px;
        border-top: 1px solid rgba(255,255,255,0.07);
        display: flex; align-items: center; justify-content: space-between;
        font-size: 0.7rem; color: rgba(255,255,255,0.35);
    ">
        <span><i class="fas fa-code-branch me-1"></i>v<span id="sidebarVer">—</span></span>
        <a href="/changelog" title="View Changelog"
           style="color:rgba(255,255,255,0.3); text-decoration:none; font-size:0.65rem;"
           onmouseover="this.style.color='rgba(255,255,255,0.7)'"
           onmouseout="this.style.color='rgba(255,255,255,0.3)'">
            Changelog <i class="fas fa-external-link-alt ms-1" style="font-size:.6rem"></i>
        </a>
    </div>
</nav>

<script>
// Fetch and display version in sidebar — non-blocking, fails silently
(function() {
    fetch(window.appUrl ? window.appUrl('/api/version') : '/api/version')
        .then(function(r) { return r.json(); })
        .then(function(d) {
            var el = document.getElementById('sidebarVer');
            if (el) el.textContent = d.version || '—';
        })
        .catch(function() {});
})();

// Who's Online badge — polls active sessions count every 30s
// Hidden automatically for roles without active_users permission (API returns 403)
(function() {
    function _loadOnlineBadge() {
        var token = localStorage.getItem('haToken') || localStorage.getItem('token');
        if (!token) return;
        var url = typeof window.appUrl === 'function' ? window.appUrl('/api/active-sessions') : '/api/active-sessions';
        fetch(url, { headers: { 'Authorization': 'Bearer ' + token } })
            .then(function(r) {
                if (!r.ok) return null;
                return r.json();
            })
            .then(function(data) {
                if (!data) return;
                var badge = document.getElementById('sidebarOnlineBadge');
                if (!badge) return;
                badge.textContent = data.length;
                badge.style.display = 'inline-block';
            })
            .catch(function() {});
    }
    _loadOnlineBadge();
    setInterval(_loadOnlineBadge, 30000);
})();
</script>


<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Audit Log - Home Accounting</title>
  <link href="/assets/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/inter.css" rel="stylesheet">
  <link rel="stylesheet" href="/assets/fontawesome.all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="wrapper">
  <%- include('partials/sidebar') %>
  <div id="content">
    <nav class="navbar navbar-expand-lg px-4 mb-4">
      <button type="button" id="sidebarCollapse" class="btn btn-primary btn-sm"><i class="fas fa-bars"></i></button>
      <span class="ms-3 fw-bold fs-5">Audit Log</span>
      <div class="ms-auto d-flex align-items-center gap-3">
        <span id="userGreeting" class="text-muted small"></span>
        <button id="logoutBtn" class="btn btn-danger btn-sm"><i class="fas fa-sign-out-alt me-1"></i>Logout</button>
      </div>
    </nav>
    <div class="container-fluid px-4">
      <div class="glass-card p-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
          <h5 class="mb-0">Accounting Audit Trail</h5>
          <button class="btn btn-outline-primary btn-sm" onclick="loadAudit()"><i class="fas fa-sync-alt me-1"></i>Refresh</button>
        </div>
        <div class="row g-2 mb-3">
          <div class="col-md-3"><input class="form-control form-control-sm" id="moduleFilter" placeholder="Module"></div>
          <div class="col-md-3"><input class="form-control form-control-sm" id="actionFilter" placeholder="Action"></div>
          <div class="col-md-3"><input class="form-control form-control-sm" id="userFilter" placeholder="User"></div>
          <div class="col-md-3"><button class="btn btn-sm btn-primary w-100" onclick="loadAudit()">Search</button></div>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead><tr><th>Date</th><th>Time</th><th>User</th><th>Module</th><th>Action</th><th>Record</th><th>IP</th></tr></thead>
            <tbody id="auditBody"><tr><td colspan="7" class="text-muted">Loading...</td></tr></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="/assets/bootstrap.bundle.min.js"></script>
<a id="xa-base" href="/login" style="display:none"></a>
<script src="/js/base.js"></script>
<script src="/js/main.js"></script>
<script>
function authHeaders(){ const t=localStorage.getItem('haToken')||localStorage.getItem('token')||''; return t?{Authorization:'Bearer '+t}:{}; }
function esc(v){ return String(v == null ? '' : v).replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch])); }
async function loadAudit(){
  const params = new URLSearchParams();
  ['module','action','user'].forEach(key => {
    const el = document.getElementById(key + 'Filter');
    if (el && el.value.trim()) params.set(key, el.value.trim());
  });
  const res = await fetch('/api/audit-logs?' + params.toString(), { headers: authHeaders() });
  const body = document.getElementById('auditBody');
  if (!res.ok) { body.innerHTML = '<tr><td colspan="7" class="text-danger">Unable to load audit log.</td></tr>'; return; }
  const data = await res.json();
  const rows = Array.isArray(data) ? data : (data.rows || data.data || []);
  if (!rows.length) { body.innerHTML = '<tr><td colspan="7" class="text-muted">No audit entries yet.</td></tr>'; return; }
  body.innerHTML = rows.map(row => '<tr><td>' + esc(row.date || (row.createdAt || '').slice(0,10)) + '</td><td>' + esc(row.time || '') + '</td><td>' + esc(row.User ? row.User.username : row.username || row.userId || '') + '</td><td>' + esc(row.module) + '</td><td>' + esc(row.action) + '</td><td>' + esc(row.recordId || '') + '</td><td>' + esc(row.ipAddress || '') + '</td></tr>').join('');
}
document.addEventListener('DOMContentLoaded', loadAudit);
</script>
</body>
</html>

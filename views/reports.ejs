<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reports - Home Accounting</title>
  <link href="/assets/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/inter.css" rel="stylesheet">
  <link rel="stylesheet" href="/assets/fontawesome.all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .bar-track { height: 18px; background: var(--surface-2,#eef2f7); border-radius: 4px; overflow: hidden; }
    .bar-income { background: #198754; height: 18px; }
    .bar-expense { background: #dc3545; height: 18px; }
  </style>
</head>
<body>
<div class="wrapper">
  <%- include('partials/sidebar') %>
  <div id="content">
    <nav class="navbar navbar-expand-lg px-4 mb-4">
      <button type="button" id="sidebarCollapse" class="btn btn-primary btn-sm"><i class="fas fa-bars"></i></button>
      <span class="ms-3 fw-bold fs-5">Accounting Reports</span>
      <div class="ms-auto d-flex align-items-center gap-3">
        <span id="userGreeting" class="text-muted small"></span>
        <button id="logoutBtn" class="btn btn-danger btn-sm"><i class="fas fa-sign-out-alt me-1"></i>Logout</button>
      </div>
    </nav>
    <div class="container-fluid px-4">
      <div class="glass-card p-4 mb-4">
        <div class="row g-3 align-items-end">
          <div class="col-md-3">
            <label class="form-label">Report</label>
            <select id="reportType" class="form-select" onchange="loadReport()">
              <option value="activity">Account Activity</option>
              <option value="income_statement">Income Statement</option>
              <option value="cash_flow">Cash Flow</option>
            </select>
          </div>
          <div class="col-md-4"><label class="form-label">Account</label><select id="accountSelect" class="form-select"><option value="">All accounts</option></select></div>
          <div class="col-md-2"><label class="form-label">Year</label><select id="yearSelect" class="form-select"><option>2026</option></select></div>
          <div class="col-md-3"><button class="btn btn-primary w-100" onclick="loadReport()"><i class="fas fa-chart-bar me-1"></i>Run Report</button></div>
        </div>
      </div>

      <div class="row g-3 mb-4" id="summaryCards"></div>

      <div class="glass-card p-4 mb-4">
        <h5 class="mb-3">Monthly Movement</h5>
        <div id="bars"></div>
      </div>

      <div class="glass-card p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="mb-0">Report Detail</h5>
          <button class="btn btn-outline-success btn-sm" onclick="exportCsv()"><i class="fas fa-file-csv me-1"></i>Export CSV</button>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead><tr><th>Date</th><th>Account</th><th>Category</th><th>Description</th><th>Type</th><th class="text-end">Amount</th><th>Status</th></tr></thead>
            <tbody id="detailRows"><tr><td colspan="7" class="text-muted">Loading...</td></tr></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="/assets/bootstrap.bundle.min.js"></script>
<a id="xa-base" href="/login" style="display:none"></a>
<script src="/js/base.js"></script>
<script src="/js/main.js"></script>
<script>
let accounts = [];
let categories = [];
let reportRows = [];
function authHeaders(){ const t=localStorage.getItem('haToken')||localStorage.getItem('token')||''; return t?{Authorization:'Bearer '+t}:{}; }
function esc(v){ return String(v == null ? '' : v).replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch])); }
function money(v){ return Number(v||0).toLocaleString(undefined,{style:'currency',currency:'USD'}); }
function accountName(id){ const a=accounts.find(x=>Number(x.id)===Number(id)); return a?a.name:''; }
function categoryName(id){ const c=categories.find(x=>Number(x.id)===Number(id)); return c?c.name:''; }
async function loadLookups(){
  [accounts,categories]=await Promise.all([
    fetch('/api/accounts',{headers:authHeaders()}).then(r=>r.ok?r.json():[]),
    fetch('/api/categories',{headers:authHeaders()}).then(r=>r.ok?r.json():[])
  ]);
  document.getElementById('accountSelect').innerHTML='<option value="">All accounts</option>'+accounts.map(a=>'<option value="'+a.id+'">'+esc(a.name)+'</option>').join('');
}
function summarize(rows){
  const income = rows.filter(r=>Number(r.amount)>0).reduce((s,r)=>s+Number(r.amount||0),0);
  const expense = rows.filter(r=>Number(r.amount)<0).reduce((s,r)=>s+Number(r.amount||0),0);
  const net = income + expense;
  document.getElementById('summaryCards').innerHTML = [
    ['Income', income, 'fa-arrow-trend-up'],
    ['Expenses', expense, 'fa-arrow-trend-down'],
    ['Net', net, 'fa-scale-balanced'],
    ['Transactions', rows.length, 'fa-receipt', true]
  ].map(c=>'<div class="col-md-3"><div class="glass-card p-4"><div class="text-muted small">'+c[0]+'</div><div class="fs-3 fw-bold"><i class="fas '+c[2]+' me-2"></i>'+(c[3]?c[1]:money(c[1]))+'</div></div></div>').join('');
}
function drawBars(rows, year){
  const monthly = {};
  for(let i=1;i<=12;i++) monthly[String(i).padStart(2,'0')]={income:0, expense:0};
  rows.forEach(r=>{
    const month=String(r.transactionDate||'').slice(5,7);
    const amount=Number(r.amount||0);
    if(!monthly[month]) return;
    if(amount>=0) monthly[month].income+=amount; else monthly[month].expense+=Math.abs(amount);
  });
  const max=Math.max(1,...Object.values(monthly).flatMap(v=>[v.income,v.expense]));
  document.getElementById('bars').innerHTML=Object.keys(monthly).map(m=>{
    const v=monthly[m], wi=Math.round(v.income/max*100), we=Math.round(v.expense/max*100);
    return '<div class="row align-items-center g-2 mb-2"><div class="col-md-1 fw-semibold">'+year+'-'+m+'</div><div class="col-md-5"><div class="bar-track"><div class="bar-income" style="width:'+wi+'%"></div></div></div><div class="col-md-2 text-success">'+money(v.income)+'</div><div class="col-md-3"><div class="bar-track"><div class="bar-expense" style="width:'+we+'%"></div></div></div><div class="col-md-1 text-danger text-end">'+money(v.expense)+'</div></div>';
  }).join('');
}
function renderDetails(rows){
  const body=document.getElementById('detailRows');
  if(!rows.length){ body.innerHTML='<tr><td colspan="7" class="text-muted">No rows for this report.</td></tr>'; return; }
  body.innerHTML=rows.map(r=>'<tr><td>'+esc(r.transactionDate)+'</td><td>'+esc(accountName(r.accountId))+'</td><td>'+esc(categoryName(r.categoryId))+'</td><td>'+esc(r.description)+'</td><td>'+esc(r.transactionType)+'</td><td class="text-end">'+money(r.amount)+'</td><td>'+esc(r.status)+'</td></tr>').join('');
}
async function loadReport(){
  const accountId=document.getElementById('accountSelect').value;
  const year=document.getElementById('yearSelect').value;
  const type=document.getElementById('reportType').value;
  const all=await fetch('/api/transactions',{headers:authHeaders()}).then(r=>r.ok?r.json():[]);
  reportRows=all.filter(r=>String(r.transactionDate||'').startsWith(year) && (!accountId || String(r.accountId)===String(accountId)));
  if(type==='income_statement') reportRows=reportRows.filter(r=>['income','expense'].includes(r.transactionType));
  if(type==='cash_flow') reportRows=reportRows.filter(r=>r.status!=='void');
  summarize(reportRows);
  drawBars(reportRows, year);
  renderDetails(reportRows);
}
function exportCsv(){
  const headers=['Date','Account','Category','Description','Type','Amount','Status'];
  const lines=[headers].concat(reportRows.map(r=>[r.transactionDate,accountName(r.accountId),categoryName(r.categoryId),r.description,r.transactionType,r.amount,r.status]));
  const csv=lines.map(row=>row.map(v=>'"'+String(v==null?'':v).replace(/"/g,'""')+'"').join(',')).join('\n');
  const a=document.createElement('a');
  a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv'}));
  a.download='home_accounting_report_2026.csv';
  a.click();
  URL.revokeObjectURL(a.href);
}
document.addEventListener('DOMContentLoaded', async function(){ await loadLookups(); await loadReport(); });
</script>
</body>
</html>
